index 0000000..b3408aa
--- /dev/null
+++ b/zig/src/families/inkling2/admit.zig
@@ -0,0 +1,46 @@
+//! Inkling 2 on CUDA is admitted only as it was run: on GB10 (sm_121) at two ranks, placed by TF_INKLING2_RANK/WORLD.
+const std = @import("std");
+const cuda = @import("cuda");
+const environment = @import("sys").environment;
+
+pub const Refusal = error{ Inkling2RequiresSm121, Inkling2RequiresTwoRanks };
+
+pub fn admit(sm: u32, world: usize) Refusal!void {
+    if (sm != 121) return error.Inkling2RequiresSm121;
+    if (world != 2) return error.Inkling2RequiresTwoRanks;
+}
+
+/// The first check of the family's open: the device's capability, then the rank count, before any image loads.
+pub fn check(ctx: *const cuda.Context, world: usize) (Refusal || cuda.Error)!void {
+    try admit(try ctx.capability(), world);
+}
+
+pub fn explain(err: anyerror) ?[]const u8 {
+    return switch (err) {
+        error.Inkling2RequiresSm121 => "Inkling 2 on CUDA is validated on GB10 (sm_121) only",
+        error.Inkling2RequiresTwoRanks => "Inkling 2 on CUDA runs on exactly two ranks: set TF_INKLING2_RANK (0 or 1) and TF_INKLING2_WORLD=2",
+        error.Inkling2NoRank => "TF_INKLING2_RANK and TF_INKLING2_WORLD go together, with the rank below the world",
+        else => null,
+    };
+}
+
+/// This rank's place: TF_INKLING2_RANK of TF_INKLING2_WORLD (both, or neither for one rank).
+pub const Place = struct { rank: usize, world: usize };
+
+pub fn placeFrom(rank: ?[]const u8, world: ?[]const u8) !Place {
+    return placeOf(try environment.value(?u32, "TF_INKLING2_RANK", rank, null), try environment.value(?u32, "TF_INKLING2_WORLD", world, null));
+}
+
+pub fn place() !Place {
+    return placeOf(try environment.read(?u32, "TF_INKLING2_RANK", null), try environment.read(?u32, "TF_INKLING2_WORLD", null));
+}
+
+fn placeOf(r: ?u32, w: ?u32) error{Inkling2NoRank}!Place {
+    if (r == null and w == null) return .{ .rank = 0, .world = 1 };
+    if (r == null or w == null or w.? == 0 or r.? >= w.?) return error.Inkling2NoRank;
+    return .{ .rank = r.?, .world = w.? };
+}
+
+test {
+    _ = @import("admit_test.zig");
+}
diff --git a/zig/src/families/inkling2/admit_test.zig b/zig/src/families/inkling2/admit_test.zig
new file mode 100644
index 0000000..96c8a27
--- /dev/null
+++ b/zig/src/families/inkling2/admit_test.zig
@@ -0,0 +1,52 @@
+//! Inkling 2's admission on a fake driver: only sm_121 at two ranks passes, refused before any image loads.
+const std = @import("std");
+const cuda = @import("cuda");
+const admit = @import("admit.zig");
+const t = std.testing;
+
+const Fake = struct {
+    var sm: u32 = 121;
+    var reads: usize = 0;
+    var loads: usize = 0;
+    fn attribute(out: *c_int, key: cuda.abi.DeviceAttribute, _: cuda.abi.Device) callconv(.c) cuda.abi.Result {
+        reads += 1;
+        out.* = switch (key) {
+            .compute_capability_major => @intCast(sm / 10),
+            .compute_capability_minor => @intCast(sm % 10),
+            else => unreachable,
+        };
+        return cuda.abi.success;
+    }
+    fn load(_: *cuda.abi.Module, _: ?*const anyopaque) callconv(.c) cuda.abi.Result {
+        loads += 1;
+        return cuda.abi.error_not_ready;
+    }
+};
+
+test "inkling2 admission: GB10 at two ranks only, read from the device before any module load" {
+    var driver: cuda.Driver = undefined;
+    driver.api.cuDeviceGetAttribute = Fake.attribute;
+    driver.api.cuModuleLoadData = Fake.load;
+    const ctx: cuda.Context = .{ .d = &driver, .device = 0, .handle = null };
+    Fake.sm = 121;
+    try admit.check(&ctx, 2);
+    for ([_]usize{ 1, 3, 4 }) |w| try t.expectError(error.Inkling2RequiresTwoRanks, admit.check(&ctx, w));
+    for ([_]u32{ 80, 90, 100, 120, 122 }) |sm| {
+        Fake.sm = sm;
+        try t.expectError(error.Inkling2RequiresSm121, admit.check(&ctx, 2));
+    }
+    try t.expect(Fake.reads > 0);
+    try t.expectEqual(@as(usize, 0), Fake.loads);
+    try t.expect(admit.explain(error.Inkling2RequiresSm121) != null);
+    try t.expect(admit.explain(error.Inkling2RequiresTwoRanks) != null);
+}
+
+test "inkling2 admission: the rank settings come in pairs and are read through the environment table" {
+    try t.expectEqual(admit.Place{ .rank = 0, .world = 1 }, try admit.placeFrom(null, null));
+    try t.expectEqual(admit.Place{ .rank = 1, .world = 2 }, try admit.placeFrom("1", "2"));
+    try t.expectError(error.Inkling2NoRank, admit.placeFrom("1", null));
+    try t.expectError(error.Inkling2NoRank, admit.placeFrom("2", "2"));
+    try t.expectError(error.InvalidEnvironment, admit.placeFrom("one", "2"));
+    // one rank parses as a place; admission is what refuses it
+    try t.expectError(error.Inkling2RequiresTwoRanks, admit.admit(121, (try admit.placeFrom(null, null)).world));
+}
diff --git a/zig/src/families/inkling2/chat.zig b/zig/src/families/inkling2/chat.zig
new file mode 100644
index 0000000..297b1f7
--- /dev/null
+++ b/zig/src/families/inkling2/chat.zig
@@ -0,0 +1,130 @@
+//! Inkling 2's chat wiring: the block markers' ids from tokenizer_config.json, the stop ids and the template's checks.
+const std = @import("std");
+const cfg = @import("config.zig");
+const reply = @import("reply.zig");
+
+/// The special tokens the template writes and the reply split reads, by id.
+pub const Tokens = struct {
+    endoftext: u32 = 0,
+    user: u32 = 0,
+    model: u32 = 0,
+    system: u32 = 0,
+    tool: u32 = 0,
+    text: u32 = 0,
+    image_block: u32 = 0,
+    end_sampling: u32 = 0,
+    thinking: u32 = 0,
+    end: u32 = 0,
+    tool_error: u32 = 0,
+    xml: u32 = 0,
+    tool_json: u32 = 0,
+    tool_text: u32 = 0,
+    /// The image placeholder the processor expands into the tower's rows.
+    image: u32 = 0,
+};
+
+const names = [_]struct { field: []const u8, text: []const u8 }{
+    .{ .field = "endoftext", .text = "<|endoftext|>" },
+    .{ .field = "user", .text = "<|message_user|>" },
+    .{ .field = "model", .text = reply.markers.model },
+    .{ .field = "system", .text = "<|message_system|>" },
+    .{ .field = "tool", .text = "<|message_tool|>" },
+    .{ .field = "text", .text = reply.markers.text },
+    .{ .field = "image_block", .text = "<|content_image|>" },
+    .{ .field = "end_sampling", .text = reply.markers.end_sampling },
+    .{ .field = "thinking", .text = reply.markers.thinking },
+    .{ .field = "end", .text = reply.markers.end },
+    .{ .field = "tool_error", .text = reply.markers.tool_error },
+    .{ .field = "xml", .text = "<|content_xml|>" },
+    .{ .field = "tool_json", .text = reply.markers.tool_json },
+    .{ .field = "tool_text", .text = reply.markers.tool_text },
+    .{ .field = "image", .text = "<|unused_200054|>" },
+};
+
+pub const Error = error{ BadInkling2Tokenizer, Inkling2TokenMissing, Inkling2StopMismatch, Inkling2TemplateMismatch };
+
+pub fn read(gpa: std.mem.Allocator, io: std.Io, dir: []const u8) !Tokens {
+    const path = try std.fs.path.join(gpa, &.{ dir, "tokenizer_config.json" });
+    defer gpa.free(path);
+    const bytes = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 24));
+    defer gpa.free(bytes);
+    return parse(gpa, bytes);
+}
+
+/// Every marker must be a special added token; its id is the decoder key that spells it.
+pub fn parse(gpa: std.mem.Allocator, bytes: []const u8) !Tokens {
+    var doc = try std.json.parseFromSlice(std.json.Value, gpa, bytes, .{});
+    defer doc.deinit();
+    if (doc.value != .object) return error.BadInkling2Tokenizer;
+    const dec = doc.value.object.get("added_tokens_decoder") orelse return error.BadInkling2Tokenizer;
+    if (dec != .object) return error.BadInkling2Tokenizer;
+    var out: Tokens = .{};
+    inline for (names) |n| {
+        var found = false;
+        var it = dec.object.iterator();
+        while (it.next()) |e| {
+            if (e.value_ptr.* != .object) continue;
+            const content = e.value_ptr.object.get("content") orelse continue;
+            if (content != .string or !std.mem.eql(u8, content.string, n.text)) continue;
+            const special = e.value_ptr.object.get("special") orelse return error.BadInkling2Tokenizer;
+            if (special != .bool or !special.bool) return error.BadInkling2Tokenizer;
+            @field(out, n.field) = std.fmt.parseInt(u32, e.key_ptr.*, 10) catch return error.BadInkling2Tokenizer;
+            found = true;
+        }
+        if (!found) return error.Inkling2TokenMissing;
+    }
+    return out;
+}
+
+/// The ids a reply stops at: config.json's eos, which must be the template's end of a model turn.
+pub fn stops(c: *const cfg.Config, tok: *const Tokens) Error![]const u32 {
+    const s = c.stops();
+    for (s) |id| if (id == tok.end_sampling) return s;
+    return error.Inkling2StopMismatch;
+}
+
+/// The template must write the blocks reply.zig splits and take the effort switch; any other format is refused.
+pub fn checkTemplate(template: []const u8) Error!void {
+    const needed = [_][]const u8{ reply.markers.model, reply.markers.thinking, reply.markers.text, reply.markers.end, reply.markers.tool_json, reply.markers.end_sampling, "reasoning_effort", "tool_declare" };
+    for (needed) |n| if (std.mem.indexOf(u8, template, n) == null) return error.Inkling2TemplateMismatch;
+}
+
+pub fn readTemplate(gpa: std.mem.Allocator, io: std.Io, dir: []const u8) !void {
+    const path = try std.fs.path.join(gpa, &.{ dir, "chat_template.jinja" });
+    defer gpa.free(path);
+    const bytes = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 20));
+    defer gpa.free(bytes);
+    try checkTemplate(bytes);
+}
+
+const t = std.testing;
+const fixture = @embedFile("tokenizer_fixture.json");
+
+test "inkling2 chat: the markers' ids, the image token and the stop id from the release's files" {
+    const tok = try parse(t.allocator, fixture);
+    try t.expectEqual(@as(u32, 200001), tok.model);
+    try t.expectEqual(@as(u32, 200006), tok.end_sampling);
+    try t.expectEqual(@as(u32, 200008), tok.thinking);
+    try t.expectEqual(@as(u32, 200010), tok.end);
+    try t.expectEqual(@as(u32, 200049), tok.tool_json);
+    try t.expectEqual(@as(u32, 200054), tok.image);
+    const c = try cfg.parse(t.allocator, @embedFile("config_fixture.json"));
+    try t.expectEqualSlices(u32, &.{200006}, try stops(&c, &tok));
+    var other = c;
+    other.eos[0] = tok.end;
+    try t.expectError(error.Inkling2StopMismatch, stops(&other, &tok));
+}
+
+test "inkling2 chat: a missing or non-special marker is refused" {
+    const gone = try std.mem.replaceOwned(u8, t.allocator, fixture, "<|content_thinking|>", "<|content_think|>");
+    defer t.allocator.free(gone);
+    try t.expectError(error.Inkling2TokenMissing, parse(t.allocator, gone));
+    const plain = try std.mem.replaceOwned(u8, t.allocator, fixture, "\"special\": true", "\"special\": false");
+    defer t.allocator.free(plain);
+    try t.expectError(error.BadInkling2Tokenizer, parse(t.allocator, plain));
+}
+
+test "inkling2 chat: the template check takes the release's blocks and refuses another format" {
+    try checkTemplate(@embedFile("chat_template_fixture.jinja"));
+    try t.expectError(error.Inkling2TemplateMismatch, checkTemplate("{{ '<think>' }} <tool_call> reasoning_effort"));
+}
diff --git a/zig/src/families/inkling2/chat_template_fixture.jinja b/zig/src/families/inkling2/chat_template_fixture.jinja
new file mode 100644
index 0000000..85258f9
--- /dev/null
+++ b/zig/src/families/inkling2/chat_template_fixture.jinja
@@ -0,0 +1,130 @@
+{%- set effort_map = {"none": 0.0, "minimal": 0.1, "low": 0.2, "medium": 0.7, "high": 0.9, "xhigh": 0.99, "max": 0.99} -%}
+{%- set role_token = {"user": "<|message_user|>", "assistant": "<|message_model|>", "system": "<|message_system|>", "tool": "<|message_tool|>"} -%}
+
+{%- macro emit_thinking_effort() -%}
+    {%- set eff = reasoning_effort if reasoning_effort is defined and reasoning_effort is not none else 0.9 -%}
+    {%- if eff is string -%}
+        {%- set key = eff | trim -%}
+        {%- if key not in effort_map -%}
+            {{- raise_exception("Unknown reasoning_effort: " ~ eff) -}}
+        {%- endif -%}
+        {%- set num = effort_map[key] -%}
+    {%- else -%}
+        {%- set num = eff | float -%}
+    {%- endif -%}
+    {%- if num < 0.0 or num > 0.99 -%}
+        {{- raise_exception("reasoning_effort must be in [0.0, 0.99]") -}}
+    {%- endif -%}
+    {{- "<|message_system|><|content_text|>Thinking effort level: " -}}
+    {%- if num == 0.0 -%}0{%- else -%}{{ num }}{%- endif -%}
+    {{- "<|end_message|>" -}}
+{%- endmacro -%}
+
+{%- if tools -%}
+    {%- set tool_state = namespace(specs=[]) -%}
+    {%- for tool in tools -%}
+        {%- set fn = tool.function if tool.function is defined else tool -%}
+        {%- set spec = {
+            "description": (fn.description if fn.description is defined and fn.description else ""),
+            "name": fn.name,
+            "parameters": (fn.parameters if fn.parameters is defined and fn.parameters else {}),
+            "type": (tool.type if tool.type is defined and tool.type else "function"),
+        } -%}
+        {%- set tool_state.specs = tool_state.specs + [spec] -%}
+    {%- endfor -%}
+    {{- "<|message_system|>tool_declare<|content_xml|>" -}}
+    {{- tool_state.specs | tojson(sort_keys=true, separators=(",", ":")) -}}
+    {{- "<|end_message|>" -}}
+{%- endif -%}
+
+{%- set state = namespace(effort_emitted=false) -%}
+{%- for message in messages -%}
+    {%- if message.role not in role_token -%}
+        {{- raise_exception("Unknown message role: " ~ message.role) -}}
+    {%- endif -%}
+    {%- if not state.effort_emitted and message.role != "system" -%}
+        {{- emit_thinking_effort() -}}
+        {%- set state.effort_emitted = true -%}
+    {%- endif -%}
+
+    {%- set header = namespace(text=role_token[message.role]) -%}
+    {%- if message.role == "tool" -%}
+        {%- if message.name is defined and message.name -%}
+            {%- set header.text = header.text ~ message.name -%}
+        {%- elif message.tool_call_id is defined and message.tool_call_id -%}
+            {%- for prev in messages -%}
+                {%- if prev.role == "assistant" and prev.tool_calls -%}
+                    {%- for tc in prev.tool_calls -%}
+                        {%- if tc.id is defined and tc.id == message.tool_call_id and tc.function.name is defined -%}
+                            {%- set header.text = header.text ~ tc.function.name -%}
+                        {%- endif -%}
+                    {%- endfor -%}
+                {%- endif -%}
+            {%- endfor -%}
+        {%- endif -%}
+    {%- elif message.role == "assistant" and message.name is defined and message.name -%}
+        {%- set header.text = header.text ~ message.name -%}
+    {%- endif -%}
+    {%- set rtok = header.text -%}
+
+    {%- if message.role == "assistant" and message.reasoning_content is defined and message.reasoning_content -%}
+        {{- rtok ~ "<|content_thinking|>" ~ message.reasoning_content ~ "<|end_message|>" -}}
+    {%- endif -%}
+
+    {%- if message.content is string and (message.content or not (message.role == "assistant" and (message.tool_calls or message.reasoning_content))) -%}
+        {{- rtok ~ "<|content_text|>" ~ message.content ~ "<|end_message|>" -}}
+    {%- elif message.content -%}
+        {%- for part in message.content -%}
+            {%- if part is string -%}
+                {{- rtok ~ "<|content_text|>" ~ part ~ "<|end_message|>" -}}
+            {%- elif part.type is not defined or part.type in ("text", "input_text") -%}
+                {%- set text_part = (part.text if part.text is defined and part.text is string else "") -%}
+                {{- rtok ~ "<|content_text|>" ~ text_part ~ "<|end_message|>" -}}
+            {%- elif part.type in ("image", "input_image", "image_url") -%}
+                {%- if message.role not in ("user", "tool") -%}
+                    {{- raise_exception("Image content is only supported for user and tool messages") -}}
+                {%- endif -%}
+                {{- rtok ~ "<|content_image|><|unused_200054|><|end_message|>" -}}
+            {%- elif part.type in ("audio", "input_audio", "audio_url") -%}
+                {{- raise_exception("Inkling 2 does not accept audio input") -}}
+            {%- else -%}
+                {{- raise_exception("Unsupported content part type: " ~ part.type) -}}
+            {%- endif -%}
+        {%- endfor -%}
+    {%- endif -%}
+
+    {%- if message.role == "assistant" and message.tool_calls -%}
+        {%- for tc in message.tool_calls -%}
+            {%- set fn = tc.function -%}
+            {%- if fn.name is not defined or fn.name is not string -%}
+                {{- raise_exception("tool call function name must be a string") -}}
+            {%- endif -%}
+            {%- if message.name is defined and message.name and message.name != fn.name -%}
+                {{- raise_exception("assistant name " ~ message.name ~ " does not match its tool call " ~ fn.name) -}}
+            {%- endif -%}
+            {%- set args = fn.arguments if fn.arguments is defined and fn.arguments else {} -%}
+            {%- if args is string -%}
+                {{- raise_exception("tool call arguments must be a parsed object, not a JSON string; canonicalize upstream") -}}
+            {%- endif -%}
+            {%- if args is not mapping -%}
+                {{- raise_exception("tool call arguments must be an object") -}}
+            {%- endif -%}
+            {{- "<|message_model|>" ~ fn.name ~ "<|content_invoke_tool_json|>" -}}
+            {{- '{"name":' ~ (fn.name | tojson(sort_keys=true, separators=(",", ":"))) ~ ',"args":' -}}
+            {{- "{" -}}
+            {%- for key, value in args | dictsort(case_sensitive=true) -%}
+                {{- (key | tojson) ~ ":" ~ (value | tojson(separators=(",", ":"))) -}}
+                {%- if not loop.last -%},{%- endif -%}
+            {%- endfor -%}
+            {{- "}}<|end_message|>" -}}
+        {%- endfor -%}
+    {%- endif -%}
+
+    {%- if message.role == "assistant" -%}
+        {{- "<|content_model_end_sampling|>" -}}
+    {%- endif -%}
+{%- endfor -%}
+
+{%- if not state.effort_emitted -%}
+    {{- emit_thinking_effort() -}}
+{%- endif -%}
diff --git a/zig/src/families/inkling2/config.zig b/zig/src/families/inkling2/config.zig
new file mode 100644
index 0000000..b7f915a
--- /dev/null
+++ b/zig/src/families/inkling2/config.zig
@@ -0,0 +1,238 @@
+//! Inkling 2 Small's shape from the release's config.json (text_config); what the kernels do not cover is refused.
+const std = @import("std");
+
+pub const max_layers = 64;
+
+/// A layer's attention: sliding (window, static short convolutions) or global (log scaling, dynamic convolutions).
+pub const Kind = enum { sliding, global };
+
+pub const Config = struct {
+    hidden: u32 = 4608,
+    layers: u32 = 48,
+    vocab: u32 = 201024,
+    /// Rows of the head that are real tokens; the rest of `vocab` is padding.
+    real_vocab: u32 = 200058,
+    eps: f32 = 1e-6,
+    heads: u32 = 48,
+    kv_heads: u32 = 8,
+    head_dim: u32 = 128,
+    /// Width of each head's relative-position vector and the distances its bias profile covers.
+    d_rel: u32 = 16,
+    rel_extent: u32 = 1024,
+    window: u32 = 1024,
+    qk_clip: f32 = 22.627416997969522,
+    rel_clip: f32 = 8.0,
+    log_floor: f32 = 128000,
+    log_alpha: f32 = 0.1,
+    conv: u32 = 4,
+    block_layers: u32 = 6,
+    experts: u32 = 384,
+    topk: u32 = 8,
+    intermediate: u32 = 2304,
+    gate_softcap: f32 = 4.0,
+    up_softcap: f32 = 25.0,
+    route_scale: f32 = 8.0,
+    logit_softcap: f32 = 30.0,
+    context: u32 = 1048576,
+    eos: [4]u32 = .{ 200006, 0, 0, 0 },
+    eos_count: u32 = 1,
+    layer: [max_layers]Kind = undefined,
+
+    pub fn read(gpa: std.mem.Allocator, io: std.Io, dir: []const u8) !Config {
+        const path = try std.fs.path.join(gpa, &.{ dir, "config.json" });
+        defer gpa.free(path);
+        const bytes = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 22));
+        defer gpa.free(bytes);
+        return parse(gpa, bytes);
+    }
+
+    /// Query heads that share one key head.
+    pub fn group(c: *const Config) u32 {
+        return c.heads / c.kv_heads;
+    }
+
+    pub fn globals(c: *const Config) u32 {
+        var n: u32 = 0;
+        for (c.layer[0..c.layers]) |k| n += @intFromBool(k == .global);
+        return n;
+    }
+
+    /// Key and value bytes one token takes on a rank holding `kv` key heads: the global layers' bf16 keys and values.
+    pub fn tokenBytes(c: *const Config, kv: u32) u64 {
+        return @as(u64, c.globals()) * kv * c.head_dim * 2 * 2;
+    }
+
+    /// The end-of-reply ids config.json names.
+    pub fn stops(c: *const Config) []const u32 {
+        return c.eos[0..c.eos_count];
+    }
+};
+
+pub const Error = error{ BadInkling2Config, UnsupportedInkling2Config, UnsupportedInkling2Attention, UnsupportedInkling2Experts };
+
+fn field(o: std.json.ObjectMap, key: []const u8) Error!std.json.Value {
+    return o.get(key) orelse error.BadInkling2Config;
+}
+
+fn number(o: std.json.ObjectMap, key: []const u8) Error!f32 {
+    return switch (try field(o, key)) {
+        .integer => |i| @floatFromInt(i),
+        .float => |f| @floatCast(f),
+        else => error.BadInkling2Config,
+    };
+}
+
+fn int(o: std.json.ObjectMap, key: []const u8) Error!u32 {
+    const v = try field(o, key);
+    if (v != .integer or v.integer < 0 or v.integer > std.math.maxInt(u32)) return error.BadInkling2Config;
+    return @intCast(v.integer);
+}
+
+fn flag(o: std.json.ObjectMap, key: []const u8, want: bool) Error!void {
+    const v = try field(o, key);
+    if (v != .bool) return error.BadInkling2Config;
+    if (v.bool != want) return error.UnsupportedInkling2Config;
+}
+
+fn same(o: std.json.ObjectMap, key: []const u8, want: u32) Error!void {
+    if ((try int(o, key)) != want) return error.UnsupportedInkling2Attention;
+}
+
+pub fn parse(gpa: std.mem.Allocator, bytes: []const u8) !Config {
+    var doc = try std.json.parseFromSlice(std.json.Value, gpa, bytes, .{});
+    defer doc.deinit();
+    if (doc.value != .object) return error.BadInkling2Config;
+    const root = doc.value.object;
+    const mt = try field(root, "model_type");
+    if (mt != .string or !std.mem.eql(u8, mt.string, "inkling2")) return error.UnsupportedInkling2Config;
+    const text = try field(root, "text_config");
+    if (text != .object) return error.BadInkling2Config;
+    const t = text.object;
+    var c = Config{};
+    c.hidden = try int(t, "hidden_size");
+    c.layers = try int(t, "num_hidden_layers");
+    c.vocab = try int(t, "vocab_size");
+    c.real_vocab = try int(t, "unpadded_vocab_size");
+    c.eps = try number(t, "rms_norm_eps");
+    c.heads = try int(t, "num_attention_heads");
+    c.kv_heads = try int(t, "num_key_value_heads");
+    c.head_dim = try int(t, "head_dim");
+    c.d_rel = try int(t, "d_rel");
+    c.rel_extent = try int(t, "rel_extent");
+    c.window = try int(t, "sliding_window_size");
+    c.qk_clip = try number(t, "qk_l2_clip_threshold");
+    c.rel_clip = try number(t, "rel_l2_clip_threshold");
+    c.log_floor = try number(t, "log_scaling_n_floor");
+    c.log_alpha = try number(t, "log_scaling_alpha");
+    c.conv = try int(t, "sconv_kernel_size");
+    c.block_layers = try int(t, "n_layers_per_attn_res_block");
+    c.experts = try int(t, "n_routed_experts");
+    c.topk = try int(t, "num_experts_per_tok");
+    c.intermediate = try int(t, "intermediate_size");
+    c.gate_softcap = try number(t, "mlp_gate_softcap");
+    c.up_softcap = try number(t, "mlp_up_softcap");
+    c.route_scale = try number(t, "route_scale");
+    c.logit_softcap = try number(t, "final_logit_softcapping");
+    c.context = try int(t, "model_max_length");
+    // the sliding layers' attention has the global layers' shape: one kernel serves both
+    try same(t, "swa_num_attention_heads", c.heads);
+    try same(t, "swa_num_key_value_heads", c.kv_heads);
+    try same(t, "swa_head_dim", c.head_dim);
+    try flag(t, "use_value_norm_no_gamma", true);
+    try flag(t, "q_bias", false);
+    try flag(t, "o_bias", false);
+    try flag(t, "pre_norm_pre_affine", false);
+    try flag(t, "final_norm_pre_affine", false);
+    try flag(t, "attn_res_normalize_values", true);
+    try flag(t, "use_gate_bias", true);
+    if ((try int(t, "n_shared_experts")) != 0) return error.UnsupportedInkling2Experts;
+    try readEos(root, &c);
+    try readLayers(t, &c);
+    try validate(&c);
+    return c;
+}
+
+/// config.json's eos_token_id: one id or a list of up to four.
+fn readEos(root: std.json.ObjectMap, c: *Config) Error!void {
+    const v = try field(root, "eos_token_id");
+    c.eos_count = 0;
+    const one = [_]std.json.Value{v};
+    const items: []const std.json.Value = if (v == .array) v.array.items else &one;
+    if (items.len == 0 or items.len > c.eos.len) return error.BadInkling2Config;
+    for (items) |x| {
+        if (x != .integer or x.integer < 0 or x.integer > std.math.maxInt(u32)) return error.BadInkling2Config;
+        c.eos[c.eos_count] = @intCast(x.integer);
+        c.eos_count += 1;
+    }
+}
+
+/// local_layer_ids names the sliding layers; every other layer is global.
+fn readLayers(t: std.json.ObjectMap, c: *Config) Error!void {
+    if (c.layers == 0 or c.layers > max_layers) return error.UnsupportedInkling2Config;
+    for (c.layer[0..c.layers]) |*k| k.* = .global;
+    const v = try field(t, "local_layer_ids");
+    if (v != .array) return error.BadInkling2Config;
+    for (v.array.items) |x| {
+        if (x != .integer or x.integer < 0 or x.integer >= c.layers) return error.BadInkling2Config;
+        const i: usize = @intCast(x.integer);
+        if (c.layer[i] == .sliding) return error.BadInkling2Config;
+        c.layer[i] = .sliding;
+    }
+}
+
+/// What tf_ink2_* and the plan cover: 128-wide heads, a 16-wide rel vector over 1,024 distances, whole key groups.
+pub fn validate(c: *const Config) Error!void {
+    if (c.head_dim != 128 or c.d_rel != 16 or c.rel_extent != 1024 or c.window != 1024 or c.kv_heads == 0 or
+        c.heads % c.kv_heads != 0 or c.kv_heads % 2 != 0 or c.qk_clip <= 0 or c.rel_clip <= 0 or c.log_floor < 1 or
+        c.conv != 4 or c.block_layers == 0) return error.UnsupportedInkling2Attention;
+    if (c.globals() == 0 or c.globals() == c.layers) return error.UnsupportedInkling2Attention;
+    if (c.experts == 0 or c.experts % 8 != 0 or c.topk == 0 or c.topk > 8 or c.intermediate % 128 != 0 or
+        c.hidden % 128 != 0) return error.UnsupportedInkling2Experts;
+    if (c.real_vocab == 0 or c.real_vocab > c.vocab or c.context == 0) return error.BadInkling2Config;
+}
+
+const fixture = @embedFile("config_fixture.json");
+
+test "inkling2 config: the release's shape, 40 sliding and 8 global layers, eos from config.json" {
+    const c = try parse(std.testing.allocator, fixture);
+    try std.testing.expectEqual(@as(u32, 48), c.layers);
+    try std.testing.expectEqual(@as(u32, 8), c.globals());
+    for ([_]usize{ 5, 11, 17, 23, 29, 35, 41, 47 }) |i| try std.testing.expectEqual(Kind.global, c.layer[i]);
+    try std.testing.expectEqual(Kind.sliding, c.layer[0]);
+    try std.testing.expectEqual(Kind.sliding, c.layer[46]);
+    try std.testing.expectEqual(@as(u32, 6), c.group());
+    try std.testing.expectEqual(@as(u32, 1048576), c.context);
+    try std.testing.expectEqualSlices(u32, &.{200006}, c.stops());
+    try std.testing.expectEqual(@as(f32, 128000), c.log_floor);
+    // at TP=2 a rank holds 4 key heads: 16 KiB a token, 16 GiB at 1M
+    try std.testing.expectEqual(@as(u64, 16384), c.tokenBytes(4));
+}
+
+test "inkling2 config: other shapes, a value-norm gamma, shared experts or a different model are refused" {
+    const Case = struct { from: []const u8, to: []const u8, err: anyerror };
+    const cases = [_]Case{
+        .{ .from = "\"model_type\": \"inkling2\"", .to = "\"model_type\": \"inkling\"", .err = error.UnsupportedInkling2Config },
+        .{ .from = "\"head_dim\": 128", .to = "\"head_dim\": 96", .err = error.UnsupportedInkling2Attention },
+        .{ .from = "\"swa_head_dim\": 128", .to = "\"swa_head_dim\": 64", .err = error.UnsupportedInkling2Attention },
+        .{ .from = "\"rel_extent\": 1024", .to = "\"rel_extent\": 2048", .err = error.UnsupportedInkling2Attention },
+        .{ .from = "\"d_rel\": 16", .to = "\"d_rel\": 32", .err = error.UnsupportedInkling2Attention },
+        .{ .from = "\"sliding_window_size\": 1024", .to = "\"sliding_window_size\": 4096", .err = error.UnsupportedInkling2Attention },
+        .{ .from = "\"use_value_norm_no_gamma\": true", .to = "\"use_value_norm_no_gamma\": false", .err = error.UnsupportedInkling2Config },
+        .{ .from = "\"n_shared_experts\": 0", .to = "\"n_shared_experts\": 1", .err = error.UnsupportedInkling2Experts },
+        .{ .from = "\"num_experts_per_tok\": 8", .to = "\"num_experts_per_tok\": 9", .err = error.UnsupportedInkling2Experts },
+        .{ .from = "\"eos_token_id\": 200006", .to = "\"eos_token_id\": \"x\"", .err = error.BadInkling2Config },
+    };
+    for (cases) |x| {
+        const bytes = try std.mem.replaceOwned(u8, std.testing.allocator, fixture, x.from, x.to);
+        defer std.testing.allocator.free(bytes);
+        try std.testing.expect(!std.mem.eql(u8, bytes, fixture));
+        try std.testing.expectError(x.err, parse(std.testing.allocator, bytes));
+    }
+}
+
+test "inkling2 config: a list of end ids is read whole" {
+    const bytes = try std.mem.replaceOwned(u8, std.testing.allocator, fixture, "\"eos_token_id\": 200006", "\"eos_token_id\": [200006, 199999]");
+    defer std.testing.allocator.free(bytes);
+    const c = try parse(std.testing.allocator, bytes);
+    try std.testing.expectEqualSlices(u32, &.{ 200006, 199999 }, c.stops());
+}
