diff --git a/zig/src/families/inkling2/ops.zig b/zig/src/families/inkling2/ops.zig
new file mode 100644
index 0000000..bddab85
--- /dev/null
+++ b/zig/src/families/inkling2/ops.zig
@@ -0,0 +1,158 @@
+//! Inkling 2's glue kernels (inkling2/ops.cu): embedding, residual mix, row dots, router, SwiGLU epilogue, convs.
+const std = @import("std");
+const cuda = @import("cuda");
+
+pub const max_blocks = 8;
+pub const max_queries = 3;
+
+/// ops.cu's MixArgs, field for field.
+pub const MixArgs = extern struct {
+    blocks: [max_blocks]u64 = @splat(0),
+    partial: u64,
+    query: u64,
+    norm: [max_queries]u64 = @splat(0),
+    out: u64,
+    n_blocks: i32,
+    partial_bf16: i32,
+    nq: i32,
+    rows: i32,
+    c: i32,
+    eps: f32,
+};
+
+/// ops.cu's ConvArgs, field for field.
+pub const ConvArgs = extern struct {
+    x: u64,
+    state: u64,
+    w: u64,
+    dyn: u64 = 0,
+    base: u64 = 0,
+    resid: u64 = 0,
+    out: u64 = 0,
+    x_bf16: i32 = 0,
+    round_in: i32 = 0,
+    heads: i32 = 1,
+    c: i32,
+    rows: i32,
+    mode: i32,
+};
+
+/// ops.cu's GateUpArgs, field for field.
+pub const GateUpArgs = extern struct {
+    z: u64,
+    pick: u64,
+    svh_g: u64,
+    svh_u: u64,
+    suh_d: u64,
+    xd: u64,
+    p: i32,
+    n: i32,
+    sk: i32,
+    experts: i32,
+    gate_cap: f32,
+    up_cap: f32,
+};
+
+pub const Kernels = struct {
+    mod: cuda.Module,
+    embed: cuda.Function,
+    mix: cuda.Function,
+    rowdot: cuda.Function,
+    topk: cuda.Function,
+    gateup: cuda.Function,
+    conv: cuda.Function,
+    softcap: cuda.Function,
+
+    pub fn load(d: *const cuda.Driver) !Kernels {
+        if (!cuda.kernels.available) return error.BuiltWithoutKernels;
+        var mod = try cuda.Module.load(d, cuda.kernels.inkling2_ops);
+        errdefer mod.unload();
+        return .{
+            .mod = mod,
+            .embed = try mod.function("tf_ink2_embed"),
+            .mix = try mod.function("tf_ink2_mix"),
+            .rowdot = try mod.function("tf_ink2_rowdot"),
+            .topk = try mod.function("tf_ink2_topk"),
+            .gateup = try mod.function("tf_ink2_gateup"),
+            .conv = try mod.function("tf_ink2_conv"),
+            .softcap = try mod.function("tf_ink2_softcap"),
+        };
+    }
+
+    pub fn unload(k: *Kernels) void {
+        k.mod.unload();
+        k.* = undefined;
+    }
+};
+
+fn int(x: anytype) i32 {
+    return @intCast(x);
+}
+
+fn go(f: cuda.Function, s: cuda.Stream, grid: cuda.Dim3, threads: u32, a: *cuda.Args) !void {
+    try cuda.launch.launch(f, .{ .grid = grid, .block = .{ .x = threads } }, s, a);
+}
+
+/// Embedding rows of `ids` (int32 on the device) through embed_norm into bf16 [rows, c].
+pub fn embed(k: *const Kernels, s: cuda.Stream, ids: u64, rows: usize, table: u64, norm: u64, out: u64, c: usize, eps: f32) !void {
+    var a: cuda.Args = .{};
+    for ([_]u64{ ids, table, norm, out }) |v| a.add(v);
+    a.add(int(c));
+    a.add(eps);
+    try go(k.embed, s, .{ .x = @intCast(rows) }, 256, &a);
+}
+
+/// The residual mix of each row and query, normed: a block a row.
+pub fn mix(k: *const Kernels, s: cuda.Stream, m: MixArgs) !void {
+    var a: cuda.Args = .{};
+    a.add(m);
+    try go(k.mix, s, .{ .x = @intCast(m.rows) }, 512, &a);
+}
+
+/// out[row, j] = x[row] . w[j] over `c` (bf16 in), `j` outputs a row, bf16 or fp32 out, sigmoid when `sigmoid`.
+pub fn rowdot(k: *const Kernels, s: cuda.Stream, x: u64, w: u64, out: u64, rows: usize, j: usize, c: usize, out_bf16: bool, sigmoid: bool) !void {
+    var a: cuda.Args = .{};
+    for ([_]u64{ x, w, out }) |v| a.add(v);
+    for ([_]i32{ int(j), int(c), @intFromBool(out_bf16), @intFromBool(sigmoid) }) |v| a.add(v);
+    try go(k.rowdot, s, .{ .x = @intCast(rows), .y = @intCast((j + 7) / 8) }, 256, &a);
+}
+
+/// The router's picks and weights from fp32 sigmoid scores [rows, experts] and the selection bias.
+pub fn topk(k: *const Kernels, s: cuda.Stream, scores: u64, bias: u64, pick: u64, wts: u64, rows: usize, experts: usize, top: usize, scale: f32) !void {
+    if (experts > 512 * 8 or top > 32) return error.Inkling2RouterShape;
+    var a: cuda.Args = .{};
+    for ([_]u64{ scores, bias, pick, wts }) |v| a.add(v);
+    a.add(int(experts));
+    a.add(int(top));
+    a.add(scale);
+    try go(k.topk, s, .{ .x = @intCast(rows) }, 512, &a);
+}
+
+/// The softcapped SwiGLU epilogue over `p` (row, slot) pairs, `n` wide: the grid of exl3_experts' gate/up epilogue.
+pub fn gateup(k: *const Kernels, s: cuda.Stream, g: GateUpArgs) !void {
+    var a: cuda.Args = .{};
+    a.add(g);
+    try go(k.gateup, s, .{ .x = @intCast(g.p), .y = @intCast(@divExact(g.n, 128)) }, 32, &a);
+}
+
+/// A short convolution over a stream's rows, its state carried (ops.cu's tf_ink2_conv).
+pub fn conv(k: *const Kernels, s: cuda.Stream, c: ConvArgs) !void {
+    var a: cuda.Args = .{};
+    a.add(c);
+    try go(k.conv, s, .{ .x = @intCast(std.math.divCeil(i32, c.c, 128) catch unreachable) }, 128, &a);
+}
+
+/// tanh(x / cap) * cap over `n` fp32 logits in place.
+pub fn softcap(k: *const Kernels, s: cuda.Stream, x: u64, n: usize, cap: f32) !void {
+    var a: cuda.Args = .{};
+    a.add(x);
+    a.add(@as(i64, @intCast(n)));
+    a.add(cap);
+    try go(k.softcap, s, .{ .x = @intCast((n + 255) / 256) }, 256, &a);
+}
+
+test "ops: the argument structs keep ops.cu's layouts" {
+    try std.testing.expectEqual(@as(usize, 8 * 8 + 8 + 8 + 3 * 8 + 8 + 6 * 4), @sizeOf(MixArgs));
+    try std.testing.expectEqual(@as(usize, 7 * 8 + 6 * 4), @sizeOf(ConvArgs));
+    try std.testing.expectEqual(@as(usize, 6 * 8 + 6 * 4), @sizeOf(GateUpArgs));
+}
diff --git a/zig/src/families/inkling2/shard.zig b/zig/src/families/inkling2/shard.zig
new file mode 100644
index 0000000..d0a36f7
--- /dev/null
+++ b/zig/src/families/inkling2/shard.zig
@@ -0,0 +1,67 @@
+//! A TP rank's share of Inkling 2: whole key heads (their query groups with them), 128-wide expert and vocab blocks.
+const std = @import("std");
+const cfg = @import("config.zig");
+
+/// [lo, hi) of something a rank holds.
+pub const Span = struct {
+    lo: usize,
+    hi: usize,
+
+    pub fn len(s: Span) usize {
+        return s.hi - s.lo;
+    }
+
+    /// Part `rank` of `world` of [0, n) in whole `unit`s, the earlier ranks taking any extra unit.
+    pub fn part(n: usize, unit: usize, rank: usize, world: usize) !Span {
+        if (n % unit != 0 or world == 0 or rank >= world) return error.BadSplit;
+        const units = n / unit;
+        if (units < world) return error.BadSplit;
+        const base = units / world;
+        const extra = units % world;
+        const lo = rank * base + @min(rank, extra);
+        return .{ .lo = lo * unit, .hi = (lo + base + @intFromBool(rank < extra)) * unit };
+    }
+};
+
+pub const Share = struct {
+    rank: usize,
+    world: usize,
+    kv: Span, // key heads
+    heads: Span, // query heads: the key heads' groups
+    inter: Span, // expert intermediate columns
+    vocab: Span, // padded vocabulary rows of the head
+
+    /// The rank's share; key heads must split evenly (each rank holds whole query groups and the same cache shape).
+    pub fn of(c: *const cfg.Config, padded_vocab: usize, rank: usize, world: usize) !Share {
+        if (c.kv_heads % world != 0) return error.BadSplit;
+        const kv = try Span.part(c.kv_heads, 1, rank, world);
+        const g = c.group();
+        return .{
+            .rank = rank,
+            .world = world,
+            .kv = kv,
+            .heads = .{ .lo = kv.lo * g, .hi = kv.hi * g },
+            .inter = try Span.part(c.intermediate, 128, rank, world),
+            .vocab = try Span.part(padded_vocab, 128, rank, world),
+        };
+    }
+
+    pub fn whole(s: Share) bool {
+        return s.world == 1;
+    }
+};
+
+test "shard: two ranks take whole key heads with their query groups, 128-wide expert and vocab blocks" {
+    const c: cfg.Config = .{};
+    const r0 = try Share.of(&c, 201088, 0, 2);
+    const r1 = try Share.of(&c, 201088, 1, 2);
+    try std.testing.expectEqual(Span{ .lo = 0, .hi = 4 }, r0.kv);
+    try std.testing.expectEqual(Span{ .lo = 24, .hi = 48 }, r1.heads);
+    try std.testing.expectEqual(Span{ .lo = 1152, .hi = 2304 }, r1.inter);
+    // 201,088 = 1,571 blocks of 128: rank 0 takes the odd one
+    try std.testing.expectEqual(Span{ .lo = 0, .hi = 786 * 128 }, r0.vocab);
+    try std.testing.expectEqual(@as(usize, 201088), r1.vocab.hi);
+    const one = try Share.of(&c, 201088, 0, 1);
+    try std.testing.expect(one.whole() and one.heads.len() == 48 and one.inter.len() == 2304);
+    try std.testing.expectError(error.BadSplit, Share.of(&c, 201088, 0, 3));
+}
diff --git a/zig/src/families/inkling2/weights.zig b/zig/src/families/inkling2/weights.zig
new file mode 100644
index 0000000..587bf88
--- /dev/null
+++ b/zig/src/families/inkling2/weights.zig
@@ -0,0 +1,223 @@
+//! A TP rank's Inkling 2 weights from an EXL3 pack (G1's names): EXL3 projections and experts, the rest as stored.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const cfg = @import("config.zig");
+const shard = @import("shard.zig");
+const exl3 = @import("exl3.zig");
+
+const Tensor = core.checkpoint.Tensor;
+pub const Linear = cuda.exl3.Weight;
+
+/// The text decoder's tensors sit under this prefix; the vision tower and the drafter ship beside the pack.
+pub const prefix = "model.llm.";
+
+/// q, r, gate by the rank's query heads, k, v by its key heads, o by its rows; the raw tensors cut the same way.
+pub const Attention = struct {
+    q: Linear,
+    k: Linear,
+    v: Linear,
+    r: Linear,
+    gate: Linear,
+    o: Linear,
+    sink: u64, // bf16 [heads][hidden]
+    q_scale: u64, // bf16 [heads][128]
+    rel_scale: u64, // bf16 [heads][16]
+    rel_proj: u64, // bf16 [16][1024], whole
+    k_conv: u64, // sliding: bf16 [kv * 128][4]; global: static taps bf16 [4][kv * 128]
+    v_conv: u64,
+    k_proj: u64 = 0, // global: the dynamic taps' projection, bf16 [kv * 4][hidden]
+    v_proj: u64 = 0,
+};
+
+pub const Layer = struct {
+    kind: cfg.Kind,
+    norms: [3]u64, // attn_norm (sliding) or q/k/v input norms (global), bf16 [hidden]
+    attn_query: u64, // fp32 [nq][hidden]; 0 on layer 0 (no mix)
+    nq: u32,
+    mlp_query: u64, // fp32 [hidden]
+    mlp_norm: u64,
+    attn_conv: u64, // bf16 [hidden][4]
+    mlp_conv: u64,
+    attn: Attention,
+    router: u64, // bf16 [experts][hidden]
+    bias: u64, // fp32 [experts]
+    experts: cuda.exl3_experts.Layer,
+};
+
+pub const Weights = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    config: cfg.Config,
+    share: shard.Share,
+    padded_vocab: usize = 0,
+    embed: u64 = 0, // bf16 [vocab][hidden], whole on every rank
+    embed_norm: u64 = 0,
+    norm: u64 = 0,
+    out_query: u64 = 0, // fp32 [hidden]
+    head: Linear = undefined, // the rank's vocabulary rows of the 8-bit head
+    layers: []Layer = &.{},
+    buffers: std.ArrayList(cuda.DeviceBuffer) = .empty,
+    bytes: u64 = 0,
+
+    pub fn deinit(w: *Weights) void {
+        for (w.buffers.items) |*b| b.free();
+        w.buffers.deinit(w.gpa);
+        w.gpa.free(w.layers);
+        w.* = undefined;
+    }
+
+    fn put(ctx: *anyopaque, bytes: []const u8) anyerror!u64 {
+        const w: *Weights = @ptrCast(@alignCast(ctx));
+        const b = try cuda.DeviceBuffer.fromHost(w.d, bytes);
+        errdefer {
+            var owned = b;
+            owned.free();
+        }
+        try w.buffers.append(w.gpa, b);
+        w.bytes += b.len;
+        return b.ptr;
+    }
+};
+
+const Loader = struct {
+    gpa: std.mem.Allocator,
+    w: *Weights,
+    ck: *core.Checkpoint,
+    sink: exl3.Sink,
+    buf: [192]u8 = undefined,
+    name: []const u8 = "",
+
+    fn get(L: *Loader, comptime fmt: []const u8, args: anytype) !Tensor {
+        L.name = try std.fmt.bufPrint(&L.buf, prefix ++ fmt, args);
+        return L.ck.get(L.name);
+    }
+
+    fn expect(L: *Loader, comptime fmt: []const u8, args: anytype, dtype: core.checkpoint.DType, dims: []const usize) !Tensor {
+        const t = try L.get(fmt, args);
+        if (!t.is(dtype, dims)) {
+            std.log.err("inkling2: {s} is not {s}{any}", .{ L.name, @tagName(dtype), dims });
+            return error.UnexpectedInkling2Tensor;
+        }
+        return t;
+    }
+
+    fn put(L: *Loader, bytes: []const u8) !u64 {
+        return L.sink.put(L.sink.ctx, bytes);
+    }
+
+    /// Rows [lo, hi) of a stored row-major tensor whose rows are `row_bytes` long.
+    fn rows(L: *Loader, t: Tensor, lo: usize, hi: usize) !u64 {
+        const rb = t.bytes.len / t.dim(0);
+        return L.put(t.bytes[lo * rb .. hi * rb]);
+    }
+
+    /// Columns [lo, hi) of every row of a stored 2-D bf16 tensor.
+    fn cols(L: *Loader, t: Tensor, lo: usize, hi: usize) !u64 {
+        const n = t.dim(1);
+        var out: std.ArrayList(u8) = .empty;
+        defer out.deinit(L.gpa);
+        for (0..t.dim(0)) |r| try out.appendSlice(L.gpa, t.bytes[2 * (r * n + lo) .. 2 * (r * n + hi)]);
+        return L.put(out.items);
+    }
+
+    fn lin(L: *Loader, i: u32, name: []const u8, n: usize, k: usize, c: exl3.Cut) !Linear {
+        var b: [128]u8 = undefined;
+        return exl3.linear(L.gpa, L.ck, L.sink, try std.fmt.bufPrint(&b, prefix ++ "layers.{d}.attn.{s}", .{ i, name }), n, k, c);
+    }
+
+    fn attention(L: *Loader, i: u32) !Attention {
+        const c = &L.w.config;
+        const s = L.w.share;
+        const h: usize = c.hidden;
+        const D: usize = c.head_dim;
+        const H: usize = c.heads;
+        const KV: usize = c.kv_heads;
+        const q: shard.Span = .{ .lo = s.heads.lo * D, .hi = s.heads.hi * D };
+        const kv: shard.Span = .{ .lo = s.kv.lo * D, .hi = s.kv.hi * D };
+        const rel: shard.Span = .{ .lo = s.heads.lo * c.d_rel, .hi = s.heads.hi * c.d_rel };
+        var a: Attention = .{
+            .q = try L.lin(i, "wq_du", H * D, h, .{ .cols = q }),
+            .k = try L.lin(i, "wk_dv", KV * D, h, .{ .cols = kv }),
+            .v = try L.lin(i, "wv_dv", KV * D, h, .{ .cols = kv }),
+            .r = try L.lin(i, "wr_du", H * c.d_rel, h, if (s.whole()) .whole else .{ .cols = rel }),
+            .gate = try L.lin(i, "gate_attn", H * D, h, .{ .cols = q }),
+            .o = try L.lin(i, "wo_ud", h, H * D, .{ .rows = q }),
+            .sink = try L.rows(try L.expect("layers.{d}.attn.attn_sink_proj.weight", .{i}, .bf16, &.{ H, h }), s.heads.lo, s.heads.hi),
+            .q_scale = try L.rows(try L.expect("layers.{d}.attn.q_l2_clip.scale", .{i}, .bf16, &.{ H, D }), s.heads.lo, s.heads.hi),
+            .rel_scale = try L.rows(try L.expect("layers.{d}.attn.rel_l2_clip.scale", .{i}, .bf16, &.{ H, c.d_rel }), s.heads.lo, s.heads.hi),
+            .rel_proj = try L.rows(try L.expect("layers.{d}.attn.rel_logits_proj.proj", .{i}, .bf16, &.{ c.d_rel, c.rel_extent }), 0, c.d_rel),
+            .k_conv = 0,
+            .v_conv = 0,
+        };
+        if (c.layer[i] == .sliding) {
+            a.k_conv = try L.rows(try L.expect("layers.{d}.attn.k_sconv.weight", .{i}, .bf16, &.{ KV * D, 1, c.conv }), kv.lo, kv.hi);
+            a.v_conv = try L.rows(try L.expect("layers.{d}.attn.v_sconv.weight", .{i}, .bf16, &.{ KV * D, 1, c.conv }), kv.lo, kv.hi);
+        } else {
+            a.k_conv = try L.cols(try L.expect("layers.{d}.attn.k_sconv.static_w", .{i}, .bf16, &.{ c.conv, KV * D }), kv.lo, kv.hi);
+            a.v_conv = try L.cols(try L.expect("layers.{d}.attn.v_sconv.static_w", .{i}, .bf16, &.{ c.conv, KV * D }), kv.lo, kv.hi);
+            const t0 = s.kv.lo * c.conv;
+            const t1 = s.kv.hi * c.conv;
+            a.k_proj = try L.rows(try L.expect("layers.{d}.attn.k_sconv.weight_proj", .{i}, .bf16, &.{ KV * c.conv, h }), t0, t1);
+            a.v_proj = try L.rows(try L.expect("layers.{d}.attn.v_sconv.weight_proj", .{i}, .bf16, &.{ KV * c.conv, h }), t0, t1);
+        }
+        return a;
+    }
+
+    fn vector(L: *Loader, comptime fmt: []const u8, args: anytype, dtype: core.checkpoint.DType, n: usize) !u64 {
+        return L.put((try L.expect(fmt, args, dtype, &.{n})).bytes);
+    }
+
+    fn layer(L: *Loader, i: u32) !Layer {
+        const c = &L.w.config;
+        const h: usize = c.hidden;
+        const global = c.layer[i] == .global;
+        var l: Layer = undefined;
+        l.kind = c.layer[i];
+        l.norms = @splat(0);
+        if (global) {
+            for ([_][]const u8{ "q", "k", "v" }, 0..) |n, j| l.norms[j] = try L.vector("layers.{d}.{s}_input_norm.weight", .{ i, n }, .bf16, h);
+        } else l.norms[0] = try L.vector("layers.{d}.attn_norm.weight", .{i}, .bf16, h);
+        l.nq = if (global) 3 else 1;
+        l.attn_query = 0;
+        if (i > 0) {
+            const t = try L.get("attn_res.attn_queries.{d}", .{i - 1});
+            if (t.dtype != .f32 or t.numel() != l.nq * h) return error.UnexpectedInkling2Tensor;
+            l.attn_query = try L.put(t.bytes);
+        }
+        l.mlp_query = try L.vector("attn_res.mlp_queries.{d}", .{i}, .f32, h);
+        l.mlp_norm = try L.vector("layers.{d}.mlp_norm.weight", .{i}, .bf16, h);
+        l.attn_conv = try L.put((try L.expect("layers.{d}.attn_sconv.weight", .{i}, .bf16, &.{ h, 1, c.conv })).bytes);
+        l.mlp_conv = try L.put((try L.expect("layers.{d}.mlp_sconv.weight", .{i}, .bf16, &.{ h, 1, c.conv })).bytes);
+        l.attn = try L.attention(i);
+        l.router = try L.put((try L.expect("layers.{d}.mlp.gate.weight", .{i}, .bf16, &.{ c.experts, h })).bytes);
+        l.bias = try L.vector("layers.{d}.mlp.gate.bias", .{i}, .f32, c.experts);
+        l.experts = try exl3.experts(L.gpa, L.ck, L.sink, prefix, i, c.experts, h, c.intermediate, L.w.share.inter);
+        return l;
+    }
+};
+
+/// The rank's weights of `layers` (a prefix for a truncated pack), the embedding whole, its vocabulary's head rows.
+pub fn load(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, dense: *cuda.exl3.Dense, stream: cuda.Stream, dir: []const u8, c: cfg.Config, rank: usize, world: usize) !Weights {
+    var ck = try core.Checkpoint.openModel(gpa, io, dir);
+    defer core.checkpoint.cache.close(&ck);
+    const head_svh = try ck.get(prefix ++ "unembed.svh");
+    const padded = head_svh.dim(0);
+    if (padded < c.vocab or padded % 128 != 0) return error.UnexpectedInkling2Tensor;
+    var w: Weights = .{ .gpa = gpa, .d = d, .config = c, .share = try shard.Share.of(&c, padded, rank, world), .padded_vocab = padded };
+    errdefer w.deinit();
+    var L: Loader = .{ .gpa = gpa, .w = &w, .ck = &ck, .sink = .{ .ctx = &w, .put = Weights.put, .dense = dense, .stream = stream } };
+    w.layers = try gpa.alloc(Layer, c.layers);
+    for (w.layers, 0..) |*l, i| {
+        l.* = try L.layer(@intCast(i));
+        ck.release(); // the pages read so far, before they crowd the device's allocations
+    }
+    w.embed = try L.put((try L.expect("embed.weight", .{}, .bf16, &.{ c.vocab, c.hidden })).bytes);
+    w.embed_norm = try L.vector("embed_norm.weight", .{}, .bf16, c.hidden);
+    w.norm = try L.vector("norm.weight", .{}, .bf16, c.hidden);
+    w.out_query = try L.vector("attn_res.output_query", .{}, .f32, c.hidden);
+    const v = w.share.vocab;
+    w.head = try exl3.linear(gpa, &ck, L.sink, prefix ++ "unembed", padded, c.hidden, if (w.share.whole()) .whole else .{ .cols = v });
+    try stream.synchronize();
+    return w;
+}
