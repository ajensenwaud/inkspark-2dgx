+/// The family in tf-cuda-test's `runner`, and tf-inkling2-cuda (every row's logits for the exllamav3 reference).
+pub fn targets(b: *std.Build, target: std.Build.ResolvedTarget, optimize: std.builtin.OptimizeMode, strip: bool, cuda: *std.Build.Module, core: *std.Build.Module, runner: *std.Build.Module) void {
+    runner.addImport("inkling2", module(b, target, optimize, cuda, core));
+    const m = b.createModule(.{ .root_source_file = b.path("zig/src/families/inkling2/dump_main.zig"), .target = target, .optimize = optimize, .link_libc = true, .strip = strip });
+    m.addImport("cuda", cuda);
+    m.addImport("inkling2", module(b, target, optimize, cuda, core));
+    const exe = b.addExecutable(.{ .name = "tf-inkling2-cuda", .root_module = m });
+    b.installArtifact(exe);
+    b.step("tf-inkling2-cuda", "Inkling 2's CUDA forward rows for the exllamav3 reference").dependOn(&b.addInstallArtifact(exe, .{}).step);
+}
+
 /// The family's host regressions (config, chat wiring, reply split, admission, the attention plan) in `all`.
