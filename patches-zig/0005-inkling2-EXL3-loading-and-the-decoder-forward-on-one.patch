diff --git a/zig/src/families/inkling2/dump_main.zig b/zig/src/families/inkling2/dump_main.zig
new file mode 100644
index 0000000..b0eac2a
--- /dev/null
+++ b/zig/src/families/inkling2/dump_main.zig
@@ -0,0 +1,91 @@
+//! tf-inkling2-cuda: every row's logits of each text on one GPU, as one prompt pass (in chunks) and as decode rows.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const ink = @import("inkling2");
+
+const usage = "usage: tf-inkling2-cuda <model dir> <ids.json> <out dir> [prompt chunk rows]\n" ++
+    "  ids.json maps text names to token ids; writes <name>.prompt.f32 and <name>.decode.f32 ([rows][real vocab])\n";
+
+pub fn main(init: std.process.Init) !u8 {
+    const a = init.arena.allocator();
+    const gpa = init.gpa;
+    const io = init.io;
+    const args = try init.minimal.args.toSlice(a);
+    if (args.len != 4 and args.len != 5) {
+        std.debug.print("{s}", .{usage});
+        return 2;
+    }
+    const text = try std.Io.Dir.cwd().readFileAlloc(io, args[2], a, .limited(1 << 26));
+    var doc = try std.json.parseFromSlice(std.json.Value, a, text, .{});
+    defer doc.deinit();
+    if (doc.value != .object) return error.BadIds;
+    var longest: usize = 0;
+    var it = doc.value.object.iterator();
+    while (it.next()) |e| longest = @max(longest, e.value_ptr.array.items.len);
+    if (longest == 0) return error.BadIds;
+    const chunk = if (args.len == 5) try std.fmt.parseInt(usize, args[4], 10) else longest;
+
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    if (try ctx.capability() != 121) return error.Inkling2RequiresSm121; // a one-GPU check tool: sm_121 as served
+    var stream = try cuda.Stream.init(&driver, false);
+    defer stream.deinit();
+    var m = try ink.forward.Modules.load(&driver);
+    defer m.deinit();
+    const c = try ink.config.Config.read(gpa, io, args[1]);
+    var t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    var w = try ink.weights.load(gpa, io, &driver, &m.dense, stream, args[1], c, 0, 1);
+    defer w.deinit();
+    std.debug.print("loaded {d} layers, {d:.2} GiB in {d:.1} s\n", .{ c.layers, gib(w.bytes), secs(io, t0) });
+    const shape: ink.forward.Shape = .{ .rows = @min(chunk, longest), .context = std.mem.alignForward(usize, longest + 1, 64), .heads = w.share.heads.len(), .kv = w.share.kv.len() };
+    var b = try ink.forward.Buffers.init(gpa, &driver, &w, shape);
+    defer b.deinit();
+    var st = try ink.forward.State.init(gpa, &driver, &w.config, shape);
+    defer st.deinit();
+    const f: ink.forward.Forward = .{ .d = &driver, .m = &m, .w = &w, .b = &b, .shape = shape, .stream = stream };
+    try std.Io.Dir.cwd().createDirPath(io, args[3]);
+    var out = try std.Io.Dir.cwd().openDir(io, args[3], .{});
+    defer out.close(io);
+    const nv = w.share.vocab.len();
+    const real: usize = c.real_vocab;
+    const row = try gpa.alloc(f32, shape.rows * nv);
+    defer gpa.free(row);
+    it = doc.value.object.iterator();
+    while (it.next()) |e| {
+        const list = e.value_ptr.array.items;
+        const ids = try a.alloc(i32, list.len);
+        for (list, ids) |v, *id| id.* = @intCast(v.integer);
+        const all = try gpa.alloc(f32, ids.len * real);
+        defer gpa.free(all);
+        for ([_][]const u8{ "prompt", "decode" }) |path| {
+            try stream.synchronize();
+            try st.reset();
+            t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+            const step = if (std.mem.eql(u8, path, "prompt")) shape.rows else 1;
+            var at: usize = 0;
+            while (at < ids.len) : (at += step) {
+                const n = @min(step, ids.len - at);
+                try f.run(&st, ids[at..][0..n]);
+                try stream.synchronize();
+                try b.logits.download(0, std.mem.sliceAsBytes(row[0 .. n * nv]));
+                for (0..n) |r| @memcpy(all[(at + r) * real ..][0..real], row[r * nv ..][0..real]);
+            }
+            var name: [96]u8 = undefined;
+            try out.writeFile(io, .{ .sub_path = try std.fmt.bufPrint(&name, "{s}.{s}.f32", .{ e.key_ptr.*, path }), .data = std.mem.sliceAsBytes(all) });
+            const last = all[(ids.len - 1) * real ..][0..real];
+            std.debug.print("{s} {s}: {d} rows in {d:.2} s, last row argmax {d}\n", .{ e.key_ptr.*, path, ids.len, secs(io, t0), std.mem.indexOfMax(f32, last) });
+        }
+    }
+    return 0;
+}
+
+fn gib(x: u64) f64 {
+    return @as(f64, @floatFromInt(x)) / (1 << 30);
+}
+
+fn secs(io: std.Io, t0: anytype) f64 {
+    return @as(f64, @floatFromInt(std.Io.Clock.awake.now(io).toNanoseconds() - t0)) * 1e-9;
+}
diff --git a/zig/src/families/inkling2/exl3.zig b/zig/src/families/inkling2/exl3.zig
new file mode 100644
index 0000000..8bc36f5
--- /dev/null
+++ b/zig/src/families/inkling2/exl3.zig
@@ -0,0 +1,216 @@
+//! Inkling 2's EXL3 tensors (exllamav3 1.x, mul1, G1's inkling2 overlay): projections cut to a rank, grouped experts.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const shard = @import("shard.zig");
+
+const Tensor = core.checkpoint.Tensor;
+
+/// The mul1 codebook marker's value.
+const mul1_magic: u32 = 0x83DCD12D;
+
+/// What a rank takes of a projection: all of it, its output columns, or its input rows (each a multiple of 128).
+pub const Cut = union(enum) { whole, cols: shard.Span, rows: shard.Span };
+
+/// The device side of a load: uploads go through `put`, dense weights reserve their scratch on `dense`.
+pub const Sink = struct {
+    ctx: *anyopaque,
+    put: *const fn (ctx: *anyopaque, bytes: []const u8) anyerror!u64,
+    dense: *cuda.exl3.Dense,
+    stream: cuda.Stream,
+};
+
+/// config.json's quantization_config: EXL3 from exllamav3 1.x on mul1 (each tensor's width is checked as it loads).
+pub fn admit(gpa: std.mem.Allocator, config_json: []const u8) !void {
+    const doc = try std.json.parseFromSlice(std.json.Value, gpa, config_json, .{});
+    defer doc.deinit();
+    if (doc.value != .object) return error.NotExl3;
+    const q = doc.value.object.get("quantization_config") orelse return error.NotExl3;
+    if (q != .object) return error.NotExl3;
+    const method = q.object.get("quant_method") orelse return error.NotExl3;
+    if (method != .string or !std.mem.eql(u8, method.string, "exl3")) return error.NotExl3;
+    const book = q.object.get("codebook") orelse return error.UnsupportedExl3;
+    if (book != .string or !std.mem.eql(u8, book.string, "mul1")) return error.UnsupportedExl3;
+    const version = q.object.get("version") orelse return error.UnsupportedExl3;
+    if (version != .string or !std.mem.startsWith(u8, version.string, "1.")) return error.UnsupportedExl3;
+}
+
+/// One stored projection's tensors, checked: trellis [k/16][n/16][16 * bits] i16, the mul1 marker, fp16 suh and svh.
+pub const Group = struct {
+    trellis: Tensor,
+    suh: Tensor,
+    svh: Tensor,
+    halves: u32,
+
+    fn tile(g: Group) usize {
+        return g.halves * 16;
+    }
+};
+
+pub fn group(ck: *core.Checkpoint, base: []const u8, n: usize, k: usize) !Group {
+    var buf: [192]u8 = undefined;
+    const t = try ck.get(try std.fmt.bufPrint(&buf, "{s}.trellis", .{base}));
+    if (t.dtype != .i16 or t.rank != 3 or t.dim(0) != k / 16 or t.dim(1) != n / 16 or t.dim(2) % 8 != 0) {
+        std.log.err("inkling2: {s}.trellis is not [{d}, {d}, 16 * bits]", .{ base, k / 16, n / 16 });
+        return error.UnexpectedInkling2Tensor;
+    }
+    const halves = t.dim(2) / 8;
+    if (halves < 2 or halves > 16) return error.UnsupportedExl3;
+    const marker = try ck.get(try std.fmt.bufPrint(&buf, "{s}.mul1", .{base}));
+    if (marker.dtype != .i32 or marker.bytes.len != 4 or std.mem.readInt(u32, marker.bytes[0..4], .little) != mul1_magic) return error.UnsupportedExl3;
+    const suh = try ck.get(try std.fmt.bufPrint(&buf, "{s}.suh", .{base}));
+    const svh = try ck.get(try std.fmt.bufPrint(&buf, "{s}.svh", .{base}));
+    if (!suh.is(.f16, &.{k}) or !svh.is(.f16, &.{n})) return error.UnexpectedInkling2Tensor;
+    return .{ .trellis = t, .suh = suh, .svh = svh, .halves = @intCast(halves) };
+}
+
+/// The cut's shape (k, n) and, appended to `out`, its trellis words, suh and svh in the stored layout.
+pub fn cut(gpa: std.mem.Allocator, g: Group, n: usize, k: usize, c: Cut, out: *std.ArrayList(u8), suh: *std.ArrayList(u8), svh: *std.ArrayList(u8)) ![2]usize {
+    const tb = g.tile();
+    const nt = n / 16;
+    const tr = g.trellis.bytes;
+    switch (c) {
+        .whole => {
+            try out.appendSlice(gpa, tr);
+            try suh.appendSlice(gpa, g.suh.bytes);
+            try svh.appendSlice(gpa, g.svh.bytes);
+            return .{ k, n };
+        },
+        .cols => |s| {
+            if (s.lo % 128 != 0 or s.len() % 128 != 0 or s.hi > n or s.len() == 0) return error.BadSplit;
+            for (0..k / 16) |kt| try out.appendSlice(gpa, tr[(kt * nt + s.lo / 16) * tb ..][0 .. s.len() / 16 * tb]);
+            try suh.appendSlice(gpa, g.suh.bytes);
+            try svh.appendSlice(gpa, g.svh.bytes[2 * s.lo .. 2 * s.hi]);
+            return .{ k, s.len() };
+        },
+        .rows => |s| {
+            if (s.lo % 128 != 0 or s.len() % 128 != 0 or s.hi > k or s.len() == 0) return error.BadSplit;
+            try out.appendSlice(gpa, tr[s.lo / 16 * nt * tb .. s.hi / 16 * nt * tb]);
+            try suh.appendSlice(gpa, g.suh.bytes[2 * s.lo .. 2 * s.hi]);
+            try svh.appendSlice(gpa, g.svh.bytes);
+            return .{ s.len(), n };
+        },
+    }
+}
+
+/// The stored [n][k] projection under `base`, cut to the rank, on the device for cuda.exl3.Dense.
+pub fn linear(gpa: std.mem.Allocator, ck: *core.Checkpoint, sink: Sink, base: []const u8, n: usize, k: usize, c: Cut) !cuda.exl3.Weight {
+    const g = try group(ck, base, n, k);
+    if (cuda.exl3.variantIndex(g.halves, .mul1, 4) == null) return error.UnsupportedExl3;
+    var tr: std.ArrayList(u8) = .empty;
+    defer tr.deinit(gpa);
+    var su: std.ArrayList(u8) = .empty;
+    defer su.deinit(gpa);
+    var sv: std.ArrayList(u8) = .empty;
+    defer sv.deinit(gpa);
+    const kn = try cut(gpa, g, n, k, c, &tr, &su, &sv);
+    const st = cuda.exl3.strides(kn[0], kn[1], g.halves, false);
+    const w: cuda.exl3.Weight = .{
+        .trellis = try sink.put(sink.ctx, tr.items),
+        .suh = try sink.put(sink.ctx, su.items),
+        .svh = try sink.put(sink.ctx, sv.items),
+        .k = @intCast(kn[0]),
+        .n = @intCast(kn[1]),
+        .halves = g.halves,
+        .codebook = .mul1,
+        .stride_k = st.k,
+        .stride_nb = st.nb,
+    };
+    try sink.dense.reserve(sink.stream, w);
+    return w;
+}
+
+/// Layer `i`'s 384 routed experts as one grouped EXL3 layer: gate and up by the rank's columns, down by its rows.
+pub fn experts(gpa: std.mem.Allocator, ck: *core.Checkpoint, sink: Sink, prefix: []const u8, i: u32, count: usize, d: usize, inter: usize, span: shard.Span) !cuda.exl3_experts.Layer {
+    const mods = [3][]const u8{ "gate_proj", "up_proj", "down_proj" };
+    var ptrs: [3]u64 = undefined;
+    var k2: [3]u64 = undefined;
+    var suh: [3]u64 = undefined;
+    var svh: [3]u64 = undefined;
+    var base_buf: [160]u8 = undefined;
+    for (mods, 0..) |mod, m| {
+        const down = m == 2;
+        const n = if (down) d else inter;
+        const k = if (down) inter else d;
+        var tr: std.ArrayList(u8) = .empty;
+        defer tr.deinit(gpa);
+        var su: std.ArrayList(u8) = .empty;
+        defer su.deinit(gpa);
+        var sv: std.ArrayList(u8) = .empty;
+        defer sv.deinit(gpa);
+        const at = try gpa.alloc(usize, count);
+        defer gpa.free(at);
+        const widths = try gpa.alloc(i32, count);
+        defer gpa.free(widths);
+        for (0..count) |e| {
+            const base = try std.fmt.bufPrint(&base_buf, "{s}layers.{d}.mlp.experts.{d}.{s}", .{ prefix, i, e, mod });
+            const g = try group(ck, base, n, k);
+            at[e] = tr.items.len;
+            widths[e] = @intCast(g.halves);
+            _ = try cut(gpa, g, n, k, if (down) .{ .rows = span } else .{ .cols = span }, &tr, &su, &sv);
+        }
+        const words = try sink.put(sink.ctx, tr.items);
+        const table = try gpa.alloc(u64, count);
+        defer gpa.free(table);
+        for (table, at) |*t, off| t.* = words + off;
+        ptrs[m] = try sink.put(sink.ctx, std.mem.sliceAsBytes(table));
+        k2[m] = try sink.put(sink.ctx, std.mem.sliceAsBytes(widths));
+        suh[m] = try sink.put(sink.ctx, su.items);
+        svh[m] = try sink.put(sink.ctx, sv.items);
+        ck.release();
+    }
+    return .{
+        .gate = ptrs[0],
+        .up = ptrs[1],
+        .down = ptrs[2],
+        .gate_k2 = k2[0],
+        .up_k2 = k2[1],
+        .down_k2 = k2[2],
+        .suh_g = suh[0],
+        .suh_u = suh[1],
+        .svh_g = svh[0],
+        .svh_u = svh[1],
+        .suh_d = suh[2],
+        .svh_d = svh[2],
+        .experts = count,
+        .dims = d,
+        .width = span.len(),
+        .codebook = .mul1,
+    };
+}
+
+test "exl3: admit takes exllamav3 1.x on mul1 and refuses other codebooks, versions and formats" {
+    const a = std.testing.allocator;
+    try admit(a, "{\"quantization_config\":{\"quant_method\":\"exl3\",\"version\":\"1.6.6\",\"codebook\":\"mul1\"}}");
+    try std.testing.expectError(error.UnsupportedExl3, admit(a, "{\"quantization_config\":{\"quant_method\":\"exl3\",\"version\":\"1.6.6\",\"codebook\":\"mcg\"}}"));
+    try std.testing.expectError(error.UnsupportedExl3, admit(a, "{\"quantization_config\":{\"quant_method\":\"exl3\",\"version\":\"0.9\",\"codebook\":\"mul1\"}}"));
+    try std.testing.expectError(error.NotExl3, admit(a, "{\"text_config\":{}}"));
+}
+
+test "exl3: a cut takes a rank's tile columns of every k row, or its whole tile rows, with the matching scales" {
+    const a = std.testing.allocator;
+    var words: [16 * 16 * 32]u8 = undefined;
+    for (0..16) |kt| for (0..16) |nt| @memset(words[(kt * 16 + nt) * 32 ..][0..32], @intCast(kt * 16 + nt));
+    var scales: [512]u8 = undefined;
+    for (&scales, 0..) |*s, j| s.* = @intCast(j / 2 % 256);
+    const t: Tensor = .{ .dtype = .i16, .rank = 3, .shape = .{ 16, 16, 16, 1, 1 }, .bytes = &words };
+    const v: Tensor = .{ .dtype = .f16, .rank = 1, .shape = .{ 256, 1, 1, 1, 1 }, .bytes = &scales };
+    const g: Group = .{ .trellis = t, .suh = v, .svh = v, .halves = 2 };
+    var tr: std.ArrayList(u8) = .empty;
+    defer tr.deinit(a);
+    var su: std.ArrayList(u8) = .empty;
+    defer su.deinit(a);
+    var sv: std.ArrayList(u8) = .empty;
+    defer sv.deinit(a);
+    try std.testing.expectEqual([2]usize{ 256, 128 }, try cut(a, g, 256, 256, .{ .cols = .{ .lo = 128, .hi = 256 } }, &tr, &su, &sv));
+    try std.testing.expectEqual(@as(u8, 8), tr.items[0]);
+    try std.testing.expectEqual(@as(u8, 16 + 8), tr.items[8 * 32]);
+    try std.testing.expectEqualSlices(u8, scales[256..], sv.items);
+    tr.clearRetainingCapacity();
+    su.clearRetainingCapacity();
+    sv.clearRetainingCapacity();
+    try std.testing.expectEqual([2]usize{ 128, 256 }, try cut(a, g, 256, 256, .{ .rows = .{ .lo = 128, .hi = 256 } }, &tr, &su, &sv));
+    try std.testing.expectEqual(@as(u8, 8 * 16), tr.items[0]);
+    try std.testing.expectEqualSlices(u8, scales[256..], su.items);
+    try std.testing.expectError(error.BadSplit, cut(a, g, 256, 256, .{ .cols = .{ .lo = 64, .hi = 192 } }, &tr, &su, &sv));
+}
diff --git a/zig/src/families/inkling2/experts.zig b/zig/src/families/inkling2/experts.zig
new file mode 100644
index 0000000..da82c05
--- /dev/null
+++ b/zig/src/families/inkling2/experts.zig
@@ -0,0 +1,65 @@
+//! Inkling 2's routed experts on main's grouped EXL3 kernels, the gate/up epilogue swapped for the softcapped SwiGLU.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = @import("ops.zig");
+
+const ex = cuda.exl3_experts;
+
+/// The two SwiGLU softcaps (config.json mlp_gate_softcap, mlp_up_softcap).
+pub const Caps = struct { gate: f32, up: f32 };
+
+fn i32d(v: usize) i32 {
+    return @intCast(v);
+}
+
+/// exl3_experts.Experts.run's launches in its order, ops.cu's tf_ink2_gateup in place of the shared epilogue.
+pub fn run(e: *const ex.Experts, k: *const ops.Kernels, s: cuda.Stream, l: ex.Layer, caps: Caps, x: u64, x_stride: usize, x_dtype: ex.DType, pick: u64, wts: u64, rows: usize, out: u64, sc: ex.Scratch) !void {
+    const d = l.dims;
+    const w = l.width;
+    const slots = sc.slots;
+    if (rows < 1 or rows > sc.rows or slots < 1 or slots > 32 or l.experts < 1 or l.experts > 4096) return error.BadExperts;
+    const g_sk = try ex.plan(d, w, true);
+    const d_sk = try ex.plan(w, d, false);
+    const p = rows * slots;
+    const maxu = @min(p, l.experts);
+    const mt = (rows + 15) / 16;
+
+    var a: cuda.Args = .{};
+    for ([_]u64{ pick, sc.ids, sc.count, sc.members }) |v| a.add(v);
+    for ([_]usize{ rows, slots, l.experts, rows }) |v| a.add(i32d(v));
+    try cuda.launch.launch(e.group, .{ .grid = .{ .x = 1 }, .block = .{ .x = 1024 }, .shared = @intCast(rows * slots * 4) }, s, &a);
+
+    var r: cuda.Args = .{};
+    r.add(x);
+    r.add(i32d(x_stride));
+    r.add(@as(i32, @backingInt(x_dtype)));
+    for ([_]u64{ pick, l.suh_g, l.suh_u, sc.xg, sc.xu }) |v| r.add(v);
+    for ([_]usize{ d, slots, l.experts }) |v| r.add(i32d(v));
+    try cuda.launch.launch(e.rot_in, .{ .grid = .{ .x = @intCast(p), .y = @intCast(d / 128), .z = 2 }, .block = .{ .x = 32 } }, s, &r);
+
+    var g: cuda.Args = .{};
+    for ([_]u64{ sc.xg, sc.xu, l.gate, l.up, l.gate_k2, l.up_k2, sc.ids, sc.count, sc.members, sc.z }) |v| g.add(v);
+    for ([_]usize{ d, w, p, g_sk, rows, slots, maxu }) |v| g.add(i32d(v));
+    for ([_]i32{ 2, i32d(l.gu_stride), 0, -1 }) |v| g.add(v);
+    try cuda.launch.launch(e.grouped[@backingInt(l.codebook)], .{ .grid = .{ .x = @intCast(maxu), .y = @intCast(w / 128), .z = @intCast(2 * g_sk * mt) }, .block = .{ .x = 128 } }, s, &g);
+
+    try ops.gateup(k, s, .{ .z = sc.z, .pick = pick, .svh_g = l.svh_g, .svh_u = l.svh_u, .suh_d = l.suh_d, .xd = sc.xd, .p = i32d(p), .n = i32d(w), .sk = i32d(g_sk), .experts = i32d(l.experts), .gate_cap = caps.gate, .up_cap = caps.up });
+
+    var dn: cuda.Args = .{};
+    for ([_]u64{ sc.xd, sc.xd, l.down, l.down, l.down_k2, l.down_k2, sc.ids, sc.count, sc.members, sc.z }) |v| dn.add(v);
+    for ([_]usize{ w, d, p, d_sk, rows, slots, maxu }) |v| dn.add(i32d(v));
+    for ([_]i32{ 1, 0, 0, -1 }) |v| dn.add(v);
+    try cuda.launch.launch(e.grouped[@backingInt(l.codebook)], .{ .grid = .{ .x = @intCast(maxu), .y = @intCast(d / 128), .z = @intCast(d_sk * mt) }, .block = .{ .x = 128 } }, s, &dn);
+
+    var cb: cuda.Args = .{};
+    for ([_]u64{ sc.z, pick, l.svh_d, sc.y, wts, out }) |v| cb.add(v);
+    for ([_]usize{ p, d, d_sk, l.experts, slots }) |v| cb.add(i32d(v));
+    try cuda.launch.launch(e.down_combine, .{ .grid = .{ .x = @intCast(rows), .y = @intCast(d / 128) }, .block = .{ .x = @intCast(32 * slots) } }, s, &cb);
+}
+
+test "experts: Inkling's expert shapes have built tiles (gate/up 4608 -> 2304 whole and a rank's 1152, down back)" {
+    try std.testing.expectEqual(@as(u32, 4), try ex.plan(4608, 2304, true));
+    try std.testing.expectEqual(@as(u32, 4), try ex.plan(4608, 1152, true));
+    _ = try ex.plan(2304, 4608, false);
+    _ = try ex.plan(1152, 4608, false);
+}
diff --git a/zig/src/families/inkling2/forward.zig b/zig/src/families/inkling2/forward.zig
new file mode 100644
index 0000000..5d7bd14
--- /dev/null
+++ b/zig/src/families/inkling2/forward.zig
@@ -0,0 +1,301 @@
+//! Inkling 2's decoder forward on one rank: one stream's rows (a prompt chunk or decode rows) to softcapped logits.
+const std = @import("std");
+const cuda = @import("cuda");
+const cfg = @import("config.zig");
+const kernels = @import("kernels.zig");
+const ops = @import("ops.zig");
+const experts = @import("experts.zig");
+const weights = @import("weights.zig");
+
+const Buf = cuda.DeviceBuffer;
+
+/// The kernels a forward launches: main's dense and grouped EXL3, the family's attention and glue.
+pub const Modules = struct {
+    dense: cuda.exl3.Dense,
+    experts: cuda.exl3_experts.Experts,
+    attn: kernels.Kernels,
+    ops: ops.Kernels,
+
+    pub fn load(d: *const cuda.Driver) !Modules {
+        var dense = try cuda.exl3.Dense.load(d);
+        errdefer dense.unload();
+        var ex = try cuda.exl3_experts.Experts.load(d);
+        errdefer ex.unload();
+        var attn = try kernels.Kernels.load(d);
+        errdefer attn.unload();
+        return .{ .dense = dense, .experts = ex, .attn = attn, .ops = try ops.Kernels.load(d) };
+    }
+
+    pub fn deinit(m: *Modules) void {
+        m.ops.unload();
+        m.attn.unload();
+        m.experts.unload();
+        m.dense.unload();
+    }
+};
+
+/// The geometry a stream's caches and a call's scratch are sized for.
+pub const Shape = struct {
+    rows: usize, // most rows a call takes
+    context: usize, // most positions a stream reaches
+    heads: usize, // the rank's query heads
+    kv: usize, // the rank's key heads
+
+    fn sliding(s: Shape, c: *const cfg.Config) kernels.Layer {
+        return kernels.Layer.sliding(c.window, @intCast(s.rows));
+    }
+
+    fn global(s: Shape) kernels.Layer {
+        return kernels.Layer.global(@intCast(s.context));
+    }
+
+    fn layer(s: Shape, c: *const cfg.Config, i: usize) kernels.Layer {
+        return if (c.layer[i] == .sliding) s.sliding(c) else s.global();
+    }
+
+    fn chunks(s: Shape) u32 {
+        return @max(kernels.chunks(s.context - 1, kernels.sliding_chunk), kernels.chunks(s.context - 1, kernels.global_chunk));
+    }
+};
+
+fn alloc(d: *const cuda.Driver, list: *std.ArrayList(Buf), gpa: std.mem.Allocator, bytes: usize) !u64 {
+    var b = try Buf.alloc(d, @max(bytes, 256));
+    errdefer b.free();
+    try b.fill8(0, null);
+    try list.append(gpa, b);
+    return b.ptr;
+}
+
+/// One stream's caches and conv states: K and V rings a layer, the last three inputs of each short convolution.
+pub const State = struct {
+    gpa: std.mem.Allocator,
+    bufs: std.ArrayList(Buf) = .empty,
+    kc: []u64 = &.{},
+    vc: []u64 = &.{},
+    conv: [][4]u64 = &.{}, // k, v (fp32 [3][kv * 128]) and attention, MLP (fp32 [3][hidden]) a layer
+    pos: usize = 0, // positions the caches hold
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, c: *const cfg.Config, s: Shape) !State {
+        var st: State = .{ .gpa = gpa };
+        errdefer st.deinit();
+        st.kc = try gpa.alloc(u64, c.layers);
+        st.vc = try gpa.alloc(u64, c.layers);
+        st.conv = try gpa.alloc([4]u64, c.layers);
+        for (0..c.layers) |i| {
+            const ring: usize = s.layer(c, i).ring;
+            st.kc[i] = try alloc(d, &st.bufs, gpa, s.kv * ring * c.head_dim * 2);
+            st.vc[i] = try alloc(d, &st.bufs, gpa, s.kv * ring * c.head_dim * 2);
+            for (0..2) |j| st.conv[i][j] = try alloc(d, &st.bufs, gpa, 3 * s.kv * c.head_dim * 4);
+            for (2..4) |j| st.conv[i][j] = try alloc(d, &st.bufs, gpa, 3 * @as(usize, c.hidden) * 4);
+        }
+        return st;
+    }
+
+    /// Back to an empty stream: caches and conv states zeroed.
+    pub fn reset(st: *State) !void {
+        for (st.bufs.items) |b| try b.fill8(0, null);
+        st.pos = 0;
+    }
+
+    pub fn deinit(st: *State) void {
+        for (st.bufs.items) |*b| b.free();
+        st.bufs.deinit(st.gpa);
+        st.gpa.free(st.kc);
+        st.gpa.free(st.vc);
+        st.gpa.free(st.conv);
+    }
+};
+
+/// A call's scratch, sized for Shape.rows rows.
+pub const Buffers = struct {
+    gpa: std.mem.Allocator,
+    bufs: std.ArrayList(Buf) = .empty,
+    ids: Buf = undefined, // int32 rows, then pos, seg_of, the segment and the tiles
+    x: u64 = 0, // bf16 [rows][hidden]: the residual stream between layers
+    resid: u64 = 0, // fp32 [rows][hidden]: the residual inside a layer
+    blocks: u64 = 0, // bf16 [8][rows][hidden]: the completed blocks' inputs of these rows
+    normed: u64 = 0, // bf16 [3][rows][hidden]
+    q: u64 = 0,
+    r: u64 = 0,
+    gate: u64 = 0,
+    kf: u64 = 0,
+    vf: u64 = 0,
+    kraw: u64 = 0,
+    vraw: u64 = 0,
+    dk: u64 = 0,
+    dv: u64 = 0,
+    sink: u64 = 0,
+    qo: u64 = 0,
+    relo: u64 = 0,
+    tab: u64 = 0,
+    part_o: u64 = 0,
+    part_ml: u64 = 0,
+    att: u64 = 0,
+    ao: u64 = 0,
+    scores: u64 = 0,
+    pick: u64 = 0,
+    wts: u64 = 0,
+    moe: u64 = 0,
+    exs: cuda.exl3_experts.Scratch = undefined,
+    logits: Buf = undefined, // fp32 [rows][padded vocab of the rank]
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, w: *const weights.Weights, s: Shape) !Buffers {
+        const c = &w.config;
+        var b: Buffers = .{ .gpa = gpa };
+        errdefer b.deinit();
+        const n = s.rows;
+        const h: usize = c.hidden;
+        const hd: usize = c.head_dim;
+        const A = struct {
+            fn f(bb: *Buffers, dd: *const cuda.Driver, bytes: usize) !u64 {
+                return alloc(dd, &bb.bufs, bb.gpa, bytes);
+            }
+        }.f;
+        b.ids = try Buf.alloc(d, n * 12 + 64 + kernels.tileCount(n, c.group()) * 8 + 256);
+        b.x = try A(&b, d, n * h * 2);
+        b.resid = try A(&b, d, n * h * 4);
+        b.blocks = try A(&b, d, ops.max_blocks * n * h * 2);
+        b.normed = try A(&b, d, 3 * n * h * 2);
+        b.q = try A(&b, d, n * s.heads * hd * 2);
+        b.r = try A(&b, d, n * s.heads * c.d_rel * 2);
+        b.gate = try A(&b, d, n * s.heads * hd * 2);
+        b.kf = try A(&b, d, n * s.kv * hd * 4);
+        b.vf = try A(&b, d, n * s.kv * hd * 4);
+        b.kraw = try A(&b, d, n * s.kv * hd * 2);
+        b.vraw = try A(&b, d, n * s.kv * hd * 2);
+        b.dk = try A(&b, d, n * s.kv * c.conv * 4);
+        b.dv = try A(&b, d, n * s.kv * c.conv * 4);
+        b.sink = try A(&b, d, n * s.heads * 2);
+        b.qo = try A(&b, d, n * s.heads * hd * 2);
+        b.relo = try A(&b, d, n * s.heads * c.d_rel * 2);
+        b.tab = try A(&b, d, kernels.tableBytes(n, @intCast(s.heads)));
+        const nc = s.chunks();
+        b.part_o = try A(&b, d, n * s.heads * nc * hd * 4);
+        b.part_ml = try A(&b, d, n * s.heads * nc * 8);
+        b.att = try A(&b, d, n * s.heads * hd * 2);
+        b.ao = try A(&b, d, n * h * 4);
+        b.scores = try A(&b, d, n * @as(usize, c.experts) * 4);
+        b.pick = try A(&b, d, n * c.topk * 4);
+        b.wts = try A(&b, d, n * c.topk * 4);
+        b.moe = try A(&b, d, n * h * 4);
+        const el = w.layers[0].experts;
+        b.exs = try cuda.exl3_experts.scratch(try A(&b, d, try cuda.exl3_experts.scratchBytes(el, n, c.topk)), el, n, c.topk);
+        b.logits = try Buf.alloc(d, n * w.share.vocab.len() * 4);
+        return b;
+    }
+
+    pub fn deinit(b: *Buffers) void {
+        for (b.bufs.items) |*x| x.free();
+        b.bufs.deinit(b.gpa);
+        if (b.ids.len != 0) b.ids.free();
+        if (b.logits.len != 0) b.logits.free();
+    }
+};
+
+pub const Forward = struct {
+    d: *const cuda.Driver,
+    m: *Modules,
+    w: *const weights.Weights,
+    b: *Buffers,
+    shape: Shape,
+    stream: cuda.Stream,
+
+    fn dense(f: Forward, wt: cuda.exl3.Weight, x: u64, rows: usize, y: u64, dt: cuda.exl3.DType) !void {
+        try f.m.dense.decode(f.stream, wt, x, .bf16, rows, y, dt);
+    }
+
+    /// `ids` at the stream's next positions through every layer; the rows' logits land in b.logits.
+    pub fn run(f: Forward, st: *State, ids: []const i32) !void {
+        const c = &f.w.config;
+        const n = ids.len;
+        if (n == 0 or n > f.shape.rows or st.pos + n > f.shape.context) return error.Inkling2Rows;
+        const h: usize = c.hidden;
+        const s = f.stream;
+        const k = &f.m.ops;
+        const b = f.b;
+        const p0 = st.pos;
+        // stage: ids, positions, segment of each row, the one segment, the attention tiles
+        var host: std.ArrayList(u8) = .empty;
+        defer host.deinit(f.w.gpa);
+        const gpa = f.w.gpa;
+        try host.appendSlice(gpa, std.mem.sliceAsBytes(ids));
+        for (0..n) |i| try host.appendSlice(gpa, std.mem.asBytes(&@as(i32, @intCast(p0 + i))));
+        try host.appendNTimes(gpa, 0, n * 4);
+        const seg_at = std.mem.alignForward(usize, host.items.len, 16);
+        try host.appendNTimes(gpa, 0, seg_at - host.items.len);
+        const seg = [_]kernels.Seg{.{ .row0 = 0, .n = @intCast(n), .p0 = @intCast(p0), .off = 0 }};
+        try host.appendSlice(gpa, std.mem.sliceAsBytes(&seg));
+        const tiles_at = host.items.len;
+        var tl: [4096]kernels.Tile = undefined;
+        const nt = try kernels.tiles(&seg, c.group(), &tl);
+        try host.appendSlice(gpa, std.mem.sliceAsBytes(tl[0..nt]));
+        try s.synchronize(); // the previous call's kernels may still read the staged rows
+        try b.ids.upload(0, host.items);
+        const base = b.ids.ptr;
+        const rows: kernels.Rows = .{ .rows = @intCast(n), .heads = @intCast(f.shape.heads), .kv_heads = @intCast(f.shape.kv), .pos = base + n * 4, .seg_of = base + n * 8, .segs = base + seg_at, .tiles = base + tiles_at, .n_tiles = @intCast(nt), .last_pos = @intCast(p0 + n - 1) };
+
+        try ops.embed(k, s, base, n, f.w.embed, f.w.embed_norm, b.x, h, c.eps);
+        var nb: usize = 0;
+        const hd: usize = c.head_dim;
+        const kvw = f.shape.kv * hd;
+        for (f.w.layers, 0..) |*l, i| {
+            const global = l.kind == .global;
+            var mix: ops.MixArgs = .{ .partial = b.x, .query = l.attn_query, .out = b.normed, .n_blocks = @intCast(nb), .partial_bf16 = 1, .nq = @intCast(l.nq), .rows = @intCast(n), .c = @intCast(h), .eps = c.eps };
+            for (0..nb) |j| mix.blocks[j] = b.blocks + j * n * h * 2;
+            mix.norm = l.norms;
+            try ops.mix(k, s, mix);
+            const xq = b.normed;
+            const xk = if (global) b.normed + n * h * 2 else xq;
+            const xv = if (global) b.normed + 2 * n * h * 2 else xq;
+            const a = &l.attn;
+            try f.dense(a.q, xq, n, b.q, .bf16);
+            try f.dense(a.r, xq, n, b.r, .bf16);
+            try f.dense(a.gate, xq, n, b.gate, .bf16);
+            try f.dense(a.k, xk, n, b.kf, .f32);
+            try f.dense(a.v, xv, n, b.vf, .f32);
+            try ops.rowdot(k, s, xq, a.sink, b.sink, n, f.shape.heads, h, true, false);
+            const cv = st.conv[i];
+            if (global) {
+                try ops.rowdot(k, s, xk, a.k_proj, b.dk, n, f.shape.kv * c.conv, h, false, false);
+                try ops.rowdot(k, s, xv, a.v_proj, b.dv, n, f.shape.kv * c.conv, h, false, false);
+            }
+            try ops.conv(k, s, .{ .x = b.kf, .state = cv[0], .w = a.k_conv, .dyn = if (global) b.dk else 0, .heads = @intCast(f.shape.kv), .c = @intCast(kvw), .rows = @intCast(n), .mode = 0, .out = b.kraw });
+            try ops.conv(k, s, .{ .x = b.vf, .state = cv[1], .w = a.v_conv, .dyn = if (global) b.dv else 0, .heads = @intCast(f.shape.kv), .c = @intCast(kvw), .rows = @intCast(n), .mode = 0, .out = b.vraw });
+            const lay = f.shape.layer(c, i);
+            const prep: kernels.Prep = .{ .qk_clip = c.qk_clip, .rel_clip = c.rel_clip, .floor = c.log_floor, .alpha = c.log_alpha, .eps = c.eps };
+            try kernels.prep(&f.m.attn, s, rows, lay, prep, .{ b.q, b.kraw, b.vraw, b.r }, .{ a.q_scale, a.rel_scale }, b.qo, b.relo, st.kc[i], st.vc[i]);
+            try kernels.relTable(&f.m.attn, s, rows, b.relo, a.rel_proj, b.tab);
+            try kernels.attend(&f.m.attn, s, rows, lay, b.qo, st.kc[i], st.vc[i], b.tab, b.part_o, b.part_ml, b.sink, b.gate, b.att);
+            try f.dense(a.o, b.att, n, b.ao, .f32);
+            const boundary = i % c.block_layers == 0;
+            if (boundary) {
+                if (nb == ops.max_blocks) return error.Inkling2Blocks;
+                try copy(f.d, b.blocks + nb * n * h * 2, b.x, n * h * 2, s);
+                nb += 1;
+            }
+            try ops.conv(k, s, .{ .x = b.ao, .state = cv[2], .w = l.attn_conv, .base = if (boundary) 0 else b.x, .resid = b.resid, .round_in = 1, .c = @intCast(h), .rows = @intCast(n), .mode = 1 });
+            var mm: ops.MixArgs = .{ .partial = b.resid, .query = l.mlp_query, .out = b.normed, .n_blocks = @intCast(nb), .partial_bf16 = 0, .nq = 1, .rows = @intCast(n), .c = @intCast(h), .eps = c.eps };
+            for (0..nb) |j| mm.blocks[j] = b.blocks + j * n * h * 2;
+            mm.norm[0] = l.mlp_norm;
+            try ops.mix(k, s, mm);
+            try ops.rowdot(k, s, b.normed, l.router, b.scores, n, c.experts, h, false, true);
+            try ops.topk(k, s, b.scores, l.bias, b.pick, b.wts, n, c.experts, c.topk, c.route_scale);
+            try experts.run(&f.m.experts, k, s, l.experts, .{ .gate = c.gate_softcap, .up = c.up_softcap }, b.normed, h, .bf16, b.pick, b.wts, n, b.moe, b.exs);
+            try ops.conv(k, s, .{ .x = b.moe, .state = cv[3], .w = l.mlp_conv, .resid = b.resid, .out = b.x, .round_in = 1, .c = @intCast(h), .rows = @intCast(n), .mode = 2 });
+        }
+        var fm: ops.MixArgs = .{ .partial = b.x, .query = f.w.out_query, .out = b.normed, .n_blocks = @intCast(nb), .partial_bf16 = 1, .nq = 1, .rows = @intCast(n), .c = @intCast(h), .eps = c.eps };
+        for (0..nb) |j| fm.blocks[j] = b.blocks + j * n * h * 2;
+        fm.norm[0] = f.w.norm;
+        try ops.mix(k, s, fm);
+        const nv = f.w.share.vocab.len();
+        try f.dense(f.w.head, b.normed, n, b.logits.ptr, .f32);
+        try ops.softcap(k, s, b.logits.ptr, n * nv, c.logit_softcap);
+        st.pos += n;
+    }
+};
+
+/// `bytes` from `src` to `dst` on the stream (a borrowed view of the destination).
+fn copy(d: *const cuda.Driver, dst: u64, src: u64, bytes: usize, s: cuda.Stream) !void {
+    const view: Buf = .{ .d = d, .ptr = dst, .len = bytes, .borrowed = true };
+    try view.copyFrom(0, src, bytes, s.handle);
+}
