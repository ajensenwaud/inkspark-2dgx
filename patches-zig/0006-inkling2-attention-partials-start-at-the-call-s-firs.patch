-    const n = chunks(r.last_pos, l.chunk);
+    const sp = span(r.first_pos, r.last_pos, l);
+    const n = sp.n;
     var a: cuda.Args = .{};
     for ([_]u64{ q, kc, vc, tab, r.segs, r.tiles, part_o, part_ml }) |v| a.add(v);
-    for ([_]u32{ r.heads, r.kv_heads, l.ring, l.window, l.chunk, n }) |v| a.add(int(v));
+    for ([_]u32{ r.heads, r.kv_heads, l.ring, l.window, l.chunk, sp.c0, n }) |v| a.add(int(v));
     a.add(@as(f32, 1.0 / @sqrt(@as(f32, head_dim))));
     try go(k.attn, s, .{ .x = r.n_tiles, .y = r.kv_heads, .z = n }, 128, &a);
     var b: cuda.Args = .{};
     for ([_]u64{ part_o, part_ml, sink, gate, r.pos, out }) |v| b.add(v);
-    for ([_]u32{ r.heads, l.window, l.chunk, n }) |v| b.add(int(v));
+    for ([_]u32{ r.heads, l.window, l.chunk, sp.c0, n }) |v| b.add(int(v));
     try go(k.merge, s, .{ .x = r.rows * r.heads }, head_dim, &b);
 }
 
