+
+test "inkling2 kernels: a call's partials start at its earliest row's first chunk (sliding at depth: 4 not 4096)" {
+    const sl = k.Layer.sliding(1024, 1);
+    try t.expectEqual(@as(u32, 4092), k.span(1048575, 1048575, sl).c0);
+    try t.expectEqual(@as(u32, 4), k.span(1048575, 1048575, sl).n);
+    try t.expectEqual(@as(u32, 5), k.span(1048500, 1048500, sl).n);
+    try t.expectEqual(@as(u32, 0), k.span(1023, 1023, sl).c0); // keys 0..1023
+    try t.expectEqual(@as(u32, 1), k.span(1279, 1279, sl).c0); // keys 256..1279
+    try t.expectEqual(@as(u32, 64), k.span(1048575, 1048575, k.Layer.global(1048576)).n);
+    try t.expect(k.spanMax(2048, 1048576, k.Layer.sliding(1024, 2048)) >= k.span(900000, 902047, k.Layer.sliding(1024, 2048)).n);
+}
