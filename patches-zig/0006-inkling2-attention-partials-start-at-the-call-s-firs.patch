 zig/src/families/inkling2/forward.zig      |  8 ++++----
 zig/src/families/inkling2/kernels.zig      | 21 ++++++++++++++++++---
 zig/src/families/inkling2/kernels_test.zig | 13 ++++++++++++-
 4 files changed, 39 insertions(+), 13 deletions(-)

