diff --git a/zig/src/families/inkling2/kernels.zig b/zig/src/families/inkling2/kernels.zig
index 20bd242..6ad2420 100644
--- a/zig/src/families/inkling2/kernels.zig
+++ b/zig/src/families/inkling2/kernels.zig
@@ -61,6 +61,19 @@ pub fn chunks(last_pos: usize, chunk: u32) u32 {
     return @intCast(last_pos / chunk + 1);
 }
 
+/// The chunks a call's rows at first..last read: from the earliest row's first key (window-relative partials).
+pub fn span(first_pos: usize, last_pos: usize, l: Layer) struct { c0: u32, n: u32 } {
+    const lo = if (l.window > 0) (first_pos + 1) -| l.window else 0;
+    const c0: u32 = @intCast(lo / l.chunk);
+    return .{ .c0 = c0, .n = chunks(last_pos, l.chunk) - c0 };
+}
+
+/// Most chunks one call of up to `rows` rows reads on a layer whose positions stay below `context`.
+pub fn spanMax(rows: usize, context: usize, l: Layer) u32 {
+    if (l.window == 0) return chunks(context - 1, l.chunk);
+    return @intCast(@min(chunks(context - 1, l.chunk), (rows + l.window - 2) / l.chunk + 2));
+}
+
 /// Scratch bytes of a call: the bias table (bf16) and the partials (fp32 sums plus each chunk's max and total).
 pub fn tableBytes(rows: usize, heads: u32) usize {
     return rows * heads * extent * 2;
@@ -110,6 +123,7 @@ pub const Rows = struct {
     tiles: u64,
     n_tiles: u32,
     last_pos: u32,
+    first_pos: u32, // the call's earliest row position (its chunk base)
 };
 
