+/// How the ranks' partials (after o_proj and the experts) meet: one rank alone, or gathered over NCCL in rank order.
+pub const Exchange = union(enum) {
+    local,
+    nccl: struct { lib: *const cuda.nccl.Library, comm: cuda.nccl.Comm },
+};
+
+/// A conv input made of `parts` fp32 rank partials, `stride` elements apart.
+const Parts = struct { x: u64, parts: i32, stride: i64 };
+
 pub const Forward = struct {
     d: *const cuda.Driver,
     m: *Modules,
@@ -199,6 +210,29 @@ pub const Forward = struct {
     b: *Buffers,
     shape: Shape,
     stream: cuda.Stream,
+    exchange: Exchange = .local,
+
+    /// Where a site's fp32 partial of `n` rows goes: this rank's slot of the gathered buffer, or `own` at one rank.
+    fn slot(f: Forward, own: u64, n: usize) u64 {
+        if (f.w.share.world == 1) return own;
+        return f.b.gathered + f.w.share.rank * n * f.w.config.hidden * 4;
+    }
+
+    /// Every rank's partial into every rank's gathered buffer; the conv kernels add them in rank order.
+    fn gather(f: Forward, n: usize) !Parts {
+        const h: usize = f.w.config.hidden;
+        switch (f.exchange) {
+            .local => return error.Inkling2NoExchange,
+            .nccl => |x| try x.lib.check(x.lib.api.ncclAllGather(f.slot(0, n), f.b.gathered, n * h, .f32, x.comm, f.stream.handle), "ncclAllGather"),
+        }
+        return .{ .x = f.b.gathered, .parts = @intCast(f.w.share.world), .stride = @intCast(n * h) };
+    }
+
+    /// The conv input of a partial site: the local buffer at one rank, else the gathered parts.
+    fn summed(f: Forward, own: u64, n: usize) !Parts {
+        if (f.w.share.world == 1) return .{ .x = own, .parts = 1, .stride = 0 };
+        return f.gather(n);
+    }
 
     fn dense(f: Forward, wt: cuda.exl3.Weight, x: u64, rows: usize, y: u64, dt: cuda.exl3.DType) !void {
         try f.m.dense.decode(f.stream, wt, x, .bf16, rows, y, dt);
@@ -266,22 +300,24 @@ pub const Forward = struct {
             try kernels.prep(&f.m.attn, s, rows, lay, prep, .{ b.q, b.kraw, b.vraw, b.r }, .{ a.q_scale, a.rel_scale }, b.qo, b.relo, st.kc[i], st.vc[i]);
             try kernels.relTable(&f.m.attn, s, rows, b.relo, a.rel_proj, b.tab);
             try kernels.attend(&f.m.attn, s, rows, lay, b.qo, st.kc[i], st.vc[i], b.tab, b.part_o, b.part_ml, b.sink, b.gate, b.att);
-            try f.dense(a.o, b.att, n, b.ao, .f32);
+            try f.dense(a.o, b.att, n, f.slot(b.ao, n), .f32);
+            const ao = try f.summed(b.ao, n);
             const boundary = i % c.block_layers == 0;
             if (boundary) {
                 if (nb == ops.max_blocks) return error.Inkling2Blocks;
                 try copy(f.d, b.blocks + nb * n * h * 2, b.x, n * h * 2, s);
                 nb += 1;
             }
-            try ops.conv(k, s, .{ .x = b.ao, .state = cv[2], .w = l.attn_conv, .base = if (boundary) 0 else b.x, .resid = b.resid, .round_in = 1, .c = @intCast(h), .rows = @intCast(n), .mode = 1 });
+            try ops.conv(k, s, .{ .x = ao.x, .parts = ao.parts, .part_stride = ao.stride, .state = cv[2], .w = l.attn_conv, .base = if (boundary) 0 else b.x, .resid = b.resid, .round_in = 1, .c = @intCast(h), .rows = @intCast(n), .mode = 1 });
             var mm: ops.MixArgs = .{ .partial = b.resid, .query = l.mlp_query, .out = b.normed, .n_blocks = @intCast(nb), .partial_bf16 = 0, .nq = 1, .rows = @intCast(n), .c = @intCast(h), .eps = c.eps };
             for (0..nb) |j| mm.blocks[j] = b.blocks + j * n * h * 2;
             mm.norm[0] = l.mlp_norm;
             try ops.mix(k, s, mm);
             try ops.rowdot(k, s, b.normed, l.router, b.scores, n, c.experts, h, false, true);
             try ops.topk(k, s, b.scores, l.bias, b.pick, b.wts, n, c.experts, c.topk, c.route_scale);
-            try experts.run(&f.m.experts, k, s, l.experts, .{ .gate = c.gate_softcap, .up = c.up_softcap }, b.normed, h, .bf16, b.pick, b.wts, n, b.moe, b.exs);
-            try ops.conv(k, s, .{ .x = b.moe, .state = cv[3], .w = l.mlp_conv, .resid = b.resid, .out = b.x, .round_in = 1, .c = @intCast(h), .rows = @intCast(n), .mode = 2 });
+            try experts.run(&f.m.experts, k, s, l.experts, .{ .gate = c.gate_softcap, .up = c.up_softcap }, b.normed, h, .bf16, b.pick, b.wts, n, f.slot(b.moe, n), b.exs);
+            const mo = try f.summed(b.moe, n);
+            try ops.conv(k, s, .{ .x = mo.x, .parts = mo.parts, .part_stride = mo.stride, .state = cv[3], .w = l.mlp_conv, .resid = b.resid, .out = b.x, .round_in = 1, .c = @intCast(h), .rows = @intCast(n), .mode = 2 });
         }
         var fm: ops.MixArgs = .{ .partial = b.x, .query = f.w.out_query, .out = b.normed, .n_blocks = @intCast(nb), .partial_bf16 = 1, .nq = 1, .rows = @intCast(n), .c = @intCast(h), .eps = c.eps };
         for (0..nb) |j| fm.blocks[j] = b.blocks + j * n * h * 2;
