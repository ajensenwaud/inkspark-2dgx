From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ajensenwaud <ajensenwaud@users.noreply.github.com>
Date: Sat, 14 Nov 2026 03:16:06 +1100
Subject: [PATCH 07/45] inkling2: two-rank partial sums in the forward and the
 dump tool

After o_proj and after the experts each rank holds a partial of the
residual update. At two ranks the forward gathers them over NCCL and the
residual conv kernel adds them in rank order before its taps, so both
ranks see the same sum; at one rank the conv reads its buffer as before
(one-GPU logits byte-identical to the previous build). tf-inkling2-cuda
opens the communicator from TF_INKLING2_RANK, TF_INKLING2_WORLD and
NCCL_COMM_ID and writes each rank's vocabulary rows.
---
 zig/kernels/cuda/inkling2/ops.cu        |  6 ++--
 zig/src/families/inkling2/dump_main.zig | 30 +++++++++++++----
 zig/src/families/inkling2/forward.zig   | 44 ++++++++++++++++++++++---
 zig/src/families/inkling2/ops.zig       |  4 ++-
 4 files changed, 71 insertions(+), 13 deletions(-)

diff --git a/zig/kernels/cuda/inkling2/ops.cu b/zig/kernels/cuda/inkling2/ops.cu
index bbb1379..eac0d87 100644
--- a/zig/kernels/cuda/inkling2/ops.cu
+++ b/zig/kernels/cuda/inkling2/ops.cu
@@ -246,14 +246,15 @@ extern "C" __global__ void tf_ink2_gateup(const GateUpArgs a) {
 
 // Short causal conv over a stream's rows (4 taps, last 3 inputs in `state`): static [C][4] or dynamic [4][C] + dyn.
 struct ConvArgs {
-    const void* x;          // [rows, C]: fp32, or bf16 when x_bf16
+    const void* x;          // [rows, C]: fp32 (`parts` rank partials, part_stride apart, added in rank order) or bf16
     float* state;           // fp32 [3, C], oldest first
     const uint16_t* w;      // bf16 taps
     const float* dyn;       // fp32 [rows, heads * 4] or null
     const uint16_t* base;   // bf16 [rows, C] (mode 1, null: zero)
     float* resid;           // fp32 [rows, C] (modes 1 and 2)
     uint16_t* out;          // bf16 [rows, C] (modes 0 and 2)
-    int x_bf16, round_in, heads, C, rows, mode;  // mode 0: out = y; 1: resid = base + bf16(y); 2: out = resid + bf16(y)
+    long long part_stride;
+    int parts, x_bf16, round_in, heads, C, rows, mode;  // mode 0: out = y; 1: resid = base + bf16(y); 2: resid + bf16(y)
 };
 
 extern "C" __global__ void __launch_bounds__(128) tf_ink2_conv(const ConvArgs a) {
@@ -265,6 +266,7 @@ extern "C" __global__ void __launch_bounds__(128) tf_ink2_conv(const ConvArgs a)
     for (int t = 0; t < a.rows; ++t) {
         const size_t at = static_cast<size_t>(t) * C + c;
         float x = a.x_bf16 ? bf(static_cast<const uint16_t*>(a.x)[at]) : static_cast<const float*>(a.x)[at];
+        for (int r = 1; r < a.parts; ++r) x += static_cast<const float*>(a.x)[at + r * a.part_stride];
         if (a.round_in) x = bfr(x);
         float y;
         if (a.dyn) {
