From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ajensenwaud <ajensenwaud@users.noreply.github.com>
Date: Sat, 14 Nov 2026 09:49:54 +1100
Subject: [PATCH 09/45] template: Jinja's float filter, which Inkling 2's chat
 template reads its effort with

---
 zig/src/core/template/filters.zig         | 13 ++++++++++++-
 zig/src/core/template/provenance_test.zig |  2 +-
 zig/src/core/template/tests.zig           |  4 ++++
 3 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/zig/src/core/template/filters.zig b/zig/src/core/template/filters.zig
index 00e4986..6093fb3 100644
--- a/zig/src/core/template/filters.zig
+++ b/zig/src/core/template/filters.zig
@@ -12,7 +12,7 @@ const Kw = methods.Kw;
 const Ctx = eval.Ctx;
 const bind = methods.bind;
 
-pub const implemented = [_][]const u8{ "default", "d", "length", "count", "string", "trim", "upper", "lower", "capitalize", "safe", "tojson", "fromjson", "items", "dictsort", "join", "list", "map", "first", "last", "unique", "reverse", "sort", "select", "reject", "selectattr", "rejectattr", "indent", "replace", "escape", "e" };
+pub const implemented = [_][]const u8{ "default", "d", "length", "count", "string", "float", "trim", "upper", "lower", "capitalize", "safe", "tojson", "fromjson", "items", "dictsort", "join", "list", "map", "first", "last", "unique", "reverse", "sort", "select", "reject", "selectattr", "rejectattr", "indent", "replace", "escape", "e" };
 const jinja_filters = [_][]const u8{ "abs", "attr", "batch", "capitalize", "center", "count", "d", "default", "dictsort", "e", "escape", "filesizeformat", "first", "float", "forceescape", "format", "groupby", "indent", "int", "items", "join", "last", "length", "list", "lower", "map", "max", "min", "pprint", "random", "reject", "rejectattr", "replace", "reverse", "round", "safe", "select", "selectattr", "slice", "sort", "string", "striptags", "sum", "title", "tojson", "trim", "truncate", "unique", "upper", "urlencode", "urlize", "wordcount", "wordwrap", "xmlattr" };
 pub const tests = [_][]const u8{ "odd", "even", "divisibleby", "defined", "undefined", "filter", "test", "none", "boolean", "false", "true", "integer", "float", "string", "mapping", "number", "sequence", "iterable", "callable", "sameas", "escaped", "in", "==", "eq", "equalto", "!=", "ne", ">", "gt", "greaterthan", ">=", "ge", "<", "lt", "lessthan", "<=", "le" };
 const jinja_tests = tests ++ [_][]const u8{ "lower", "upper" };
@@ -170,6 +170,17 @@ pub fn filter(c: *Ctx, name: []const u8, value: Value, pos: []const Value, kw: [
         return .{ .int = @intCast(v.len(value) orelse return rt.fail("object of type '{s}' has no len()", .{v.typeName(value)})) };
     }
     if (eq(u8, name, "string")) return .{ .str = try softStr(c, value) };
+    if (eq(u8, name, "float")) { // Jinja's float(value, default=0.0); Inkling 2's template reads its effort with it
+        const b = try bind(rt, "float", &.{"default"}, 0, pos, kw);
+        const fallback = b[0] orelse Value{ .float = 0.0 };
+        return switch (value) {
+            .float => value,
+            .int => |i| .{ .float = @floatFromInt(i) },
+            .boolean => |x| .{ .float = if (x) 1.0 else 0.0 },
+            .str => |s| if (std.fmt.parseFloat(f64, std.mem.trim(u8, s.s, " \t\n\r"))) |f| .{ .float = f } else |_| fallback,
+            else => fallback,
+        };
+    }
     if (eq(u8, name, "trim")) {
         const b = try bind(rt, "trim", &.{"chars"}, 0, pos, kw);
         return methods.strip(rt, try softStr(c, value), b[0]);
diff --git a/zig/src/core/template/provenance_test.zig b/zig/src/core/template/provenance_test.zig
index 72a7187..7be48df 100644
--- a/zig/src/core/template/provenance_test.zig
+++ b/zig/src/core/template/provenance_test.zig
@@ -144,7 +144,7 @@ test "provenance property covers every implemented filter" {
         if (std.mem.eql(u8, name, "replace")) args = &.{ v.Value.literal("SPECIAL"), req };
         try checkValue(&c.rt, try filters.filter(&c, name, input, args, &.{}));
     }
-    try t.expectEqual(@as(usize, 30), filters.implemented.len);
+    try t.expectEqual(@as(usize, 31), filters.implemented.len);
 }
 
 const str_supported = [_][]const u8{ "capitalize", "count", "endswith", "find", "index", "join", "lower", "lstrip", "removeprefix", "removesuffix", "replace", "rfind", "rindex", "rsplit", "rstrip", "split", "startswith", "strip", "upper" };
diff --git a/zig/src/core/template/tests.zig b/zig/src/core/template/tests.zig
index baf27a2..d98dcd9 100644
--- a/zig/src/core/template/tests.zig
+++ b/zig/src/core/template/tests.zig
@@ -137,6 +137,10 @@ test "fromjson reads a string's JSON into values a template walks" {
     try expect("{% for k, x in '{\"city\": \"Paris\", \"days\": 3}' | fromjson | items %}{{ k }}={{ x }};{% endfor %}", "{}", .{ .text = "city=Paris;days=3;", .raised = null });
 }
 
+test "float reads numbers and number strings, else its default (Jinja's float filter)" {
+    try expect("{{ '0.7' | float }} {{ 3 | float }} {{ 0.9 | float }} {{ 'x' | float }} {{ 'x' | float(1.5) }}", "{}", .{ .text = "0.7 3.0 0.9 0.0 1.5", .raised = null });
+}
+
 test "dynamic keyword mappings feed dict constructors and scoped macros" {
     try expect("{{ dict({'a': 1}, b=2, **{'c': 3}) | tojson }}", "{}", .{ .text = "{\"a\": 1, \"b\": 2, \"c\": 3}", .raised = null });
     try expect("{{ dict({'a': 1}, **{'a': 2}) | tojson }}", "{}", .{ .text = "{\"a\": 2}", .raised = null });
