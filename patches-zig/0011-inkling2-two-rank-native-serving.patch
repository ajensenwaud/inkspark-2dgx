+++ b/zig/src/families/inkling2/engine.zig
@@ -0,0 +1,340 @@
+//! One TP rank's Inkling 2 engine: streams by slot, prompt chunks, decode windows (shared, graphed) and their draws.
+const std = @import("std");
+const cuda = @import("cuda");
+const cfg = @import("config.zig");
+const shard = @import("shard.zig");
+const weights = @import("weights.zig");
+const fw = @import("forward.zig");
+const ops = @import("ops.zig");
+const sampler = @import("sampler.zig");
+const kept = @import("kept.zig");
+
+/// Rows a prompt chunk holds (the prompt cache's mark grid) and a stream's window at most.
+pub const prompt_rows = 2048;
+pub const window_rows = 8;
+/// A shared decode forward's rows and streams at most.
+pub const shared_rows = 64;
+pub const max_shared = 16;
+/// Partial slots a prompt call writes at most: 2,048 rows over 8 global chunks (deeper calls take fewer rows).
+const prompt_parts = 8;
+
+/// Rank 0's own word on its request (cancelled or not); the other ranks have none and hear rank 0's.
+pub const Cancel = struct { ptr: ?*anyopaque, check: *const fn (?*anyopaque) bool };
+
+/// One stream's window in a shared forward: its slot, its ids (pending token, then drafts), its draws.
+pub const Part = struct { slot: u32, ids: []const u32, out: []u32 };
+
+/// A slot's request state: sampling, and its last window (rows, ids, start) for a keep shorter than the window.
+const Seq = struct {
+    sampling: ?sampler.Sampling = null,
+    rows: usize = 0, // rows of the last window still uncommitted
+    at: usize = 0, // where that window started
+    ids: [window_rows]i32 = undefined,
+};
+
+pub const Options = struct { capacity: usize };
+
+/// A graph's key: a decode call's rows, streams, attention tiles and partial stride (its global chunks).
+const Key = struct { n: u32, ni: u32, nt: u32, stride: u32 };
+
+pub const Engine = struct {
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    d: *const cuda.Driver,
+    c: cfg.Config,
+    m: fw.Modules,
+    stream: cuda.Stream,
+    w: weights.Weights,
+    shape_p: fw.Shape,
+    shape_d: fw.Shape,
+    bp: fw.Buffers,
+    bd: fw.Buffers,
+    parts: std.ArrayList(cuda.DeviceBuffer) = .empty, // the partials bp and bd share (one stream runs both in order)
+    st: ?fw.State = null, // every slot's caches, made by reserve
+    backup: ?cuda.DeviceBuffer = null, // each slot's conv states before a window of several rows
+    seqs: []Seq = &.{},
+    slot: u32 = 0,
+    capacity: usize,
+    exchange: fw.Exchange = .local,
+    picks: cuda.DeviceBuffer, // every rank's (value, id) of each row's greedy pick: fp32 then i32, [world][rows]
+    picks_host: []u8,
+    smp: sampler.Sampler,
+    spans: []shard.Span, // every rank's vocabulary span
+    graphs: cuda.graph_cache.Cache(Key),
+    gengine: cuda.graph_cache.CudaEngine,
+    states: kept.Store,
+    checkpoint_digest: [32]u8 = @splat(0),
+
+    pub fn init(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, dir: []const u8, rank: usize, world: usize, o: Options) !*Engine {
+        const e = try gpa.create(Engine);
+        errdefer gpa.destroy(e);
+        const c = try cfg.Config.read(gpa, io, dir);
+        var stream = try cuda.Stream.init(d, false);
+        errdefer stream.deinit();
+        var m = try fw.Modules.load(d);
+        errdefer m.deinit();
+        e.* = .{ .gpa = gpa, .io = io, .d = d, .c = c, .m = m, .stream = stream, .w = undefined, .shape_p = undefined, .shape_d = undefined, .bp = undefined, .bd = undefined, .capacity = o.capacity, .picks = undefined, .picks_host = &.{}, .smp = undefined, .spans = &.{}, .graphs = undefined, .gengine = .{ .d = d }, .states = .{ .gpa = gpa } };
+        e.w = try weights.load(gpa, io, d, &e.m.dense, stream, dir, c, rank, world);
+        errdefer e.w.deinit();
+        const heads = e.w.share.heads.len();
+        const kv = e.w.share.kv.len();
+        e.shape_p = .{ .rows = prompt_rows, .context = o.capacity, .heads = heads, .kv = kv };
+        e.shape_d = .{ .rows = shared_rows, .context = o.capacity, .heads = heads, .kv = kv, .ring_rows = prompt_rows };
+        errdefer for (e.parts.items) |*b| b.free();
+        const slots = @max(prompt_rows * heads * prompt_parts, shared_rows * heads * fw.stride(&e.c, o.capacity - 1));
+        const shared = try fw.partialsFor(d, &e.parts, gpa, slots);
+        e.bp = try fw.Buffers.init(gpa, d, &e.w, e.shape_p, shared);
+        errdefer e.bp.deinit();
+        e.bd = try fw.Buffers.init(gpa, d, &e.w, e.shape_d, shared);
+        errdefer e.bd.deinit();
+        for (e.w.layers) |l| for ([_]cuda.exl3.Weight{ l.attn.q, l.attn.k, l.attn.v, l.attn.r, l.attn.gate, l.attn.o }) |x| try e.m.dense.reserve(stream, x);
+        try e.m.dense.reserve(stream, e.w.head); // scratch grown now, so nothing allocates inside a graph capture
+        e.picks = try cuda.DeviceBuffer.alloc(d, world * shared_rows * 8);
+        errdefer e.picks.free();
+        e.picks_host = try gpa.alloc(u8, world * shared_rows * 8);
+        errdefer gpa.free(e.picks_host);
+        e.smp = try sampler.Sampler.init(d, e.w.padded_vocab, shared_rows);
+        errdefer e.smp.deinit();
+        e.spans = try gpa.alloc(shard.Span, world);
+        for (e.spans, 0..) |*sp, q| sp.* = (try shard.Share.of(&e.c, e.w.padded_vocab, q, world)).vocab;
+        e.graphs = .init(gpa, e.gengine.engine(), .{});
+        e.graphs.name = "inkling2 decode";
+        try e.stream.synchronize();
+        return e;
+    }
+
+    pub fn deinit(e: *Engine) void {
+        e.stream.synchronize() catch {};
+        e.graphs.deinit();
+        e.states.deinit();
+        if (e.st) |*s| s.deinit();
+        if (e.backup) |*b| b.free();
+        e.gpa.free(e.seqs);
+        e.gpa.free(e.spans);
+        e.smp.deinit();
+        e.gpa.free(e.picks_host);
+        e.picks.free();
+        e.bd.deinit();
+        e.bp.deinit();
+        for (e.parts.items) |*b| b.free();
+        e.parts.deinit(e.gpa);
+        e.w.deinit();
+        e.m.deinit();
+        e.stream.deinit();
+        const gpa = e.gpa;
+        gpa.destroy(e);
+    }
+
+    /// Bytes one more stream takes on this rank: its slot's rings and conv states, and their backup.
+    pub fn seqBytes(e: *const Engine) u64 {
+        return fw.slotBytes(&e.c, e.shape_d) + e.convBytes();
+    }
+
+    fn convBytes(e: *const Engine) usize {
+        return @as(usize, e.c.layers) * 2 * 3 * (e.shape_d.kv * e.c.head_dim + e.c.hidden) * 4;
+    }
+
+    /// Every slot's caches for `slots` streams, made once (the host's admission decides how many).
+    pub fn reserve(e: *Engine, slots: usize) !void {
+        if (e.st != null) return if (e.seqs.len == slots) {} else error.Inkling2Reserved;
+        e.st = try fw.State.init(e.gpa, e.d, &e.c, e.shape_d, slots);
+        errdefer {
+            e.st.?.deinit();
+            e.st = null;
+        }
+        e.backup = try cuda.DeviceBuffer.alloc(e.d, slots * e.convBytes());
+        errdefer e.backup.?.free();
+        e.seqs = try e.gpa.alloc(Seq, slots);
+        @memset(e.seqs, .{});
+    }
+
+    pub fn slotCount(e: *const Engine) usize {
+        return e.seqs.len;
+    }
+
+    pub fn bind(e: *Engine, slot: u32) !void {
+        if (slot >= e.seqs.len) return error.Inkling2NoSlot;
+        e.slot = slot;
+    }
+
+    /// The bound slot's committed length: the pending token sits there, a window's row r draws position pos + 1 + r.
+    pub fn pos(e: *const Engine) usize {
+        return e.st.?.pos[e.slot];
+    }
+
+    /// A new request on the bound slot with `sampling` (null or temperature 0: greedy).
+    pub fn begin(e: *Engine, s: ?sampler.Sampling) void {
+        e.seqs[e.slot] = .{ .sampling = sampler.check(s) };
+    }
+
+    fn forward(e: *Engine, b: *fw.Buffers, shape: fw.Shape) fw.Forward {
+        return .{ .d = e.d, .m = &e.m, .w = &e.w, .b = b, .shape = shape, .stream = e.stream, .exchange = e.exchange };
+    }
+
+    /// One chunk of the bound slot's prompt from `start` (0: a fresh pass); the first token once it ends the prompt.
+    pub fn prefillChunk(e: *Engine, ids: []const u32, start: usize) !?u32 {
+        const st = &e.st.?;
+        if (ids.len == 0 or ids.len + window_rows >= e.capacity) return error.PromptTooLong;
+        if (start >= ids.len or start % prompt_rows != 0) return error.BadChunk;
+        if (start == 0) try st.clearSlot(&e.c, e.d, e.slot, e.stream) else if (start != st.pos[e.slot]) return error.BadChunk;
+        e.states.overwrite(e.slot, start); // states on this slot past `start` lose their rows to this pass
+        const end = @min(ids.len, start + prompt_rows);
+        const f = e.forward(&e.bp, e.shape_p);
+        // a deep call writes partials for every global chunk: fewer rows a call, the same bits a row
+        const most = @max(1, e.bp.parts.slots / (e.shape_p.heads * fw.stride(&e.c, end - 1)));
+        var at = start;
+        var n: usize = 0;
+        while (at < end) : (at += n) {
+            n = @min(end - at, most);
+            const item = [_]fw.Item{.{ .slot = e.slot, .ids = @ptrCast(ids[at..][0..n]) }};
+            try f.run(st, &item);
+        }
+        if (end < ids.len) return null;
+        var t: [1]u32 = undefined;
+        try e.draw(&e.bp, n - 1, 1, ids.len, e.seqs[e.slot].sampling, &t);
+        return t[0];
+    }
+
+    /// Several streams' windows in one forward (each on its own slot), graphed when no window holds several rows.
+    pub fn verifyShared(e: *Engine, parts: []const Part) !void {
+        const st = &e.st.?;
+        if (parts.len == 0 or parts.len > max_shared) return error.WindowTooWide;
+        var items: [max_shared]fw.Item = undefined;
+        var ids: [shared_rows]i32 = undefined;
+        var rows: usize = 0;
+        for (parts, 0..) |p, i| {
+            if (p.ids.len == 0 or p.ids.len > window_rows or rows + p.ids.len > shared_rows) return error.WindowTooWide;
+            for (parts[0..i]) |q| if (q.slot == p.slot) return error.SlotTwice;
+            if (p.slot >= e.seqs.len) return error.Inkling2NoSlot;
+            if (st.pos[p.slot] + p.ids.len + 1 > e.capacity) return error.ContextFull;
+            for (p.ids, 0..) |t, r| ids[rows + r] = @intCast(t);
+            items[i] = .{ .slot = p.slot, .ids = ids[rows..][0..p.ids.len] };
+            const q = &e.seqs[p.slot];
+            q.rows = p.ids.len;
+            q.at = st.pos[p.slot];
+            @memcpy(q.ids[0..p.ids.len], ids[rows..][0..p.ids.len]);
+            if (p.ids.len > 1) try e.convCopy(p.slot, true);
+            rows += p.ids.len;
+        }
+        const f = e.forward(&e.bd, e.shape_d);
+        const plan = try f.stage(st, items[0..parts.len]);
+        const Body = struct {
+            f: fw.Forward,
+            st: *const fw.State,
+            p: fw.Plan,
+            fn run(ctx: *anyopaque, _: cuda.Stream) anyerror!void {
+                const b: *@This() = @ptrCast(@alignCast(ctx));
+                try b.f.launch(b.st, b.p);
+            }
+        };
+        var body: Body = .{ .f = f, .st = st, .p = plan };
+        const key: Key = .{ .n = @intCast(plan.n), .ni = @intCast(plan.ni), .nt = @intCast(plan.nt), .stride = plan.stride };
+        const print = cuda.graph_cache.fingerprintOf(&.{ st.kc[0], e.bd.ids.ptr, e.bd.parts.o });
+        _ = try e.graphs.run(key, e.stream, print, .{ .ctx = &body, .run = Body.run });
+        fw.Forward.advance(st, items[0..parts.len]);
+        var row: usize = 0;
+        for (parts) |p| {
+            e.slot = p.slot;
+            try e.draw(&e.bd, row, p.ids.len, st.pos[p.slot] - p.ids.len + 1, e.seqs[p.slot].sampling, p.out[0..p.ids.len]);
+            row += p.ids.len;
+        }
+    }
+
+    /// The bound slot's last window keeps its first `n` rows: past them its conv states and length go back.
+    pub fn keep(e: *Engine, n: usize) !void {
+        const st = &e.st.?;
+        const q = &e.seqs[e.slot];
+        if (n == 0 or n > q.rows) return error.BadKeep;
+        if (n < q.rows) {
+            // the window's conv states ran over every row: restore them and run the kept rows again (same bits)
+            try e.convCopy(e.slot, false);
+            st.pos[e.slot] = q.at;
+            const item = [_]fw.Item{.{ .slot = e.slot, .ids = q.ids[0..n] }};
+            try e.forward(&e.bd, e.shape_d).run(st, &item);
+        }
+        q.rows = 0;
+    }
+
+    /// The slot's conv states to (out) or from its backup.
+    fn convCopy(e: *Engine, slot: usize, out: bool) !void {
+        const st = &e.st.?;
+        var off: usize = slot * e.convBytes();
+        for (st.conv) |cv| for (cv, 0..) |base, j| {
+            const n = 3 * (if (j < 2) st.kv * e.c.head_dim else @as(usize, e.c.hidden)) * 4;
+            const src = base + slot * n;
+            try e.copy(if (out) e.backup.?.ptr + off else src, if (out) src else e.backup.?.ptr + off, n);
+            off += n;
+        };
+    }
+
+    fn copy(e: *const Engine, dst: u64, src: u64, bytes: usize) !void {
+        try e.d.check(e.d.api.cuMemcpyDtoDAsync_v2(dst, src, bytes, e.stream.handle), "cuMemcpyDtoDAsync");
+    }
+
+    /// Rows of this rank's logits (from row `row0` of `b`) to tokens at first, first + 1, ...: sampled or greedy.
+    fn draw(e: *Engine, b: *fw.Buffers, row0: usize, rows: usize, first: u64, sm: ?sampler.Sampling, out: []u32) !void {
+        const sh = e.w.share;
+        const n = sh.vocab.len();
+        const real = @min(n, @as(usize, e.c.real_vocab) -| sh.vocab.lo);
+        const logits = b.logits.ptr + row0 * n * 4;
+        if (sm) |s| {
+            try ops.tobf(&e.m.ops, e.stream, logits, rows, n, real, e.smp.full.ptr, e.smp.vocab, sh.vocab.lo, n);
+            try e.smp.draw(e.stream, e.exchange, e.spans, rows, first, sampler.rule(s), out);
+            return e.gathered();
+        }
+        const vals = e.picks.ptr + sh.rank * rows * 8;
+        try ops.top1(&e.m.ops, e.stream, logits, rows, n, real, sh.vocab.lo, vals, vals + rows * 4);
+        switch (e.exchange) {
+            .local => {},
+            .nccl => |x| if (x.group) |g| try g.allGather(e.stream, vals, e.picks.ptr, rows * 8) else try x.lib.check(x.lib.api.ncclAllGather(vals, e.picks.ptr, rows * 8, .u8, x.comm, e.stream.handle), "ncclAllGather"),
+        }
+        try e.stream.synchronize();
+        try e.gathered();
+        const bytes = e.picks_host[0 .. sh.world * rows * 8];
+        try e.picks.download(0, bytes);
+        for (0..rows) |r| {
+            var best: f32 = -std.math.inf(f32);
+            var id: u32 = 0;
+            for (0..sh.world) |q| {
+                const at = q * rows * 8;
+                const v: f32 = @bitCast(std.mem.readInt(u32, bytes[at + r * 4 ..][0..4], .little));
+                const i = std.mem.readInt(u32, bytes[at + rows * 4 + r * 4 ..][0..4], .little);
+                if (v > best or (v == best and i < id)) {
+                    best = v;
+                    id = i;
+                }
+            }
+            out[r] = id;
+        }
+    }
+
+    /// After a synchronize: a RoCE gather that failed since the last one (its rows hold nothing valid) is an error.
+    fn gathered(e: *const Engine) !void {
+        switch (e.exchange) {
+            .local => {},
+            .nccl => |x| if (x.group) |g| try g.check(),
+        }
+    }
+
+    /// Bytes a kept state takes on this rank: the slot's sliding rings and conv states (global rows stay in place).
+    pub fn stateBytes(e: *const Engine) u64 {
+        return kept.bytes(&e.c, &e.st.?, e.convBytes());
+    }
+
+    /// The bound slot's state at its length kept under `id` (every rank keeps the same id).
+    pub fn keepAs(e: *Engine, id: u64, at: usize) !void {
+        if (at == 0 or at != e.pos()) return error.BadKeep;
+        try e.states.save(e.d, e.stream, &e.c, &e.st.?, e.slot, id, at, e.convBytes());
+    }
+
+    /// The bound slot restored to state `id` (it must be the state's slot, still holding its rows).
+    pub fn restoreState(e: *Engine, id: u64) !void {
+        try e.states.restore(e.d, e.stream, &e.c, &e.st.?, e.slot, id);
+        e.seqs[e.slot].rows = 0;
+    }
+
+    pub fn dropState(e: *Engine, id: u64) void {
+        e.stream.synchronize() catch {};
+        e.states.drop(id);
+    }
+};
diff --git a/zig/src/families/inkling2/engine_main.zig b/zig/src/families/inkling2/engine_main.zig
new file mode 100644
index 0000000..ff6f1d9
--- /dev/null
+++ b/zig/src/families/inkling2/engine_main.zig
@@ -0,0 +1,161 @@
+//! tf-inkling2-engine: the serving engine's checks on one or two ranks (both run the same loop, no plan words).
+const std = @import("std");
+const cuda = @import("cuda");
+const ink = @import("inkling2");
+
+const usage = "usage: tf-inkling2-engine graphs|greedy <model dir> <ids.json> <out dir> [context] [new tokens]\n" ++
+    "  graphs: decode windows eager in some slots and graphed in others on the same rows; logits must match bit for bit\n" ++
+    "  greedy: each text's prompt pass then greedy decode rows, eager (writes greedy.json: name -> tokens)\n" ++
+    "  two ranks: TF_INKLING2_RANK, TF_INKLING2_WORLD and NCCL_COMM_ID on both\n";
+
+const Text = struct { name: []const u8, ids: []u32 };
+
+pub fn main(init: std.process.Init) !u8 {
+    const a = init.arena.allocator();
+    const gpa = init.gpa;
+    const io = init.io;
+    const args = try init.minimal.args.toSlice(a);
+    if (args.len < 5) {
+        std.debug.print("{s}", .{usage});
+        return 2;
+    }
+    const graphs = std.mem.eql(u8, args[1], "graphs");
+    const text = try std.Io.Dir.cwd().readFileAlloc(io, args[3], a, .limited(1 << 26));
+    var doc = try std.json.parseFromSlice(std.json.Value, a, text, .{});
+    defer doc.deinit();
+    var list: std.ArrayList(Text) = .empty;
+    var it = doc.value.object.iterator();
+    while (it.next()) |e| {
+        const v = e.value_ptr.array.items;
+        const ids = try a.alloc(u32, v.len);
+        for (v, ids) |x, *id| id.* = @intCast(x.integer);
+        try list.append(a, .{ .name = e.key_ptr.*, .ids = ids });
+    }
+    const context = if (args.len > 5) try std.fmt.parseInt(usize, args[5], 10) else 32768;
+    const new = if (args.len > 6) try std.fmt.parseInt(usize, args[6], 10) else 64;
+
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    if (try ctx.capability() != 121) return error.Inkling2RequiresSm121;
+    const place = try ink.admit.place();
+    var group: ?cuda.tp_group.Group = null;
+    defer if (group) |*g| g.close(); // after the engine (its graphs hold the comm's kernels), as the server closes
+    const e = try ink.engine.Engine.init(gpa, io, &driver, args[2], place.rank, place.world, .{ .capacity = ink.native.capacity(context) });
+    defer e.deinit();
+    if (place.world > 1) {
+        group = try cuda.tp_group.Group.open(&driver, place.rank, place.world);
+        try group.?.openRoce(gpa, io, &driver, e.stream, 4096 << 10);
+        e.exchange = .{ .nccl = .{ .lib = &group.?.lib, .comm = group.?.comm, .group = &group.? } };
+    }
+    try e.reserve(16);
+    try std.Io.Dir.cwd().createDirPath(io, args[4]);
+    var out = try std.Io.Dir.cwd().openDir(io, args[4], .{});
+    defer out.close(io);
+    const r0 = place.rank == 0;
+    if (!graphs) {
+        e.graphs.settings.on = false;
+        var json: std.ArrayList(u8) = .empty;
+        try json.appendSlice(a, "{");
+        for (list.items, 0..) |t, i| {
+            const toks = try greedy(e, a, t.ids, new);
+            try json.print(a, "{s}\"{s}\": [", .{ if (i > 0) ", " else "", t.name });
+            for (toks, 0..) |x, j| try json.print(a, "{s}{d}", .{ if (j > 0) ", " else "", x });
+            try json.appendSlice(a, "]");
+            if (r0) std.debug.print("{s}: {d} prompt tokens, {d} greedy tokens\n", .{ t.name, t.ids.len, toks.len });
+        }
+        try json.appendSlice(a, "}\n");
+        if (r0) try out.writeFile(io, .{ .sub_path = "greedy.json", .data = json.items });
+        return 0;
+    }
+    // cases: k streams of `rows` rows each, `steps` windows; a text of 16,380+ tokens also crosses a global chunk
+    const Case = struct { k: usize, rows: usize, steps: usize, at: usize };
+    var cases: std.ArrayList(Case) = .empty;
+    for ([_]usize{ 1, 2, 3, 4, 8 }) |k| try cases.append(a, .{ .k = k, .rows = 1, .steps = 6, .at = 0 });
+    try cases.append(a, .{ .k = 1, .rows = 4, .steps = 3, .at = 0 });
+    try cases.append(a, .{ .k = 2, .rows = 4, .steps = 3, .at = 0 });
+    for (list.items) |t| if (t.ids.len >= 16390) {
+        try cases.append(a, .{ .k = 1, .rows = 1, .steps = 8, .at = 16380 });
+        try cases.append(a, .{ .k = 2, .rows = 1, .steps = 8, .at = 16380 });
+        break;
+    };
+    var pass: usize = 0;
+    var total: usize = 0;
+    for (cases.items) |cs| {
+        const diff = try graphCase(e, a, list.items, cs.k, cs.rows, cs.steps, cs.at);
+        total += cs.steps;
+        pass += cs.steps - diff;
+        if (r0) std.debug.print("case {d} streams x {d} rows from {s}: {d}/{d} windows equal\n", .{ cs.k, cs.rows, if (cs.at > 0) "16380" else "prompt end", cs.steps - diff, cs.steps });
+    }
+    const st = e.graphs.stats;
+    if (r0) std.debug.print("graphs: {d}/{d} windows bit-identical; captured {d}, replayed {d}, eager {d}\n", .{ pass, total, st.captured, st.replayed, st.eager });
+    return if (pass == total) 0 else 1;
+}
+
+/// A text's prompt pass on the bound slot then `n` greedy tokens, one decode row at a time.
+fn greedy(e: *ink.engine.Engine, a: std.mem.Allocator, ids: []const u32, n: usize) ![]u32 {
+    try e.bind(0);
+    e.begin(null);
+    var at: usize = 0;
+    var tok: u32 = while (true) : (at += ink.engine.prompt_rows) {
+        if (try e.prefillChunk(ids, at)) |t| break t;
+    };
+    const toks = try a.alloc(u32, n);
+    for (toks) |*x| {
+        x.* = tok;
+        var o: [1]u32 = undefined;
+        try e.verifyShared(&.{.{ .slot = 0, .ids = &.{tok}, .out = &o }});
+        try e.keep(1);
+        tok = o[0];
+    }
+    return toks;
+}
+
+/// One case: the same streams in slots 0..k (eager) and k..2k (graphed); returns the windows whose logits differ.
+fn graphCase(e: *ink.engine.Engine, a: std.mem.Allocator, texts: []const Text, k: usize, rows: usize, steps: usize, at: usize) !usize {
+    var pend: [8]u32 = undefined;
+    var src: [8][]const u32 = undefined;
+    var long: ?[]const u32 = null;
+    for (texts) |t| if (t.ids.len >= 16390) {
+        long = t.ids;
+    };
+    for (0..k) |i| {
+        src[i] = if (at > 0) long.?[0..at] else texts[i % texts.len].ids;
+        for ([_]usize{ i, k + i }) |slot| {
+            try e.bind(@intCast(slot));
+            e.begin(null);
+            var p: usize = 0;
+            pend[i] = while (true) : (p += ink.engine.prompt_rows) {
+                if (try e.prefillChunk(src[i], p)) |t| break t;
+            };
+        }
+    }
+    const nv = e.w.share.vocab.len();
+    var diff: usize = 0;
+    for (0..steps) |step| {
+        var ids: [8][8]u32 = undefined;
+        var outs: [2][8][8]u32 = undefined;
+        var logits: [2][]u8 = undefined;
+        for (0..k) |i| {
+            ids[i][0] = pend[i];
+            for (1..rows) |r| ids[i][r] = src[i][(step * rows + r) % src[i].len]; // fixed rows after the pending one
+        }
+        for (0..2) |arm| {
+            var parts: [8]ink.engine.Part = undefined;
+            for (0..k) |i| parts[i] = .{ .slot = @intCast(arm * k + i), .ids = ids[i][0..rows], .out = outs[arm][i][0..rows] };
+            e.graphs.settings.on = arm == 1;
+            try e.verifyShared(parts[0..k]);
+            try e.stream.synchronize();
+            logits[arm] = try a.alloc(u8, k * rows * nv * 4);
+            try e.bd.logits.download(0, logits[arm]);
+            for (0..k) |i| {
+                try e.bind(@intCast(arm * k + i));
+                try e.keep(rows);
+            }
+        }
+        if (!std.mem.eql(u8, logits[0], logits[1])) diff += 1;
+        for (0..k) |i| pend[i] = outs[0][i][rows - 1];
+    }
+    return diff;
+}
