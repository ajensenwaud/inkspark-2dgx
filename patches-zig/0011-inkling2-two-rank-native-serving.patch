--- a/zig/kernels/cuda/inkling2/ops.cu
+++ b/zig/kernels/cuda/inkling2/ops.cu
@@ -307,3 +307,76 @@ extern "C" __global__ void tf_ink2_softcap(float* __restrict__ x, long long n, f
     const long long i = static_cast<long long>(blockIdx.x) * blockDim.x + threadIdx.x;
