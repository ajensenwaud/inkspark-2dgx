@@ -0,0 +1,291 @@
+//! Inkling 2's bundled DSpark drafter (mtp.safetensors, bf16 as released): its config and this rank's share.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const cfg = @import("config.zig");
+const weights = @import("weights.zig");
+
+/// The drafter's file beside the pack's shards (the release ships it at the checkpoint's top level).
+pub const file = "mtp.safetensors";
+/// Target taps: seven layers' inputs, then the head's input.
+pub const taps_n = 8;
+/// Rows a block runs: the anchor, then masks; row j drafts the token at the anchor's position + j.
+pub const block = 8;
+pub const max_layers = 8;
+
+pub const Config = struct {
+    layers: u32 = 5,
+    heads: u32 = 48,
+    kv_heads: u32 = 8,
+    inter: u32 = 18432,
+    window: u32 = 1024,
+    rank: u32 = 256,
+    theta: f32 = 1e6,
+    eps: f32 = 1e-6,
+    local: [max_layers]bool = @splat(false),
+    taps: [taps_n]u32 = .{ 5, 11, 17, 23, 29, 35, 41, 48 },
+
+    /// config.json's mtp_config, checked against the target; null when the checkpoint has none.
+    pub fn read(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, t: *const cfg.Config) !?Config {
+        const path = try std.fs.path.join(gpa, &.{ dir, "config.json" });
+        defer gpa.free(path);
+        const bytes = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 22));
+        defer gpa.free(bytes);
+        var doc = try std.json.parseFromSlice(std.json.Value, gpa, bytes, .{});
+        defer doc.deinit();
+        const m = (doc.value.object.get("mtp_config") orelse return null).object;
+        const int = struct {
+            fn of(o: std.json.ObjectMap, k: []const u8) !u32 {
+                const x = o.get(k) orelse return error.BadInkling2Drafter;
+                return if (x == .integer and x.integer >= 0) @intCast(x.integer) else error.BadInkling2Drafter;
+            }
+        }.of;
+        var c: Config = .{};
+        c.layers = try int(m, "num_hidden_layers");
+        c.heads = try int(m, "num_attention_heads");
+        c.kv_heads = try int(m, "num_key_value_heads");
+        c.inter = try int(m, "intermediate_size");
+        c.window = try int(m, "sliding_window_size");
+        c.rank = try int(m, "markov_rank");
+        if (m.get("rope_theta")) |x| c.theta = @floatCast(if (x == .float) x.float else @as(f64, @floatFromInt(x.integer)));
+        if (m.get("rms_norm_eps")) |x| c.eps = @floatCast(x.float);
+        const kind = m.get("markov_head_type") orelse return error.BadInkling2Drafter;
+        if (kind != .string or !std.mem.eql(u8, kind.string, "rnn_hidden")) return error.UnsupportedInkling2Drafter;
+        if (try int(m, "hidden_size") != t.hidden or try int(m, "head_dim") != 128 or try int(m, "block_size") != block)
+            return error.UnsupportedInkling2Drafter;
+        if (c.layers == 0 or c.layers > max_layers or c.rank != 256 or c.heads != t.heads or c.kv_heads != t.kv_heads)
+            return error.UnsupportedInkling2Drafter;
+        const ll = m.get("local_layer_ids") orelse return error.BadInkling2Drafter;
+        for (ll.array.items) |x| {
+            if (x != .integer or x.integer < 0 or x.integer >= c.layers) return error.BadInkling2Drafter;
+            c.local[@intCast(x.integer)] = true;
+        }
+        const ids = m.get("target_layer_ids") orelse return error.BadInkling2Drafter;
+        if (ids.array.items.len != taps_n) return error.UnsupportedInkling2Drafter;
+        for (ids.array.items, &c.taps) |x, *v| v.* = if (x == .integer and x.integer >= 0) @intCast(x.integer) else return error.BadInkling2Drafter;
+        return c;
+    }
+
+    /// The target layer whose input each of the first seven taps reads; `layers` (past the last) on a truncated pack.
+    pub fn tapLayers(c: *const Config, layers: u32) [taps_n - 1]u32 {
+        var out: [taps_n - 1]u32 = undefined;
+        for (&out, c.taps[0 .. taps_n - 1]) |*o, t| o.* = @min(t, layers);
+        return out;
+    }
+};
+
+/// A draft layer on this rank: q | k | v of its heads, the context's k | v, o by columns, gate | up rows, down columns.
+pub const Layer = struct {
+    in_norm: u64,
+    post_norm: u64,
+    dflare: u64,
+    q_norm: u64,
+    k_norm: u64,
+    k_norm_ctx: u64,
+    qkv: cuda.qmmf.Weight,
+    kv: cuda.qmmf.Weight,
+    o: cuda.qmmf.Weight,
+    gu: cuda.qmmf.Weight,
+    down: cuda.qmmf.Weight,
+};
+
+pub const Weights = struct {
+    c: Config,
+    layers: [max_layers]Layer = undefined,
+    norm: u64 = 0,
+    mask: u64 = 0, // bf16 [hidden]
+    alpha: u64 = 0, // fp32 [layers + 1][taps_n]: softmax(fuse_weight) a row
+    m_norm: u64 = 0, // the Markov head's dflare_norm
+    w1: u64 = 0, // bf16 [vocab][rank], whole
+    rnn: u64 = 0, // bf16 [3 rank][2 rank + 2 hidden], whole
+    rnn_bias: u64 = 0,
+    hidden_out: []u16 = &.{}, // host bf16 [hidden][rank]: folded into the head at load (Drafter.init)
+    hidden_bias: []u16 = &.{},
+    bufs: std.ArrayList(cuda.DeviceBuffer) = .empty,
+    bytes: u64 = 0,
+
+    pub fn deinit(w: *Weights, gpa: std.mem.Allocator) void {
+        for (w.bufs.items) |*b| b.free();
+        w.bufs.deinit(gpa);
+        gpa.free(w.hidden_out);
+        gpa.free(w.hidden_bias);
+    }
+
+    fn put(w: *Weights, gpa: std.mem.Allocator, d: *const cuda.Driver, bytes: []const u8) !u64 {
+        var b = try cuda.DeviceBuffer.fromHost(d, bytes);
+        errdefer b.free();
+        try w.bufs.append(gpa, b);
+        w.bytes += b.len;
+        return b.ptr;
+    }
+};
+
+/// Whether the pack holds a drafter (its file beside the shards).
+pub fn present(io: std.Io, gpa: std.mem.Allocator, dir: []const u8) bool {
+    const path = std.fs.path.join(gpa, &.{ dir, file }) catch return false;
+    defer gpa.free(path);
+    _ = std.Io.Dir.cwd().statFile(io, path, .{}) catch return false;
+    return true;
+}
+
+/// Bytes this rank's drafter weights take (split layers, the Markov head whole, the folded head's share).
+pub fn rankBytes(c: *const Config, t: *const cfg.Config, world: usize, vocab: usize) u64 {
+    const h: u64 = t.hidden;
+    const per: u64 = (2 * @as(u64, c.heads) * 128 * h + 4 * @as(u64, c.kv_heads) * 128 * h + 3 * @as(u64, c.inter) * h) * 2;
+    const head: u64 = (@as(u64, t.vocab) + 3 * 2 * h + 4) * c.rank * 2 + vocab / world * (c.rank + 1) * 2;
+    return c.layers * per / world + head;
+}
+
+const Loader = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    w: *Weights,
+    ck: *core.Checkpoint,
+    buf: [160]u8 = undefined,
+
+    fn get(L: *Loader, comptime fmt: []const u8, args: anytype, dims: []const usize) !core.checkpoint.Tensor {
+        const name = try std.fmt.bufPrint(&L.buf, fmt, args);
+        const t = try L.ck.get(name);
+        if (!t.is(.bf16, dims)) {
+            std.log.err("inkling2 drafter: {s} is not bf16{any}", .{ name, dims });
+            return error.UnexpectedInkling2Tensor;
+        }
+        return t;
+    }
+
+    fn raw(L: *Loader, comptime fmt: []const u8, args: anytype, dims: []const usize) !u64 {
+        return L.w.put(L.gpa, L.d, (try L.get(fmt, args, dims)).bytes);
+    }
+
+    /// Rows [lo, hi) of each part, stacked, then packed for the lane matmul.
+    fn stack(L: *Loader, parts: []const [3]usize, ts: []const core.checkpoint.Tensor, k: usize) !cuda.qmmf.Weight {
+        var n: usize = 0;
+        for (parts) |p| n += p[1] - p[0];
+        const host = try L.gpa.alloc(u16, n * k);
+        defer L.gpa.free(host);
+        var at: usize = 0;
+        for (parts) |p| {
+            const all: []const u16 = @alignCast(std.mem.bytesAsSlice(u16, ts[p[2]].bytes));
+            @memcpy(host[at * k ..][0 .. (p[1] - p[0]) * k], all[p[0] * k .. p[1] * k]);
+            at += p[1] - p[0];
+        }
+        return L.pack(host, n, k);
+    }
+
+    /// Columns [lo, hi) of every row of a [n][k] tensor, packed.
+    fn cols(L: *Loader, t: core.checkpoint.Tensor, lo: usize, hi: usize) !cuda.qmmf.Weight {
+        const n = t.dim(0);
+        const k = t.dim(1);
+        const all: []const u16 = @alignCast(std.mem.bytesAsSlice(u16, t.bytes));
+        const host = try L.gpa.alloc(u16, n * (hi - lo));
+        defer L.gpa.free(host);
+        for (0..n) |r| @memcpy(host[r * (hi - lo) ..][0 .. hi - lo], all[r * k + lo .. r * k + hi]);
+        return L.pack(host, n, hi - lo);
+    }
+
+    fn pack(L: *Loader, host: []const u16, n: usize, k: usize) !cuda.qmmf.Weight {
+        const npad = (n + 127) / 128 * 128;
+        const tiles = try L.gpa.alloc(u16, npad * k);
+        defer L.gpa.free(tiles);
+        cuda.qmmf.packBf16(tiles, host, n, k);
+        return cuda.modelopt.bf16Weight(try L.w.put(L.gpa, L.d, std.mem.sliceAsBytes(tiles)), n, k);
+    }
+};
+
+/// This rank's share of mtp.safetensors: heads with the target's key heads, the FFN by halves, the head whole.
+pub fn load(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, dir: []const u8, t: *const weights.Weights) !Weights {
+    const tc = &t.config;
+    const c = (try Config.read(gpa, io, dir, tc)) orelse return error.NoInkling2Drafter;
+    var ck: core.Checkpoint = .{ .gpa = gpa, .io = io };
+    defer ck.close();
+    try ck.add(dir, file);
+    var w: Weights = .{ .c = c };
+    errdefer w.deinit(gpa);
+    var L: Loader = .{ .gpa = gpa, .d = d, .w = &w, .ck = &ck };
+    const h: usize = tc.hidden;
+    const s = t.share;
+    const D = 128;
+    const q = [2]usize{ s.heads.lo * D, s.heads.hi * D };
+    const kv = [2]usize{ s.kv.lo * D, s.kv.hi * D };
+    if (c.inter % (128 * s.world) != 0) return error.UnsupportedInkling2Drafter;
+    const ih = c.inter / s.world;
+    const il = [2]usize{ s.rank * ih, (s.rank + 1) * ih };
+    const qd = &[_]usize{ c.heads * D, h };
+    const kd = &[_]usize{ c.kv_heads * D, h };
+    const pre = "layers.{d}.";
+    for (0..c.layers) |i| {
+        const tq = try L.get(pre ++ "self_attn.q_proj.weight", .{i}, qd);
+        const tk = try L.get(pre ++ "self_attn.k_proj.weight", .{i}, kd);
+        const tv = try L.get(pre ++ "self_attn.v_proj.weight", .{i}, kd);
+        const tkc = try L.get(pre ++ "self_attn.k_proj_ctx.weight", .{i}, kd);
+        const tvc = try L.get(pre ++ "self_attn.v_proj_ctx.weight", .{i}, kd);
+        const tg = try L.get(pre ++ "mlp.gate_proj.weight", .{i}, &.{ c.inter, h });
+        const tu = try L.get(pre ++ "mlp.up_proj.weight", .{i}, &.{ c.inter, h });
+        w.layers[i] = .{
+            .in_norm = try L.raw(pre ++ "input_layernorm.weight", .{i}, &.{h}),
+            .post_norm = try L.raw(pre ++ "post_attention_layernorm.weight", .{i}, &.{h}),
+            .dflare = try L.raw(pre ++ "dflare_norm.weight", .{i}, &.{h}),
+            .q_norm = try L.raw(pre ++ "self_attn.q_norm.weight", .{i}, &.{D}),
+            .k_norm = try L.raw(pre ++ "self_attn.k_norm.weight", .{i}, &.{D}),
+            .k_norm_ctx = try L.raw(pre ++ "self_attn.k_norm_ctx.weight", .{i}, &.{D}),
+            .qkv = try L.stack(&.{ .{ q[0], q[1], 0 }, .{ kv[0], kv[1], 1 }, .{ kv[0], kv[1], 2 } }, &.{ tq, tk, tv }, h),
+            .kv = try L.stack(&.{ .{ kv[0], kv[1], 0 }, .{ kv[0], kv[1], 1 } }, &.{ tkc, tvc }, h),
+            .o = try L.cols(try L.get(pre ++ "self_attn.o_proj.weight", .{i}, &.{ h, c.heads * D }), q[0], q[1]),
+            .gu = try L.stack(&.{ .{ il[0], il[1], 0 }, .{ il[0], il[1], 1 } }, &.{ tg, tu }, h),
+            .down = try L.cols(try L.get(pre ++ "mlp.down_proj.weight", .{i}, &.{ h, c.inter }), il[0], il[1]),
+        };
+    }
+    w.norm = try L.raw("norm.weight", .{}, &.{h});
+    w.mask = try L.raw("mask_embed", .{}, &.{h});
+    w.m_norm = try L.raw("markov_head.dflare_norm.weight", .{}, &.{h});
+    w.w1 = try L.raw("markov_head.markov_w1.weight", .{}, &.{ tc.vocab, c.rank });
+    w.rnn = try L.raw("markov_head.rnn_proj.weight", .{}, &.{ 3 * c.rank, 2 * c.rank + 2 * h });
+    w.rnn_bias = try L.raw("markov_head.rnn_proj.bias", .{}, &.{3 * c.rank});
+    const ho = try L.get("markov_head.hidden_out.weight", .{}, &.{ h, c.rank });
+    w.hidden_out = try gpa.dupe(u16, @alignCast(std.mem.bytesAsSlice(u16, ho.bytes)));
+    const hb = try L.get("markov_head.hidden_out.bias", .{}, &.{h});
+    w.hidden_bias = try gpa.dupe(u16, @alignCast(std.mem.bytesAsSlice(u16, hb.bytes)));
+    // softmax(fuse_weight) per row in fp32: each draft layer's tap mix, the last row the Markov head's
+    const fwt = try L.get("fuse_weight", .{}, &.{ c.layers + 1, taps_n });
+    const fws: []const u16 = @alignCast(std.mem.bytesAsSlice(u16, fwt.bytes));
+    var alpha: [(max_layers + 1) * taps_n]f32 = undefined;
+    for (0..c.layers + 1) |r| softmaxRow(fws[r * taps_n ..][0..taps_n], alpha[r * taps_n ..][0..taps_n]);
+    w.alpha = try w.put(gpa, d, std.mem.sliceAsBytes(alpha[0 .. (c.layers + 1) * taps_n]));
+    return w;
+}
+
+fn softmaxRow(x: []const u16, out: []f32) void {
+    var mx: f32 = -std.math.inf(f32);
+    for (x) |v| mx = @max(mx, bf(v));
+    var sum: f32 = 0;
+    for (x, out) |v, *o| {
+        o.* = @exp(bf(v) - mx);
+        sum += o.*;
+    }
+    for (out) |*o| o.* /= sum;
+}
+
+pub fn bf(v: u16) f32 {
+    return @bitCast(@as(u32, v) << 16);
+}
+
+/// fp32 to bf16, round to nearest even (finite inputs).
+pub fn tobf(f: f32) u16 {
+    const u: u32 = @bitCast(f);
+    return @intCast((u + 0x7fff + ((u >> 16) & 1)) >> 16);
+}
+
+test "dspark: release config read, taps past a truncated pack's end, fuse rows softmaxed" {
+    const t: cfg.Config = .{};
+    var c: Config = .{};
+    c.local = .{ true, true, false, true, true, false, false, false };
+    const at = c.tapLayers(6);
+    try std.testing.expectEqual(@as(u32, 5), at[0]);
+    try std.testing.expectEqual(@as(u32, 6), at[1]);
+    try std.testing.expectEqual(@as(u32, 41), c.tapLayers(48)[6]);
+    var out: [3]f32 = undefined;
+    softmaxRow(&.{ tobf(0), tobf(0), tobf(0) }, &out);
+    try std.testing.expectApproxEqAbs(@as(f32, 1.0 / 3.0), out[1], 1e-7);
+    try std.testing.expectEqual(@as(u16, 0x3f80), tobf(1.0));
+    try std.testing.expect(rankBytes(&c, &t, 2, 201088) > 1 << 30);
+}
diff --git a/zig/src/families/inkling2/dspark_ops.zig b/zig/src/families/inkling2/dspark_ops.zig
new file mode 100644
index 0000000..c9b9dfc
--- /dev/null
+++ b/zig/src/families/inkling2/dspark_ops.zig
@@ -0,0 +1,197 @@
+//! The DSpark drafter's kernels (inkling2/dspark.cu): tap mix, norms, q/k prep, block attention, the Markov head.
+const std = @import("std");
+const cuda = @import("cuda");
+
+/// Keys a block attention chunk covers (absolute positions, so a row's bits never depend on the call).
+pub const chunk = 1024;
+/// Query rows x query heads of one key head a block attention call holds at most (dspark.cu's kMaxQ).
+pub const max_q = 48;
+
+/// dspark.cu's QkArgs, field for field.
+pub const QkArgs = extern struct {
+    x: u64,
+    qw: u64,
+    kw: u64,
+    q: u64,
+    kc: u64,
+    vc: u64,
+    ld: i64,
+    hq: i32,
+    hk: i32,
+    ring: i32,
+    pos0: i32,
+    eps: f32,
+    theta: f32,
+};
+
+/// dspark.cu's AttnArgs, field for field.
+pub const AttnArgs = extern struct {
+    q: u64,
+    kc: u64,
+    vc: u64,
+    po: u64,
+    pml: u64,
+    T: i32,
+    hq: i32,
+    hk: i32,
+    ring: i32,
+    lo: i32,
+    hi: i32,
+    c0: i32,
+    scale: f32,
+};
+
+pub const Kernels = struct {
+    mod: cuda.Module,
+    mix: cuda.Function,
+    addnorm: cuda.Function,
+    qk: cuda.Function,
+    attn: cuda.Function,
+    merge: cuda.Function,
+    silu: cuda.Function,
+    ctx: cuda.Function,
+    rnn: cuda.Function,
+    vocab: cuda.Function,
+    pick: cuda.Function,
+
+    pub fn load(d: *const cuda.Driver) !Kernels {
+        if (!cuda.kernels.available) return error.BuiltWithoutKernels;
+        var mod = try cuda.Module.load(d, cuda.kernels.inkling2_dspark);
+        errdefer mod.unload();
+        return .{
+            .mod = mod,
+            .mix = try mod.function("tf_ink2_dsp_mix"),
+            .addnorm = try mod.function("tf_ink2_dsp_addnorm"),
+            .qk = try mod.function("tf_ink2_dsp_qk"),
+            .attn = try mod.function("tf_ink2_dsp_attn"),
+            .merge = try mod.function("tf_ink2_dsp_merge"),
+            .silu = try mod.function("tf_ink2_dsp_silu"),
+            .ctx = try mod.function("tf_ink2_dsp_ctx"),
+            .rnn = try mod.function("tf_ink2_dsp_rnn"),
+            .vocab = try mod.function("tf_ink2_dsp_vocab"),
+            .pick = try mod.function("tf_ink2_dsp_pick"),
+        };
+    }
+
+    pub fn unload(k: *Kernels) void {
+        k.mod.unload();
+        k.* = undefined;
+    }
+};
+
+fn int(x: anytype) i32 {
+    return @intCast(x);
+}
+
+fn go(f: cuda.Function, s: cuda.Stream, grid: cuda.Dim3, threads: u32, a: *cuda.Args) !void {
+    try cuda.launch.launch(f, .{ .grid = grid, .block = .{ .x = threads } }, s, a);
+}
+
+/// out bf16 [rows][c] = RMSNorm(alpha . taps[row]) * w; taps bf16 [rows][n][c], alpha fp32 [n].
+pub fn mix(k: *const Kernels, s: cuda.Stream, taps: u64, alpha: u64, w: u64, out: u64, rows: usize, n: usize, c: usize, eps: f32) !void {
+    var a: cuda.Args = .{};
+    for ([_]u64{ taps, alpha, w, out }) |v| a.add(v);
+    a.add(int(n));
+    a.add(int(c));
+    a.add(eps);
+    try go(k.mix, s, .{ .x = @intCast(rows) }, 512, &a);
+}
+
+/// resid += `nparts` fp32 partials (`stride` elements apart, rank order); out = RMSNorm(resid) * w, both bf16.
+pub fn addNorm(k: *const Kernels, s: cuda.Stream, resid: u64, parts: u64, nparts: usize, stride: usize, w: u64, out: u64, rows: usize, c: usize, eps: f32) !void {
+    var a: cuda.Args = .{};
+    a.add(resid);
+    a.add(parts);
+    a.add(int(nparts));
+    a.add(@as(i64, @intCast(stride)));
+    a.add(w);
+    a.add(out);
+    a.add(int(c));
+    a.add(eps);
+    try go(k.addnorm, s, .{ .x = @intCast(rows) }, 512, &a);
+}
+
+pub fn qk(k: *const Kernels, s: cuda.Stream, q: QkArgs, rows: usize) !void {
+    var a: cuda.Args = .{};
+    a.add(q);
+    try go(k.qk, s, .{ .x = @intCast(rows), .y = @intCast(q.hq + q.hk) }, 64, &a);
+}
+
+/// Chunks a block's keys [lo, hi] span.
+pub fn chunks(lo: usize, hi: usize) usize {
+    return hi / chunk - lo / chunk + 1;
+}
+
+/// Block attention over keys [a.lo, a.hi], then the chunks merged into `out` bf16 [T][hq][128].
+pub fn attend(k: *const Kernels, s: cuda.Stream, at: AttnArgs, out: u64) !void {
+    const lo: usize = @intCast(at.lo);
+    const hi: usize = @intCast(at.hi);
+    if (lo > hi or at.T * @divExact(at.hq, at.hk) > max_q) return error.Inkling2DraftShape;
+    var x = at;
+    x.c0 = int(lo / chunk);
+    const n = chunks(lo, hi);
+    var a: cuda.Args = .{};
+    a.add(x);
+    try go(k.attn, s, .{ .x = @intCast(n), .y = @intCast(at.hk) }, 256, &a);
+    var m: cuda.Args = .{};
+    m.add(at.po);
+    m.add(at.pml);
+    m.add(int(n));
+    m.add(at.T * at.hq);
+    m.add(out);
+    try go(k.merge, s, .{ .x = @intCast(at.T * at.hq) }, 128, &m);
+}
+
+pub fn silu(k: *const Kernels, s: cuda.Stream, gu: u64, out: u64, rows: usize, inter: usize) !void {
+    var a: cuda.Args = .{};
+    a.add(gu);
+    a.add(out);
+    a.add(int(inter));
+    try go(k.silu, s, .{ .x = @intCast((inter + 255) / 256), .y = @intCast(rows) }, 256, &a);
+}
+
+/// The Markov head's context rows: fp32 [rows][3r] from the hidden rows and f_rnn.
+pub fn ctx(k: *const Kernels, s: cuda.Stream, hidden: u64, frnn: u64, w: u64, bias: u64, out: u64, rows: usize, c: usize, r: usize) !void {
+    var a: cuda.Args = .{};
+    for ([_]u64{ hidden, frnn, w, bias, out }) |v| a.add(v);
+    for ([_]i32{ int(rows), int(c), int(r) }) |v| a.add(v);
+    try go(k.ctx, s, .{ .x = @intCast((3 * r + 7) / 8) }, 256, &a);
+}
+
+/// One recurrence step from walk[j]: the state in place and the step's latent.
+pub fn rnn(k: *const Kernels, s: cuda.Stream, cx: u64, w: u64, w1: u64, walk: u64, j: usize, state: u64, latent: u64, r: usize, c: usize) !void {
+    var a: cuda.Args = .{};
+    for ([_]u64{ cx, w, w1, walk }) |v| a.add(v);
+    a.add(int(j));
+    a.add(state);
+    a.add(latent);
+    a.add(int(r));
+    a.add(int(c));
+    try go(k.rnn, s, .{ .x = 1 }, @intCast(r), &a);
+}
+
+pub fn vocab(k: *const Kernels, s: cuda.Stream, base: u64, latent: u64, fold: u64, fbias: u64, cap: f32, valid: usize, nv: usize, out: u64) !void {
+    var a: cuda.Args = .{};
+    for ([_]u64{ base, latent, fold, fbias }) |v| a.add(v);
+    a.add(cap);
+    a.add(int(valid));
+    a.add(int(nv));
+    a.add(out);
+    try go(k.vocab, s, .{ .x = @intCast((nv + 7) / 8) }, 256, &a);
+}
+
+pub fn pick(k: *const Kernels, s: cuda.Stream, picks: u64, world: usize, walk: u64, j: usize) !void {
+    var a: cuda.Args = .{};
+    a.add(picks);
+    a.add(int(world));
+    a.add(walk);
+    a.add(int(j));
+    try go(k.pick, s, .{ .x = 1 }, 1, &a);
+}
+
+test "dspark ops: argument structs keep dspark.cu's layouts; chunks by absolute position" {
+    try std.testing.expectEqual(@as(usize, 6 * 8 + 8 + 4 * 4 + 2 * 4), @sizeOf(QkArgs));
+    try std.testing.expectEqual(@as(usize, 5 * 8 + 8 * 4), @sizeOf(AttnArgs));
+    try std.testing.expectEqual(@as(usize, 1), chunks(0, 1023));
+    try std.testing.expectEqual(@as(usize, 2), chunks(1000, 1030));
+}
diff --git a/zig/src/families/inkling2/dspark_run.zig b/zig/src/families/inkling2/dspark_run.zig
new file mode 100644
index 0000000..50f4a86
--- /dev/null
+++ b/zig/src/families/inkling2/dspark_run.zig
@@ -0,0 +1,276 @@
+//! The DSpark drafter at TP: target taps as each draft layer's context, then a block of 8 rows and a Markov walk.
+const std = @import("std");
+const cuda = @import("cuda");
+const fw = @import("forward.zig");
+const ops = @import("ops.zig");
+const ds = @import("dspark.zig");
+const dk = @import("dspark_ops.zig");
+
+const Buf = cuda.DeviceBuffer;
+const T = ds.block;
+
+/// A sliding draft layer's key ring: its window and a block past a prompt chunk's rows.
+pub const local_ring = 4096;
+
+/// A slot's drafter state: layer caches (rings; the global layer at capacity), stash, f_rnn, positions [from, to).
+pub const Slot = struct {
+    buf: Buf,
+    off: [ds.max_layers + 1]usize = @splat(0),
+    stash: u64 = 0,
+    frnn: u64 = 0,
+    from: usize = 0,
+    to: usize = 0,
+
+    pub fn keys(s: *const Slot, l: usize) u64 {
+        return s.buf.ptr + s.off[l];
+    }
+
+    pub fn values(s: *const Slot, l: usize) u64 {
+        return s.keys(l) + (s.off[l + 1] - s.off[l]) / 2;
+    }
+};
+
+/// Bytes a slot takes: `kv` key heads a rank, the global layer's keys at `capacity` positions.
+pub fn slotBytes(c: *const ds.Config, kv: usize, capacity: usize, hidden: usize) usize {
+    var n: usize = 0;
+    for (0..c.layers) |l| n += 2 * ring(c, l, capacity) * kv * 128 * 2;
+    return n + T * ds.taps_n * hidden * 2 + hidden * 2;
+}
+
+fn ring(c: *const ds.Config, l: usize, capacity: usize) usize {
+    return if (c.local[l]) local_ring else capacity;
+}
+
+pub fn initSlot(d: *const cuda.Driver, c: *const ds.Config, kv: usize, capacity: usize, hidden: usize) !Slot {
+    var buf = try Buf.alloc(d, slotBytes(c, kv, capacity, hidden));
+    errdefer buf.free();
+    try buf.fill8(0, null);
+    var s: Slot = .{ .buf = buf };
+    for (0..c.layers) |l| s.off[l + 1] = s.off[l] + 2 * ring(c, l, capacity) * kv * 128 * 2;
+    s.stash = buf.ptr + s.off[c.layers];
+    s.frnn = s.stash + T * ds.taps_n * hidden * 2;
+    return s;
+}
+
+pub const Drafter = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    w: ds.Weights,
+    k: dk.Kernels,
+    lane: cuda.qmmf.Lane,
+    bufs: std.ArrayList(Buf) = .empty,
+    hidden: usize,
+    hq: usize,
+    hk: usize,
+    inter: usize, // this rank's FFN columns
+    nv: usize, // this rank's vocabulary rows
+    valid: usize, // of them, real tokens
+    vlo: usize,
+    rank: usize,
+    world: usize,
+    cap: f32,
+    capacity: usize,
+    ctx_rows: usize, // rows an absorb takes at most
+    part: u64 = 0,
+    fold: u64 = 0, // bf16 [nv][rank]: the head times hidden_out
+    fbias: u64 = 0, // bf16 [nv]: the head times hidden_out's bias
+    resid: u64 = 0,
+    x: u64 = 0,
+    qkv: u64 = 0,
+    q: u64 = 0,
+    att: u64 = 0,
+    gu: u64 = 0,
+    act: u64 = 0,
+    gath: u64 = 0, // fp32 [world][T][hidden]
+    po: u64 = 0,
+    pml: u64 = 0,
+    base: u64 = 0, // bf16 [T - 1][nv]
+    mctx: u64 = 0, // fp32 [T - 1][3 rank]
+    state: u64 = 0,
+    latent: u64 = 0,
+    scores: u64 = 0, // fp32 [nv]
+    picks: u64 = 0, // every rank's (value, id), 8 bytes each
+    walk: u64 = 0, // int32 [T]: the anchor, then each step's pick
+    ids: u64 = 0,
+    mixed: u64 = 0, // bf16 [ctx_rows][hidden]
+    ckv: u64 = 0, // bf16 [ctx_rows][2 kv * 128]
+    keep_logits: u64 = 0, // a check's fp32 [T - 1][nv] of each step's logits (0: none)
+
+    /// Scratch for blocks and absorbs of up to `ctx_rows` rows; the Markov head folded into this rank's head rows.
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, m: *fw.Modules, s: cuda.Stream, w: ds.Weights, t: anytype, capacity: usize, ctx_rows: usize) !*Drafter {
+        const dr = try gpa.create(Drafter);
+        errdefer gpa.destroy(dr);
+        const sh = t.share;
+        const c = &t.config;
+        dr.* = .{ .gpa = gpa, .d = d, .w = w, .k = try dk.Kernels.load(d), .lane = undefined, .hidden = c.hidden, .hq = sh.heads.len(), .hk = sh.kv.len(), .inter = w.c.inter / sh.world, .nv = sh.vocab.len(), .valid = @min(sh.vocab.len(), @as(usize, c.real_vocab) -| sh.vocab.lo), .vlo = sh.vocab.lo, .rank = sh.rank, .world = sh.world, .cap = c.logit_softcap, .capacity = capacity, .ctx_rows = ctx_rows };
+        errdefer dr.k.unload();
+        dr.lane = try cuda.qmmf.Lane.load(d, 12);
+        errdefer dr.lane.unload();
+        errdefer for (dr.bufs.items) |*b| b.free();
+        const h = dr.hidden;
+        var part: usize = 0;
+        for (w.layers[0..w.c.layers]) |l| for ([_]cuda.qmmf.Weight{ l.qkv, l.o, l.gu, l.down }) |x| {
+            part = @max(part, dr.lane.partBytes(T, x));
+        };
+        for (w.layers[0..w.c.layers]) |l| part = @max(part, dr.lane.partBytes(ctx_rows, l.kv));
+        const R: usize = w.c.rank;
+        const qkvw = (dr.hq + 2 * dr.hk) * 128;
+        const sizes = [_]usize{ part, dr.nv * R * 2, dr.nv * 2, T * h * 2, T * h * 2, T * qkvw * 2, T * dr.hq * 128 * 2, T * dr.hq * 128 * 2, T * 2 * dr.inter * 2, T * dr.inter * 2, dr.world * T * h * 4, dk.chunks(0, capacity) * T * dr.hq * 128 * 4, dk.chunks(0, capacity) * T * dr.hq * 8, T * dr.nv * 2, T * 3 * R * 4, R * 2, R * 2, dr.nv * 4, dr.world * 8, T * 4, T * 4, ctx_rows * h * 2, ctx_rows * 2 * dr.hk * 128 * 2 };
+        var ptrs: [sizes.len]u64 = undefined;
+        for (sizes, &ptrs) |n, *p| {
+            var b = try Buf.alloc(d, @max(n, 256));
+            errdefer b.free();
+            try b.fill8(0, null);
+            try dr.bufs.append(gpa, b);
+            p.* = b.ptr;
+        }
+        inline for (.{ "part", "fold", "fbias", "resid", "x", "qkv", "q", "att", "gu", "act", "gath", "po", "pml", "base", "mctx", "state", "latent", "scores", "picks", "walk", "ids", "mixed", "ckv" }, 0..) |name, i| @field(dr, name) = ptrs[i];
+        try dr.foldHead(m, s, t);
+        return dr;
+    }
+
+    pub fn deinit(dr: *Drafter) void {
+        for (dr.bufs.items) |*b| b.free();
+        dr.bufs.deinit(dr.gpa);
+        dr.lane.unload();
+        dr.k.unload();
+        dr.w.deinit(dr.gpa);
+        dr.gpa.destroy(dr);
+    }
+
+    /// fold = head . hidden_out and fbias = head . bias (vLLM folds the bf16 head in fp64; ours is the pack's head).
+    fn foldHead(dr: *Drafter, m: *fw.Modules, s: cuda.Stream, t: anytype) !void {
+        const h = dr.hidden;
+        const R: usize = dr.w.c.rank;
+        const rows = R + 1;
+        const x = try dr.gpa.alloc(u16, rows * h);
+        defer dr.gpa.free(x);
+        for (0..h) |i| for (0..R) |j| {
+            x[j * h + i] = dr.w.hidden_out[i * R + j];
+        };
+        @memcpy(x[R * h ..][0..h], dr.w.hidden_bias);
+        var xb = try Buf.fromHost(dr.d, std.mem.sliceAsBytes(x));
+        defer xb.free();
+        var y = try Buf.alloc(dr.d, rows * dr.nv * 4);
+        defer y.free();
+        try m.dense.decode(s, t.head, xb.ptr, .bf16, rows, y.ptr, .f32);
+        try s.synchronize();
+        const host = try dr.gpa.alloc(f32, rows * dr.nv);
+        defer dr.gpa.free(host);
+        try y.download(0, std.mem.sliceAsBytes(host));
+        const fold = try dr.gpa.alloc(u16, dr.nv * R);
+        defer dr.gpa.free(fold);
+        const fb = try dr.gpa.alloc(u16, dr.nv);
+        defer dr.gpa.free(fb);
+        for (0..dr.nv) |v| {
+            for (0..R) |j| fold[v * R + j] = ds.tobf(host[j * dr.nv + v]);
+            fb[v] = ds.tobf(host[R * dr.nv + v]);
+        }
+        try (Buf{ .d = dr.d, .ptr = dr.fold, .len = fold.len * 2, .borrowed = true }).upload(0, std.mem.sliceAsBytes(fold));
+        try (Buf{ .d = dr.d, .ptr = dr.fbias, .len = fb.len * 2, .borrowed = true }).upload(0, std.mem.sliceAsBytes(fb));
+    }
+
+    fn mm(dr: *Drafter, s: cuda.Stream, wt: cuda.qmmf.Weight, x: u64, rows: usize, y: u64, out: cuda.qmmf.Out) !void {
+        try dr.lane.matmulOut(s, x, wt.k, rows, wt, y, out, dr.part);
+    }
+
+    /// This rank's fp32 partial (`rows` rows at its slot of gath) to every rank; then the ranks' sum adds in order.
+    fn gather(dr: *Drafter, s: cuda.Stream, ex: fw.Exchange, rows: usize) !void {
+        const n = rows * dr.hidden * 4;
+        switch (ex) {
+            .local => {},
+            .nccl => |x| if (x.group) |g| try g.allGather(s, dr.gath + dr.rank * n, dr.gath, n) else try x.lib.check(x.lib.api.ncclAllGather(dr.gath + dr.rank * n, dr.gath, n, .u8, x.comm, s.handle), "ncclAllGather"),
+        }
+    }
+
+    fn mySlot(dr: *const Drafter, rows: usize) u64 {
+        return dr.gath + dr.rank * rows * dr.hidden * 4;
+    }
+
+    /// Context rows at positions p0.. from their taps (bf16 [rows][8][hidden]): each layer's keys and values, f_rnn.
+    pub fn absorb(dr: *Drafter, s: cuda.Stream, slot: *Slot, taps: u64, rows: usize, p0: usize) !void {
+        if (rows == 0 or rows > dr.ctx_rows) return error.Inkling2DraftShape;
+        const c = &dr.w.c;
+        const h = dr.hidden;
+        for (dr.w.layers[0..c.layers], 0..) |l, i| {
+            try dk.mix(&dr.k, s, taps, dr.w.alpha + i * ds.taps_n * 4, l.dflare, dr.mixed, rows, ds.taps_n, h, c.eps);
+            try dr.mm(s, l.kv, dr.mixed, rows, dr.ckv, .bf16);
+            const r = ring(c, i, dr.capacity);
+            try dk.qk(&dr.k, s, .{ .x = dr.ckv, .qw = 0, .kw = l.k_norm_ctx, .q = 0, .kc = slot.keys(i), .vc = slot.values(i), .ld = @intCast(2 * dr.hk * 128), .hq = 0, .hk = @intCast(dr.hk), .ring = @intCast(r), .pos0 = @intCast(p0), .eps = c.eps, .theta = c.theta }, rows);
+        }
+        const last = taps + (rows - 1) * ds.taps_n * h * 2;
+        try dk.mix(&dr.k, s, last, dr.w.alpha + c.layers * ds.taps_n * 4, dr.w.m_norm, slot.frnn, 1, ds.taps_n, h, c.eps);
+        if (slot.to != p0) slot.from = p0; // a gap: the context starts again here
+        slot.to = p0 + rows;
+    }
+
+    /// A block at anchor position `p` (its context absorbed below p): `n` greedy drafts into `out`, every rank alike.
+    pub fn draft(dr: *Drafter, m: *fw.Modules, s: cuda.Stream, ex: fw.Exchange, t: anytype, slot: *Slot, anchor: u32, p: usize, out: []u32) !void {
+        const c = &dr.w.c;
+        const h = dr.hidden;
+        const n = out.len;
+        if (n == 0 or n > T - 1 or p + T > dr.capacity) return error.Inkling2DraftShape;
+        if (slot.to != p) slot.* = .{ .buf = slot.buf, .off = slot.off, .stash = slot.stash, .frnn = slot.frnn, .from = p, .to = p };
+        const one = [1]i32{@intCast(anchor)};
+        try cuda.copy_source.enqueue(dr.d, dr.ids, std.mem.sliceAsBytes(&one), s);
+        try cuda.copy_source.enqueue(dr.d, dr.walk, std.mem.sliceAsBytes(&one), s);
+        try ops.embed(&m.ops, s, dr.ids, 1, t.embed, t.embed_norm, dr.resid, h, t.config.eps);
+        for (1..T) |r| try dr.copy(s, dr.resid + r * h * 2, dr.w.mask, h * 2);
+        try dk.addNorm(&dr.k, s, dr.resid, 0, 0, 0, dr.w.layers[0].in_norm, dr.x, T, h, c.eps);
+        const L = dr.w.layers[0..c.layers];
+        const scale: f32 = 1.0 / @sqrt(128.0);
+        for (L, 0..) |l, i| {
+            try dr.mm(s, l.qkv, dr.x, T, dr.qkv, .bf16);
+            const r = ring(c, i, dr.capacity);
+            try dk.qk(&dr.k, s, .{ .x = dr.qkv, .qw = l.q_norm, .kw = l.k_norm, .q = dr.q, .kc = slot.keys(i), .vc = slot.values(i), .ld = @intCast((dr.hq + 2 * dr.hk) * 128), .hq = @intCast(dr.hq), .hk = @intCast(dr.hk), .ring = @intCast(r), .pos0 = @intCast(p), .eps = c.eps, .theta = c.theta }, T);
+            const lo = if (c.local[i]) @max(slot.from, p -| c.window) else slot.from;
+            try dk.attend(&dr.k, s, .{ .q = dr.q, .kc = slot.keys(i), .vc = slot.values(i), .po = dr.po, .pml = dr.pml, .T = T, .hq = @intCast(dr.hq), .hk = @intCast(dr.hk), .ring = @intCast(r), .lo = @intCast(lo), .hi = @intCast(p + T - 1), .c0 = 0, .scale = scale }, dr.att);
+            try dr.mm(s, l.o, dr.att, T, dr.mySlot(T), .f32);
+            try dr.gather(s, ex, T);
+            try dk.addNorm(&dr.k, s, dr.resid, dr.gath, dr.world, T * h, l.post_norm, dr.x, T, h, c.eps);
+            try dr.mm(s, l.gu, dr.x, T, dr.gu, .bf16);
+            try dk.silu(&dr.k, s, dr.gu, dr.act, T, dr.inter);
+            try dr.mm(s, l.down, dr.act, T, dr.mySlot(T), .f32);
+            try dr.gather(s, ex, T);
+            const next = if (i + 1 < L.len) L[i + 1].in_norm else dr.w.norm;
+            try dk.addNorm(&dr.k, s, dr.resid, dr.gath, dr.world, T * h, next, dr.x, T, h, c.eps);
+        }
+        // rows 1..7: the head's base logits, the Markov context, then the walk from the anchor
+        const hid = dr.x + h * 2;
+        try m.dense.decode(s, t.head, hid, .bf16, T - 1, dr.base, .bf16);
+        const R: usize = c.rank;
+        try dk.ctx(&dr.k, s, hid, slot.frnn, dr.w.rnn, dr.w.rnn_bias, dr.mctx, T - 1, h, R);
+        try dr.d.check(dr.d.api.cuMemsetD8Async(dr.state, 0, R * 2, s.handle), "cuMemsetD8Async");
+        for (0..n) |j| {
+            try dk.rnn(&dr.k, s, dr.mctx + j * 3 * R * 4, dr.w.rnn, dr.w.w1, dr.walk, j, dr.state, dr.latent, R, h);
+            try dk.vocab(&dr.k, s, dr.base + j * dr.nv * 2, dr.latent, dr.fold, dr.fbias, dr.cap, dr.valid, dr.nv, dr.scores);
+            if (dr.keep_logits != 0) try dr.copy(s, dr.keep_logits + j * dr.nv * 4, dr.scores, dr.nv * 4);
+            const mine = dr.picks + dr.rank * 8;
+            try ops.top1(&m.ops, s, dr.scores, 1, dr.nv, dr.nv, dr.vlo, mine, mine + 4);
+            switch (ex) {
+                .local => {},
+                .nccl => |x| if (x.group) |g| try g.allGather(s, mine, dr.picks, 8) else try x.lib.check(x.lib.api.ncclAllGather(mine, dr.picks, 8, .u8, x.comm, s.handle), "ncclAllGather"),
+            }
+            try dk.pick(&dr.k, s, dr.picks, dr.world, dr.walk, j);
+        }
+        try s.synchronize();
+        switch (ex) {
+            .local => {},
+            .nccl => |x| if (x.group) |g| try g.check(),
+        }
+        var got: [T]i32 = undefined;
+        try (Buf{ .d = dr.d, .ptr = dr.walk, .len = T * 4, .borrowed = true }).download(0, std.mem.sliceAsBytes(got[0 .. n + 1]));
+        for (out, got[1 .. n + 1]) |*o, g| o.* = @intCast(g);
+    }
+
+    fn copy(dr: *const Drafter, s: cuda.Stream, dst: u64, src: u64, bytes: usize) !void {
+        try dr.d.check(dr.d.api.cuMemcpyDtoDAsync_v2(dst, src, bytes, s.handle), "cuMemcpyDtoDAsync");
+    }
+};
+
+test "dspark slots: rings for the sliding layers, the global layer at capacity, stash and f_rnn after" {
+    var c: ds.Config = .{};
+    c.local = .{ true, true, false, true, true, false, false, false };
+    const n = slotBytes(&c, 4, 65536, 4608);
+    try std.testing.expectEqual(@as(usize, 4 * 2 * 4096 * 4 * 256 + 2 * 65536 * 4 * 256 + 8 * 8 * 4608 * 2 + 4608 * 2), n);
+}
diff --git a/zig/src/families/inkling2/engine.zig b/zig/src/families/inkling2/engine.zig
index 2126408..be47b3c 100644
--- a/zig/src/families/inkling2/engine.zig
+++ b/zig/src/families/inkling2/engine.zig
@@ -8,6 +8,8 @@ const fw = @import("forward.zig");
 const ops = @import("ops.zig");
 const sampler = @import("sampler.zig");
 const kept = @import("kept.zig");
+const ds = @import("dspark.zig");
+const drun = @import("dspark_run.zig");
 
 /// Rows a prompt chunk holds (the prompt cache's mark grid) and a stream's window at most.
 pub const prompt_rows = 2048;
@@ -32,7 +34,10 @@ const Seq = struct {
     ids: [window_rows]i32 = undefined,
 };
 
-pub const Options = struct { capacity: usize };
+pub const Options = struct { capacity: usize, drafts: bool = true };
+
+/// A stream's draft request: its slot, the rows of its last window it kept (0: the prompt's), the token after them.
+pub const Req = struct { slot: u32, n: u32, anchor: u32, out: []u32 };
 
 /// A graph's key: a decode call's rows, streams, attention tiles and partial stride (its global chunks).
 const Key = struct { n: u32, ni: u32, nt: u32, stride: u32 };
@@ -64,6 +69,10 @@ pub const Engine = struct {
     gengine: cuda.graph_cache.CudaEngine,
     states: kept.Store,
     checkpoint_digest: [32]u8 = @splat(0),
+    drafter: ?*drun.Drafter = null, // mtp.safetensors beside the pack: each stream's next block
+    dslots: []drun.Slot = &.{},
+    tap_at: [7]u32 = undefined,
+    tap_bufs: [2]?cuda.DeviceBuffer = .{ null, null },
 
