+/// Greedy decode with a 7-draft block before every window: one 8-row window, the agreeing rows kept (fixed depth).
+/// With `oracle` (plain greedy's tokens) the drafts are its next tokens, one of them spoiled per window in turn.
+fn draftedGreedy(e: *ink.engine.Engine, a: std.mem.Allocator, ids: []const u32, n: usize, oracle: ?[]const u32) !struct { toks: []u32, acc: usize, drafted: usize, windows: usize } {
+    try e.bind(0);
+    e.begin(null);
+    var at: usize = 0;
+    var tok: u32 = while (true) : (at += ink.engine.prompt_rows) {
+        if (try e.prefillChunk(ids, at)) |t| break t;
+    };
+    var toks: std.ArrayList(u32) = .empty;
+    var kept: u32 = 0;
+    var acc: usize = 0;
+    var windows: usize = 0;
+    while (toks.items.len < n) : (windows += 1) {
+        var w: [8]u32 = undefined;
+        w[0] = tok;
+        try e.draftBlock(&.{.{ .slot = 0, .n = kept, .anchor = tok, .out = w[1..8] }});
+        if (oracle) |orc| {
+            const m = toks.items.len;
+            for (1..8) |j| w[j] = orc[m + j];
+            const c = windows % 8;
+            if (c < 7) w[1 + c] ^= 1;
+        }
+        var o: [8]u32 = undefined;
+        try e.verifyShared(&.{.{ .slot = 0, .ids = &w, .out = &o }});
+        var k: usize = 1;
+        while (k < 8 and w[k] == o[k - 1]) k += 1;
+        try e.keep(k);
+        try toks.appendSlice(a, w[0..k]);
+        acc += k - 1;
+        kept = @intCast(k);
+        tok = o[k - 1];
+    }
+    return .{ .toks = toks.items, .acc = acc, .drafted = 7 * windows, .windows = windows };
+}
+
 /// A text's prompt pass on the bound slot then `n` greedy tokens, one decode row at a time.
 fn greedy(e: *ink.engine.Engine, a: std.mem.Allocator, ids: []const u32, n: usize) ![]u32 {
     try e.bind(0);
