From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ajensenwaud <ajensenwaud@users.noreply.github.com>
Date: Sat, 14 Nov 2026 12:02:13 +1100
Subject: [PATCH 15/45] inkling2: tf-inkling2-engine drafts also writes each
 prompt's taps

The reference can then run the drafter on the engine's own taps, which leaves
only the drafter's arithmetic between the two.
---
 zig/src/families/inkling2/engine_main.zig | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/zig/src/families/inkling2/engine_main.zig b/zig/src/families/inkling2/engine_main.zig
index cece4a1..3aa18f3 100644
--- a/zig/src/families/inkling2/engine_main.zig
+++ b/zig/src/families/inkling2/engine_main.zig
@@ -227,6 +227,15 @@ fn drafts(e: *ink.engine.Engine, a: std.mem.Allocator, io: std.Io, out: std.Io.D
     try json.print(a, "{{\"rank\": {d}, \"vocab_lo\": {d}, \"vocab_n\": {d}, \"anchors\": [", .{ rank, dr.vlo, nv });
     var count: usize = 0;
     for (texts) |t| {
+        if (t.ids.len <= ink.engine.prompt_rows) {
+            // the prompt's taps (a row never depends on later rows), for the reference run on our own taps
+            try e.bind(0);
+            e.begin(null);
+            _ = try e.prefillChunk(t.ids, 0);
+            const tb = try a.alloc(u8, t.ids.len * ink.dspark.taps_n * e.c.hidden * 2);
+            try (cuda.DeviceBuffer{ .d = e.d, .ptr = e.bp.taps, .len = tb.len, .borrowed = true }).download(0, tb);
+            if (rank == 0) try out.writeFile(io, .{ .sub_path = try std.fmt.allocPrint(a, "taps-{s}.bin", .{t.name}), .data = tb });
+        }
         const step = @max(16, t.ids.len / 12);
         var p: usize = 16;
         while (p + 8 < t.ids.len) : (p += step) {
