@@ -0,0 +1,144 @@
+//! tf-inkling2-engine images: image prompts through the serving engine (rank 0 encodes, every rank splices).
+const std = @import("std");
+const cuda = @import("cuda");
+const ink = @import("inkling2");
+const main = @import("engine_main.zig");
+
+const Engine = ink.engine.Engine;
+const dump_slot = 15; // the slot the rows dumps run in (its drafter context is never used)
+
+/// One picture's prompt: its ids (the chat template's, placeholders expanded), the processor's patches, its spans.
+const Prompt = struct { name: []const u8, ids: []u32, pic: ink.image.Prepared, spans: []ink.vision.Span };
+
+/// Each NAME.png + NAME.ids.u32 in `dir`: spliced rows, then greedy solo, drafted and beside a text prompt (1: a miss).
+pub fn run(e: *Engine, a: std.mem.Allocator, io: std.Io, dir: []const u8, out: std.Io.Dir, new: usize, r0: bool) !u8 {
+    var list: std.ArrayList(Prompt) = .empty;
+    var d = try std.Io.Dir.cwd().openDir(io, dir, .{ .iterate = true });
+    defer d.close(io);
+    var it = d.iterate();
+    while (try it.next(io)) |ent| {
+        if (!std.mem.endsWith(u8, ent.name, ".png")) continue;
+        const name = try a.dupe(u8, ent.name[0 .. ent.name.len - 4]);
+        const bytes = try d.readFileAlloc(io, ent.name, a, .limited(64 << 20));
+        const raw = try d.readFileAlloc(io, try std.fmt.allocPrint(a, "{s}.ids.u32", .{name}), a, .limited(1 << 20));
+        const ids = try a.alloc(u32, raw.len / 4);
+        @memcpy(std.mem.sliceAsBytes(ids), raw[0 .. ids.len * 4]);
+        const pic = ink.image.prepare(io, a, bytes, ink.pictures.picture_tokens) catch |err| {
+            if (r0) std.debug.print("{s}: refused, {s}: {s}\n", .{ name, @errorName(err), ink.pictures.Offer.explain(err) orelse "" });
+            continue;
+        };
+        const spans = try ink.vision.spans(a, ids);
+        try ink.vision.check(spans, &.{pic});
+        try list.append(a, .{ .name = name, .ids = ids, .pic = pic, .spans = spans });
+    }
+    std.mem.sort(Prompt, list.items, {}, struct {
+        fn lt(_: void, x: Prompt, y: Prompt) bool {
+            return std.mem.lessThan(u8, x.name, y.name);
+        }
+    }.lt);
+    e.graphs.settings.on = false;
+    var bad: usize = 0;
+    const row = @as(usize, e.c.hidden) * 2;
+    for (list.items) |p| {
+        const img: main.Img = .{ .pics = &.{p.pic}, .spans = p.spans };
+        const spliced = try embedRows(e, a, p.ids, img);
+        const tower = try a.alloc(u8, p.pic.tokens() * row);
+        try e.rows[dump_slot].buf.download(0, tower);
+        const plain = try embedRows(e, a, p.ids, null);
+        var k: usize = 0;
+        var same = true;
+        for (p.ids, 0..) |id, i| {
+            const want = if (id == ink.image.image_token) tower[k * row ..][0..row] else plain[i * row ..][0..row];
+            k += @intFromBool(id == ink.image.image_token);
+            same = same and std.mem.eql(u8, spliced[i * row ..][0..row], want);
+        }
+        bad += @intFromBool(!same);
+        if (r0) {
+            try out.writeFile(io, .{ .sub_path = try std.fmt.allocPrint(a, "{s}.spliced.bf16", .{p.name}), .data = spliced });
+            try out.writeFile(io, .{ .sub_path = try std.fmt.allocPrint(a, "{s}.rows.bf16", .{p.name}), .data = tower });
+            std.debug.print("{s}: {d} rows, {d} image rows; spliced == text rows + tower rows {s}\n", .{ p.name, p.ids.len, k, if (same) "PASS" else "FAIL" });
+        }
+        const solo = try main.greedy(e, a, p.ids, new + 8, img);
+        if (r0) try writeIds(a, io, out, p.name, solo[0..new]);
+        if (e.drafter != null) {
+            const dr = try main.draftedGreedy(e, a, p.ids, new, null, img);
+            const ok = std.mem.eql(u32, solo[0..new], dr.toks[0..new]);
+            bad += @intFromBool(!ok);
+            if (r0) std.debug.print("{s}: drafted == plain {s}; accepted {d}/{d}\n", .{ p.name, if (ok) "PASS" else "FAIL", dr.acc, dr.drafted });
+        }
+        bad += try beside(e, a, p, img, solo[0..new], r0);
+    }
+    if (r0) std.debug.print("images: {d} prompts, {s}\n", .{ list.items.len, if (bad == 0) "PASS" else "FAIL" });
+    return if (bad == 0) 0 else 1;
+}
+
+/// A prompt pass's rows right after the embedding and splice (the forward's layer-0 input), bf16 [rows][hidden].
+fn embedRows(e: *Engine, a: std.mem.Allocator, ids: []const u32, img: ?main.Img) ![]u8 {
+    if (ids.len > ink.engine.prompt_rows) return error.PromptTooLong;
+    try e.bind(dump_slot);
+    e.begin(null);
+    if (img) |im| try e.images(im.pics, im.spans);
+    const taps_n = ink.dspark.taps_n;
+    const h = @as(usize, e.c.hidden);
+    var own: ?cuda.DeviceBuffer = if (e.bp.taps == 0) try cuda.DeviceBuffer.alloc(e.d, ink.engine.prompt_rows * taps_n * h * 2) else null;
+    defer if (own) |*b| b.free();
+    const keep_at = e.tap_at;
+    const keep_taps = e.bp.taps;
+    defer {
+        e.tap_at = keep_at;
+        e.bp.taps = keep_taps;
+    }
+    if (own) |b| e.bp.taps = b.ptr;
+    e.tap_at = .{ 0, std.math.maxInt(u32), std.math.maxInt(u32), std.math.maxInt(u32), std.math.maxInt(u32), std.math.maxInt(u32), std.math.maxInt(u32) };
+    _ = try e.prefillChunk(ids, 0);
+    try e.stream.synchronize();
+    const all = try a.alloc(u8, ids.len * taps_n * h * 2);
+    try (cuda.DeviceBuffer{ .d = e.d, .ptr = e.bp.taps, .len = all.len, .borrowed = true }).download(0, all);
+    const rows = try a.alloc(u8, ids.len * h * 2);
+    for (0..ids.len) |i| @memcpy(rows[i * h * 2 ..][0 .. h * 2], all[i * taps_n * h * 2 ..][0 .. h * 2]);
+    return rows;
+}
+
+/// The image prompt (slot 1) and a text prompt (its ids without the pictures, slot 2) decoded in shared windows.
+fn beside(e: *Engine, a: std.mem.Allocator, p: Prompt, img: main.Img, solo: []const u32, r0: bool) !usize {
+    var text: std.ArrayList(u32) = .empty;
+    for (p.ids) |id| if (id != ink.image.image_token) try text.append(a, id);
+    const text_solo = try main.greedy(e, a, text.items, solo.len, null);
+    var pend: [2]u32 = undefined;
+    for ([_]u32{ 1, 2 }, 0..) |slot, i| {
+        try e.bind(slot);
+        e.begin(null);
+        if (i == 0) try e.images(img.pics, img.spans);
+        const ids = if (i == 0) p.ids else text.items;
+        var at: usize = 0;
+        pend[i] = while (true) : (at += ink.engine.prompt_rows) {
+            if (try e.prefillChunk(ids, at)) |t| break t;
+        };
+    }
+    var got: [2][]u32 = .{ try a.alloc(u32, solo.len), try a.alloc(u32, solo.len) };
+    for (0..solo.len) |j| {
+        var o: [2][1]u32 = undefined;
+        for (0..2) |i| got[i][j] = pend[i];
+        try e.verifyShared(&.{ .{ .slot = 1, .ids = got[0][j..][0..1], .out = &o[0] }, .{ .slot = 2, .ids = got[1][j..][0..1], .out = &o[1] } });
+        for ([_]u32{ 1, 2 }, 0..) |slot, i| {
+            try e.bind(slot);
+            try e.keep(1);
+            pend[i] = o[i][0];
+        }
+    }
+    const ok = [2]bool{ std.mem.eql(u32, got[0], solo), std.mem.eql(u32, got[1], text_solo) };
+    if (r0) std.debug.print("{s}: concurrent image == solo {s}, text == solo {s}\n", .{ p.name, pf(ok[0]), pf(ok[1]) });
+    return @intFromBool(!ok[0]) + @intFromBool(!ok[1]);
+}
+
+fn pf(ok: bool) []const u8 {
+    return if (ok) "PASS" else "FAIL";
+}
+
+fn writeIds(a: std.mem.Allocator, io: std.Io, out: std.Io.Dir, name: []const u8, toks: []const u32) !void {
+    var json: std.ArrayList(u8) = .empty;
+    try json.appendSlice(a, "[");
+    for (toks, 0..) |t, j| try json.print(a, "{s}{d}", .{ if (j > 0) ", " else "", t });
+    try json.appendSlice(a, "]\n");
+    try out.writeFile(io, .{ .sub_path = try std.fmt.allocPrint(a, "{s}.greedy.json", .{name}), .data = json.items });
+}
