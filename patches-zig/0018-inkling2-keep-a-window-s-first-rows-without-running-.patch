+/// Byte offset of layer `i`'s conv site `j` (k, v, attention, MLP) in a hist of `rows` rows: [rows][C] a site.
+pub fn histAt(c: *const cfg.Config, kv: usize, rows: usize, i: usize, j: usize) usize {
+    const kvw = kv * c.head_dim;
+    const layer = rows * (2 * kvw + 2 * @as(usize, c.hidden)) * 4;
+    const in = if (j < 2) j * rows * kvw * 4 else 2 * rows * kvw * 4 + (j - 2) * rows * @as(usize, c.hidden) * 4;
+    return i * layer + in;
+}
