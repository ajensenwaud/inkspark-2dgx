diff --git a/zig/src/core/lanes/shared_pass_test.zig b/zig/src/core/lanes/shared_pass_test.zig
new file mode 100644
index 0000000..883d587
--- /dev/null
+++ b/zig/src/core/lanes/shared_pass_test.zig
@@ -0,0 +1,111 @@
+//! Shared rounds' draft prices: a measured overhead's head steps, and a block head that runs a pass a stream.
+const std = @import("std");
+const depth = @import("depth.zig");
+const alloc = @import("allocate.zig");
+const Table = @import("table.zig").Table;
+const Cost = alloc.Cost;
+const Rule = depth.Rule;
+const State = depth.State;
+const Who = depth.Who;
+const Probe = depth.Probe;
+
+const No = struct {
+    fn copy(_: *anyopaque, _: *const Who) bool {
+        return false;
+    }
+};
+var unused: u8 = 0;
+const probe: Probe = .{ .ptr = &unused, .copy = No.copy };
+
+test "a shared round's drafts come out the same whichever depths its overhead was measured at" {
+    const gpa = std.testing.allocator;
+    var shared: Table = .{};
+    defer shared.deinit(gpa);
+    for (1..17) |w| try shared.put(gpa, @intCast(w), 10.0 + 2.0 * @as(f64, @floatFromInt(w)));
+    const empty: Table = .{};
+    var got: [2][2]i64 = undefined;
+    for ([_][2]i64{ .{ 1, 1 }, .{ 3, 3 } }, &got) |measured, *out| {
+        var rule: Rule = .{ .gpa = gpa, .prior = &.{ 0.9, 0.8, 0.7, 0.6 }, .most_drafts = 4, .family_costs = &empty, .shared_costs = &shared, .mtp_step_ms = 3.0, .plain_guard = false, .node_probabilities = false, .batch_rows = 16 };
+        defer rule.deinit();
+        // two streams' round: their pending rows and the drafts verified, 3 ms of its own, then each drafted step
+        const rows: u64 = @intCast(2 + measured[0] + measured[1]);
+        const head = rule.headMs(&measured);
+        try rule.observeOverhead(2, rows, shared.get(@intCast(rows)).? + 3.0 + head, false, head);
+        var states: [2]?State = .{ null, null };
+        defer for (&states) |*s| if (s.*) |*x| x.deinit(gpa);
+        var whos = [_]Who{ .{ .state = &states[0], .draft_room = 100, .finished = false, .forced = false }, .{ .state = &states[1], .draft_room = 100, .finished = false, .forced = false } };
+        try rule.budgets(&whos, probe, false, out);
+    }
+    try std.testing.expectEqualSlices(i64, &got[0], &got[1]);
+}
+
+/// Inkling 2 on two GB10s (tf-inkling2-engine timing): shared forwards by total rows, a lone window by rows.
+const shared_ms = [_]Cost{
+    .{ .width = 1, .ms = 31.8 },  .{ .width = 2, .ms = 41.3 },   .{ .width = 4, .ms = 61.8 },   .{ .width = 8, .ms = 81.4 },
+    .{ .width = 16, .ms = 120.6 }, .{ .width = 32, .ms = 182.3 }, .{ .width = 64, .ms = 223.4 },
+};
+const lone_ms = [_]f64{ 31.8, 38.7, 45.1, 52.0, 56.6, 61.0, 66.9, 69.8 };
+const prose = [_]f64{ 0.7, 0.55, 0.5 };
+const code = [_]f64{0.95};
+
+fn inkRule(costs: *const Table, lone: *const Table, rates: []const f64, passes: bool) Rule {
+    return .{ .gpa = std.testing.allocator, .prior = rates, .most_drafts = 7, .family_costs = lone, .shared_costs = costs, .mtp_step_ms = 16.4 / 7.0, .draft_step_ms = if (passes) 15.9 else 15.8, .draft_passes = passes, .plain_guard = true, .node_probabilities = false, .batch_rows = 64, .batched_heads = true };
+}
+
+/// The first shared round's budgets for `streams` streams drafting at `rates` (no overhead measured yet: 8 ms).
+fn budgets(rates: []const f64, streams: usize, passes: bool) ![8]i64 {
+    const gpa = std.testing.allocator;
+    var costs = try alloc.extendCosts(gpa, &shared_ms, 64);
+    defer costs.deinit(gpa);
+    const empty: Table = .{};
+    var rule = inkRule(&costs, &empty, rates, passes);
+    defer rule.deinit();
+    var states: [8]?State = @splat(null);
+    defer for (&states) |*s| if (s.*) |*x| x.deinit(gpa);
+    var whos: [8]Who = undefined;
+    for (&whos, &states) |*w, *s| w.* = .{ .state = s, .draft_room = 100, .finished = false, .forced = false };
+    var out: [8]i64 = @splat(0);
+    try rule.budgets(whos[0..streams], probe, false, out[0..streams]);
+    return out;
+}
+
+test "a block head's pass a drafting stream: shared rounds go plain where it does not pay, a lone stream drafts" {
+    const t = std.testing;
+    const none: [8]i64 = @splat(0);
+    // prose rates: every stream's ~16 ms pass costs more than its ~1.2 drafts save, at 4 streams and at 8
+    try t.expectEqualSlices(i64, &none, &try budgets(&prose, 4, true));
+    try t.expectEqualSlices(i64, &none, &try budgets(&prose, 8, true));
+    // priced by depth past each stream's first draft, a first draft for every stream looked free
+    var old: i64 = 0;
+    for (try budgets(&prose, 4, false)) |d| old += d;
+    try t.expect(old > 0);
+    // code rates: the passes pay, every stream drafts
+    for ((try budgets(&code, 4, true))[0..4]) |d| try t.expect(d > 0);
+    // a lone stream's rounds keep their own rule: prose still drafts against a 31.8 ms plain window
+    var costs = try alloc.extendCosts(t.allocator, &shared_ms, 64);
+    defer costs.deinit(t.allocator);
+    var lone: Table = .{};
+    defer lone.deinit(t.allocator);
+    for (lone_ms, 1..) |ms, w| try lone.put(t.allocator, @intCast(w), ms);
+    var rule = inkRule(&costs, &lone, &prose, true);
+    defer rule.deinit();
+    var st: ?State = null;
+    defer if (st) |*s| s.deinit(t.allocator);
+    try t.expect(try rule.depth(.{ .state = &st, .draft_room = 100, .finished = false, .forced = false }) > 0);
+}
+
+test "a shared round's measured overhead leaves out the passes its budgets priced" {
+    const t = std.testing;
+    var costs = try alloc.extendCosts(t.allocator, &shared_ms, 64);
+    defer costs.deinit(t.allocator);
+    const empty: Table = .{};
+    var rule = inkRule(&costs, &empty, &prose, true);
+    defer rule.deinit();
+    // four streams, two of them drafting (3 and 1 drafts): two passes whatever their depth, 5 ms of the round's own
+    const depths = [_]i64{ 3, 0, 1, 0 };
+    try t.expectApproxEqAbs(@as(f64, 2 * 15.9), rule.pricedDraftMs(&depths), 1e-9);
+    try t.expectEqual(@as(f64, 0), rule.headMs(&depths));
+    const elapsed = costs.get(8).? + 5.0 + 2 * 15.9;
+    try rule.observeOverhead(4, 8, elapsed - rule.pricedDraftMs(&depths), false, rule.headMs(&depths));
+    try t.expectApproxEqAbs(@as(f64, 5.0), rule.overheadMs(4, false), 1e-9);
+}
