From: ajensenwaud <ajensenwaud@users.noreply.github.com>
Date: Mon, 16 Nov 2026 01:47:52 +1100
Subject: [PATCH 26/45] inkling2: narrow projections on a side stream

r, k and v (384 and 512 outputs a rank) launch 24 and 32 blocks and run
at 67-84 GB/s, about 2 ms of the 1-row decode step on their own. They and
the attention-sink and dynamic-conv row dots now run on a second stream,
with their own EXL3 scratch, beside q and the gate; the main stream waits
for them before the convs. Same kernels on the same inputs: equal bits.
---
 zig/src/families/inkling2/engine.zig  |  1 +
 zig/src/families/inkling2/forward.zig | 53 ++++++++++++++++++++++-----
 2 files changed, 45 insertions(+), 9 deletions(-)

diff --git a/zig/src/families/inkling2/engine.zig b/zig/src/families/inkling2/engine.zig
index f59aee7..2b3ed79 100644
--- a/zig/src/families/inkling2/engine.zig
+++ b/zig/src/families/inkling2/engine.zig
@@ -108,6 +108,7 @@ pub const Engine = struct {
         errdefer e.bd.deinit();
         for (e.w.layers) |l| for ([_]cuda.exl3.Weight{ l.attn.q, l.attn.k, l.attn.v, l.attn.r, l.attn.gate, l.attn.o }) |x| try e.m.dense.reserve(stream, x);
         try e.m.dense.reserve(stream, e.w.head); // scratch grown now, so nothing allocates inside a graph capture
+        for (e.w.layers) |l| for ([_]cuda.exl3.Weight{ l.attn.k, l.attn.v, l.attn.r }) |x| try e.m.side.dense.reserve(stream, x);
         if (o.drafts and ds.present(io, gpa, dir)) try e.loadDrafter(dir, o.capacity);
         errdefer e.freeDrafter();
         e.vision = o.vision;
