From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ajensenwaud <ajensenwaud@users.noreply.github.com>
Date: Mon, 16 Nov 2026 18:14:35 +1100
Subject: [PATCH 37/45] inkling2: short convs run a stream's rows in blocks of
 32, same bits

---
 zig/kernels/cuda/inkling2/ops.cu  | 45 +++++++++++++++----------------
 zig/src/families/inkling2/ops.zig |  4 ++-
 2 files changed, 25 insertions(+), 24 deletions(-)

diff --git a/zig/kernels/cuda/inkling2/ops.cu b/zig/kernels/cuda/inkling2/ops.cu
index cca3b8a..2e26fc6 100644
--- a/zig/kernels/cuda/inkling2/ops.cu
+++ b/zig/kernels/cuda/inkling2/ops.cu
@@ -14,11 +14,8 @@ constexpr int kConvTaps = 4;
 constexpr int kMixCache = 10;  // tf_ink2_mix holds a row of up to kMixCache x blockDim columns in registers
 
 __device__ __forceinline__ float bf(uint16_t u) { return __uint_as_float(static_cast<uint32_t>(u) << 16); }
-
 __device__ __forceinline__ uint16_t tobf(float f) { return __bfloat16_as_ushort(__float2bfloat16_rn(f)); }
-
 __device__ __forceinline__ float bfr(float f) { return bf(tobf(f)); }
-
 __device__ __forceinline__ float warpSum(float v) {
     for (int o = 16; o > 0; o >>= 1) v += __shfl_xor_sync(0xffffffffu, v, o);
     return v;
@@ -383,21 +380,27 @@ struct ConvArgs {
     int parts, x_bf16, round_in, heads, C, rows, mode;  // mode 0: out = y; 1: resid = base + bf16(y); 2: resid + bf16(y)
 };
 
+// Rows in blocks of 32 (z), each from its three prior inputs recomputed (same bits); block 0 owns the state.
 extern "C" __global__ void __launch_bounds__(128) tf_ink2_conv(const ConvArgs a) {
     const int c = blockIdx.x * blockDim.x + threadIdx.x;
-    if (c >= a.C) return;
-    const int C = a.C;
+    const int C = a.C, r0 = blockIdx.z * 32, hd = a.dyn ? c / (C / a.heads) : 0;
     const int4 sg = a.segs ? a.segs[blockIdx.y] : make_int4(0, a.rows, 0, 0);
+    if (c >= C || r0 >= sg.y) return;
     float* state = a.state + sg.z * a.state_stride;
-    float h0 = state[c], h1 = state[C + c], h2 = state[2 * C + c];
-    const int hd = a.dyn ? c / (C / a.heads) : 0;
-    for (int t = sg.x; t < sg.x + sg.y; ++t) {
+    const auto input = [&](int t) {
         const size_t at = static_cast<size_t>(t) * C + c;
         float x = a.x_bf16 ? bf(static_cast<const uint16_t*>(a.x)[at]) : static_cast<const float*>(a.x)[at];
         for (int r = 1; r < a.parts; ++r) x += static_cast<const float*>(a.x)[at + r * a.part_stride];
-        if (a.round_in) x = bfr(x);
-        if (a.hist) a.hist[at] = x;
+        return a.round_in ? bfr(x) : x;
+    };
+    const int t0 = sg.x + r0, t1 = sg.x + min(sg.y, r0 + 32), end = sg.x + sg.y;
+    float h0 = r0 == 0 ? state[c] : input(t0 - 3), h1 = r0 == 0 ? state[C + c] : input(t0 - 2);
+    float h2 = r0 == 0 ? state[2 * C + c] : input(t0 - 1);
+    for (int t = t0; t < t1; ++t) {
+        const size_t at = static_cast<size_t>(t) * C + c;
+        const float x = input(t);
         float y;
+        if (a.hist) a.hist[at] = x;
         if (a.dyn) {
             const float* d = a.dyn + (static_cast<size_t>(t) * a.heads + hd) * kConvTaps;
             y = (bf(a.w[c]) + d[0]) * x + (bf(a.w[C + c]) + d[1]) * h2;
@@ -411,20 +414,16 @@ extern "C" __global__ void __launch_bounds__(128) tf_ink2_conv(const ConvArgs a)
             y += bf(w[3]) * x;
             y = (y + x) / 2.2360679774997896f;
         }
-        if (a.mode == 0) {
-            a.out[at] = tobf(y);
-        } else if (a.mode == 1) {
-            a.resid[at] = (a.base ? bf(a.base[at]) : 0.0f) + bfr(y);
-        } else {
-            a.out[at] = tobf(a.resid[at] + bfr(y));
-        }
-        h0 = h1;
-        h1 = h2;
-        h2 = x;
+        if (a.mode == 0) a.out[at] = tobf(y);
+        else if (a.mode == 1) a.resid[at] = (a.base ? bf(a.base[at]) : 0.0f) + bfr(y);
+        else a.out[at] = tobf(a.resid[at] + bfr(y));
+        h0 = h1, h1 = h2, h2 = x;
     }
-    state[c] = h0;
-    state[C + c] = h1;
-    state[2 * C + c] = h2;
+    if (r0 != 0) return;
+    const bool last = t1 == end;  // else the stream's last three inputs, recomputed
+    state[c] = last ? h0 : input(end - 3);
+    state[C + c] = last ? h1 : input(end - 2);
+    state[2 * C + c] = last ? h2 : input(end - 1);
 }
 
 // A conv site of every slot: slot 0's state, its C, and byte offsets of its rows in a hist and in a slot's backup.
diff --git a/zig/src/families/inkling2/ops.zig b/zig/src/families/inkling2/ops.zig
index d542be0..e5c3f2b 100644
--- a/zig/src/families/inkling2/ops.zig
+++ b/zig/src/families/inkling2/ops.zig
@@ -157,7 +157,9 @@ pub fn gateup(k: *const Kernels, s: cuda.Stream, g: GateUpArgs) !void {
 pub fn conv(k: *const Kernels, s: cuda.Stream, c: ConvArgs, streams: usize) !void {
     var a: cuda.Args = .{};
     a.add(c);
-    try go(k.conv, s, .{ .x = @intCast(std.math.divCeil(i32, c.c, 128) catch unreachable), .y = @intCast(streams) }, 128, &a);
+    // a stream's rows in blocks of 32 (blocks past a stream's rows return at once)
+    const z: u32 = @intCast(std.math.divCeil(i32, c.rows, 32) catch unreachable);
+    try go(k.conv, s, .{ .x = @intCast(std.math.divCeil(i32, c.c, 128) catch unreachable), .y = @intCast(streams), .z = z }, 128, &a);
 }
 
 /// ops.cu's RewindSite: a conv site's slot-0 state, byte offsets of its rows in a hist and in a slot's backup, its C.
