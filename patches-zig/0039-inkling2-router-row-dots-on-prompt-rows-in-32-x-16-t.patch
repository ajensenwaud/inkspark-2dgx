Subject: [PATCH 39/45] inkling2: router row dots on prompt rows in 32 x 16
 tiles, same sums in the same order

---
 zig/build/cuda_kernels.zig        |  1 +
 zig/kernels/cuda/inkling2/rows.cu | 68 +++++++++++++++++++++++++++++++
 zig/src/cuda/kernels.zig          |  1 +
 zig/src/families/inkling2/ops.zig | 11 +++++
 4 files changed, 81 insertions(+)
 create mode 100644 zig/kernels/cuda/inkling2/rows.cu

diff --git a/zig/build/cuda_kernels.zig b/zig/build/cuda_kernels.zig
index d399387..bfb30af 100644
--- a/zig/build/cuda_kernels.zig
+++ b/zig/build/cuda_kernels.zig
@@ -149,6 +149,7 @@ pub const kernels = [_]Kernel{
     .{ .name = "minimax_m3_attn", .flags = glue }, // ours: MiniMax-M3.1-Flash's indexer and block-sparse attention
     .{ .name = "inkling2_attn", .src = "inkling2/attention", .flags = &.{"-O3"} }, // ours: Inkling 2's relative-bias attention
     .{ .name = "inkling2_ops", .src = "inkling2/ops", .flags = glue }, // ours: Inkling 2's residual mix, convs, router, SwiGLU
+    .{ .name = "inkling2_rows", .src = "inkling2/rows", .flags = glue }, // ours: Inkling 2's router row dots on prompt rows
     .{ .name = "inkling2_dspark", .src = "inkling2/dspark", .flags = glue }, // ours: Inkling 2's DSpark drafter glue
     .{ .name = "inkling2_vision", .src = "inkling2/vision", .flags = glue }, // ours: Inkling 2's vision tower glue and attention
     .{ .name = "glm_quant", .flags = torch_ops }, // ours: GLM's draft-only weight quantizers, torch at load in the Python family
diff --git a/zig/kernels/cuda/inkling2/rows.cu b/zig/kernels/cuda/inkling2/rows.cu
new file mode 100644
index 0000000..084cac3
--- /dev/null
+++ b/zig/kernels/cuda/inkling2/rows.cu
@@ -0,0 +1,68 @@
+// Inkling 2's prompt-row kernels: the router's row dots tiled over 32 rows x 16 outputs, tf_ink2_rowdot's bits.
+#include <cstdint>
+
+namespace ink2r {
+
+constexpr int kRows = 32, kOuts = 16, kCols = 128;
+
+__device__ __forceinline__ float bf(uint16_t u) { return __uint_as_float(static_cast<uint32_t>(u) << 16); }
+
+}  // namespace ink2r
+
+// fp32 sigmoid?(x[row] . W[j]): lane l sums columns l, l + 32, ... then the xor tree, as tf_ink2_rowdot; C % 128 == 0.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_rowdot_tiles(const uint16_t* __restrict__ x,
+                                                                       const uint16_t* __restrict__ W,
+                                                                       float* __restrict__ out, int rows, int J,
+                                                                       int C, int act) {
+    using namespace ink2r;
+    __shared__ float xs[kRows][kCols];
+    __shared__ float ws[kOuts][kCols];
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+    const int r0 = blockIdx.x * kRows, j0 = blockIdx.y * kOuts;
+    float acc[4][kOuts];
+#pragma unroll
+    for (int i = 0; i < 4; ++i)
+#pragma unroll
+        for (int j = 0; j < kOuts; ++j) acc[i][j] = 0.0f;
+    for (int c0 = 0; c0 < C; c0 += kCols) {
+        __syncthreads();
+        for (int e = threadIdx.x; e < (kRows + kOuts) * kCols / 8; e += 256) {
+            const int r = e / (kCols / 8), c = (e % (kCols / 8)) * 8;
+            const bool wrow = r >= kRows;
+            const int src = wrow ? j0 + r - kRows : r0 + r;
+            uint4 v = make_uint4(0, 0, 0, 0);
+            if (src < (wrow ? J : rows))
+                v = *reinterpret_cast<const uint4*>((wrow ? W : x) + static_cast<size_t>(src) * C + c0 + c);
+            float* d = wrow ? &ws[r - kRows][c] : &xs[r][c];
+            const uint32_t u[4] = {v.x, v.y, v.z, v.w};
+            for (int k = 0; k < 4; ++k) {
+                d[2 * k] = ink2r::bf(static_cast<uint16_t>(u[k] & 0xffffu));
+                d[2 * k + 1] = ink2r::bf(static_cast<uint16_t>(u[k] >> 16));
+            }
+        }
+        __syncthreads();
+        for (int m = 0; m < kCols / 32; ++m) {
+            const int c = m * 32 + lane;
+            float xv[4], wv[kOuts];
+#pragma unroll
+            for (int i = 0; i < 4; ++i) xv[i] = xs[warp * 4 + i][c];
+#pragma unroll
+            for (int j = 0; j < kOuts; ++j) wv[j] = ws[j][c];
+#pragma unroll
+            for (int i = 0; i < 4; ++i)
+#pragma unroll
+                for (int j = 0; j < kOuts; ++j) acc[i][j] += xv[i] * wv[j];
+        }
+    }
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        const int row = r0 + warp * 4 + i;
+#pragma unroll
+        for (int j = 0; j < kOuts; ++j) {
+            float s = acc[i][j];
+            for (int o = 16; o > 0; o >>= 1) s += __shfl_xor_sync(0xffffffffu, s, o);
+            if (lane != 0 || row >= rows || j0 + j >= J) continue;
+            out[static_cast<size_t>(row) * J + j0 + j] = act == 1 ? 1.0f / (1.0f + expf(-s)) : s;
+        }
+    }
+}
diff --git a/zig/src/cuda/kernels.zig b/zig/src/cuda/kernels.zig
index 4e0f60b..023ae98 100644
--- a/zig/src/cuda/kernels.zig
+++ b/zig/src/cuda/kernels.zig
@@ -82,6 +82,7 @@ pub const minimax_m3: []const u8 = if (available) &Blob("fatbin_minimax_m3").byt
 pub const minimax_m3_attn: []const u8 = if (available) &Blob("fatbin_minimax_m3_attn").bytes else &.{};
 pub const inkling2_attn: []const u8 = if (available) &Blob("fatbin_inkling2_attn").bytes else &.{};
 pub const inkling2_ops: []const u8 = if (available) &Blob("fatbin_inkling2_ops").bytes else &.{};
+pub const inkling2_rows: []const u8 = if (available) &Blob("fatbin_inkling2_rows").bytes else &.{};
 pub const inkling2_dspark: []const u8 = if (available) &Blob("fatbin_inkling2_dspark").bytes else &.{};
 pub const inkling2_vision: []const u8 = if (available) &Blob("fatbin_inkling2_vision").bytes else &.{};
 pub const glm_quant: []const u8 = if (available) &Blob("fatbin_glm_quant").bytes else &.{};
diff --git a/zig/src/families/inkling2/ops.zig b/zig/src/families/inkling2/ops.zig
index e5c3f2b..efbd84c 100644
--- a/zig/src/families/inkling2/ops.zig
+++ b/zig/src/families/inkling2/ops.zig
@@ -60,6 +60,8 @@ pub const GateUpArgs = extern struct {
 
 pub const Kernels = struct {
     mod: cuda.Module,
+    rows_mod: cuda.Module,
+    rowdot_tiles: cuda.Function,
     embed: cuda.Function,
     mix: cuda.Function,
     mix_rows: cuda.Function,
@@ -78,8 +80,12 @@ pub const Kernels = struct {
         if (!cuda.kernels.available) return error.BuiltWithoutKernels;
         var mod = try cuda.Module.load(d, cuda.kernels.inkling2_ops);
         errdefer mod.unload();
+        var rows_mod = try cuda.Module.load(d, cuda.kernels.inkling2_rows);
+        errdefer rows_mod.unload();
         return .{
             .mod = mod,
+            .rows_mod = rows_mod,
+            .rowdot_tiles = try rows_mod.function("tf_ink2_rowdot_tiles"),
             .embed = try mod.function("tf_ink2_embed"),
             .mix = try mod.function("tf_ink2_mix"),
             .mix_rows = try mod.function("tf_ink2_mix_rows"),
@@ -97,6 +103,7 @@ pub const Kernels = struct {
     }
 
     pub fn unload(k: *Kernels) void {
+        k.rows_mod.unload();
         k.mod.unload();
         k.* = undefined;
     }
@@ -131,6 +138,10 @@ pub fn mix(k: *const Kernels, s: cuda.Stream, m: MixArgs) !void {
 pub fn rowdot(k: *const Kernels, s: cuda.Stream, x: u64, w: u64, out: u64, rows: usize, j: usize, c: usize, out_bf16: bool, sigmoid: bool) !void {
     var a: cuda.Args = .{};
     for ([_]u64{ x, w, out }) |v| a.add(v);
+    if (rows >= 32 and !out_bf16 and c % 128 == 0) { // prompt rows: 32 x 16 tiles, the same sums in the same order
+        for ([_]i32{ int(rows), int(j), int(c), @intFromBool(sigmoid) }) |v| a.add(v);
+        return go(k.rowdot_tiles, s, .{ .x = @intCast((rows + 31) / 32), .y = @intCast((j + 15) / 16) }, 256, &a);
+    }
     for ([_]i32{ int(j), int(c), @intFromBool(out_bf16), @intFromBool(sigmoid) }) |v| a.add(v);
     try go(k.rowdot, s, .{ .x = @intCast(rows), .y = @intCast((j + 7) / 8) }, 256, &a);
 }
