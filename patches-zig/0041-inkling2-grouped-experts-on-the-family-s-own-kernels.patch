+//! Inkling 2's routed experts: main's grouping and combine, the family's grouped projections and softcapped SwiGLU.
 const std = @import("std");
 const cuda = @import("cuda");
 const ops = @import("ops.zig");
@@ -8,26 +8,97 @@ const ex = cuda.exl3_experts;
 /// The two SwiGLU softcaps (config.json mlp_gate_softcap, mlp_up_softcap).
