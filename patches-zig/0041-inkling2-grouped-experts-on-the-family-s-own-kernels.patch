     for ([_]usize{ rows, slots, l.experts, rows }) |v| a.add(i32d(v));
-    try cuda.launch.launch(e.group, .{ .grid = .{ .x = 1 }, .block = .{ .x = 1024 }, .shared = @intCast(rows * slots * 4) }, s, &a);
+    const shared: u32 = @intCast(rows * slots * 4);
+    try cuda.launch.launch(e.main.group, .{ .grid = .{ .x = 1 }, .block = .{ .x = 1024 }, .shared = shared }, s, &a);
+
+    const listed = rows >= listed_from;
+    const wide = rows >= wide_from;
+    const per: usize = if (wide) 32 else 16;
+    const at = itemsAt(l, sc);
+    if (listed) {
+        var it: cuda.Args = .{};
+        for ([_]u64{ sc.count, sc.members, at + 256, at }) |v| it.add(v);
+        for ([_]usize{ rows, per }) |v| it.add(i32d(v));
+        try cuda.launch.launch(e.items, .{ .grid = .{ .x = 1 }, .block = .{ .x = 1024 } }, s, &it);
+    }
+    const items: u64 = if (listed) at + 256 else 0;
+    const count: u64 = if (listed) at else sc.count;
+    const gy: u32 = @intCast(if (listed) (p + per - 1) / per + maxu else maxu);
