+// FP8 global caches (TF_INKLING2_KV=fp8): e4m3 [slot][kv_head][128] a stream, an fp32 scale (amax / 448) a slot+head.
 
-using ink2::Seg;
+// Two e4m3 codes (the low bytes of v) as an exact bf16x2 pair: exponent rebiased by one bf16x2 multiply by 2^120.
+__device__ __forceinline__ uint32_t e4m3x2(uint32_t v) {
+    const uint32_t t = ((v & 0x7Fu) << 4) | ((v & 0x80u) << 8) | ((v & 0x7F00u) << 12) | ((v & 0x8000u) << 16);
+    uint32_t r;
+    asm("fma.rn.bf16x2 %0, %1, %2, %3;\n" : "=r"(r) : "r"(t), "r"(0x7B807B80u), "r"(0x80008000u));
+    return r;
+}
+
+// Four codes times the row's scale, rounded once to bf16 (fp32 products).
+__device__ __forceinline__ uint2 deq4(uint32_t w, float s) {
+    uint2 o;
+    const uint32_t a = e4m3x2(w), b = e4m3x2(w >> 16);
+    const float a1 = __uint_as_float(a & 0xFFFF0000u) * s, a0 = __uint_as_float(a << 16) * s;
+    const float b1 = __uint_as_float(b & 0xFFFF0000u) * s, b0 = __uint_as_float(b << 16) * s;
+    asm("cvt.rn.bf16x2.f32 %0, %1, %2;\n" : "=r"(o.x) : "f"(a1), "f"(a0));
+    asm("cvt.rn.bf16x2.f32 %0, %1, %2;\n" : "=r"(o.y) : "f"(b1), "f"(b0));
+    return o;
+}
+
+// A 64-key fp8 tile in registers, 128 threads x 4 pieces of 16 codes (key e >> 3, columns (e & 7) * 16).
+struct Raw8 {
+    uint4 b[4];
+    float s[4];
+};
+
+// Keys kt..kt+63 of key head kvh of an fp8 cache (a stream's bytes at `off`) into registers; zero outside k_lo..k_hi.
+__device__ __forceinline__ void fetch8(Raw8& r, const uint8_t* __restrict__ c, const float* __restrict__ sc,
+                                       long long off, int kv_heads, int ring, int kvh, int kt, int k_lo, int k_hi) {
+    for (int i = 0; i < 4; ++i) {
+        const int e = threadIdx.x + 128 * i, kp = kt + (e >> 3);
+        r.b[i] = make_uint4(0, 0, 0, 0);
+        r.s[i] = 0.0f;
+        if (kp >= k_lo && kp <= k_hi) {
+            const size_t row = static_cast<size_t>(kp % ring) * kv_heads + kvh;
+            r.b[i] = *reinterpret_cast<const uint4*>(c + off + row * kDim + (e & 7) * 16);
+            r.s[i] = sc[off / kDim + row];
+        }
+    }
+}
+
+// The fetched tile as bf16 rows [64][kPad] in shared memory (zeros stay zeros: masked p = 0 never meets garbage).
+__device__ __forceinline__ void store8(const Raw8& r, uint16_t* dst) {
+    for (int i = 0; i < 4; ++i) {
+        const int e = threadIdx.x + 128 * i;
+        uint4* d = reinterpret_cast<uint4*>(dst + (e >> 3) * kPad + (e & 7) * 16);
+        const uint2 a = deq4(r.b[i].x, r.s[i]), b = deq4(r.b[i].y, r.s[i]);
+        const uint2 c = deq4(r.b[i].z, r.s[i]), e2 = deq4(r.b[i].w, r.s[i]);
+        d[0] = make_uint4(a.x, a.y, b.x, b.y);
+        d[1] = make_uint4(c.x, c.y, e2.x, e2.y);
+    }
+}
+
+// One tensor's (K or V) 64-key fp8 tile to bf16 shared rows, for blocks of 128 threads: the one dequantise path.
+__device__ __forceinline__ void tile8(const uint8_t* __restrict__ c, const float* __restrict__ sc, long long off,
+                                      int kv_heads, int ring, int kvh, int kt, int k_lo, int k_hi, uint16_t* dst) {
+    Raw8 r;
+    fetch8(r, c, sc, off, kv_heads, ring, kvh, kt, k_lo, k_hi);
+    store8(r, dst);
+}
+
+// One token-head row (4 values a lane) to e4m3 at `dst` with its scale (lane 0); a zero row stores zeros.
+__device__ __forceinline__ void put8(const float* x, uint8_t* dst, float* scale, int lane) {
+    float amax = fmaxf(fmaxf(fabsf(x[0]), fabsf(x[1])), fmaxf(fabsf(x[2]), fabsf(x[3])));
+    for (int o = 16; o > 0; o >>= 1) amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, o));
+    const float inv = amax > 0.0f ? __fdiv_rn(448.0f, amax) : 0.0f;
+    uint32_t w = 0;
+    for (int i = 0; i < 4; ++i)
+        w |= static_cast<uint32_t>(__nv_cvt_float_to_fp8(__fmul_rn(x[i], inv), __NV_SATFINITE, __NV_E4M3)) << (8 * i);
+    *reinterpret_cast<uint32_t*>(dst + lane * 4) = w;
+    if (lane == 0) *scale = amax > 0.0f ? __fdiv_rn(amax, 448.0f) : 0.0f;
+}
 
