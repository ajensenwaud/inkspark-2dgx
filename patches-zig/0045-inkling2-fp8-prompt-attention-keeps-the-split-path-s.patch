-    for (int st = 0; st < kStages - 1; ++st) {
-        if (st < n_tiles) loadTile(smem + st * kStage, smem + st * kStage + kTile, kc, vc, head_base, ring,
+    const uint16_t* k16 = static_cast<const uint16_t*>(kc);
+    const uint16_t* v16 = static_cast<const uint16_t*>(vc);
+    const uint8_t* k8 = static_cast<const uint8_t*>(kc);
+    const uint8_t* v8 = static_cast<const uint8_t*>(vc);
+    uint8_t* raw = reinterpret_cast<uint8_t*>(smem + 2 * kStage);  // KV8: two raw stages after the two bf16 tiles
+    float cur[4], nxt[4];  // KV8: scales of the next tile to convert, and of the one after
+    if (KV8) {
+        issue8(raw, cur, k8, v8, ksc, vsc, s.off, kv_heads, ring, kvh, b_lo, b_lo, k_hi);
+        if (n_tiles > 1)
+            issue8(raw + kRaw, nxt, k8, v8, ksc, vsc, s.off, kv_heads, ring, kvh, b_lo + kKeys, b_lo, k_hi);
+        else asm volatile("cp.async.commit_group;\n" ::);
+        asm volatile("cp.async.wait_group 1;\n" ::);
+        convert8(raw, cur, smem);
+        for (int i = 0; i < 4; ++i) cur[i] = nxt[i];
+    }
+    for (int st = 0; !KV8 && st < kStages - 1; ++st) {
