+// Four codes times the row's scale, rounded once to bf16: tile8's values for every finite code (exact f16 unpack).
+__device__ __forceinline__ uint2 deq4(uint32_t w, float s) {
+    uint32_t p, q;
+    asm("cvt.rn.f16x2.e4m3x2 %0, %1;\n" : "=r"(p) : "h"(static_cast<unsigned short>(w & 0xFFFFu)));
+    asm("cvt.rn.f16x2.e4m3x2 %0, %1;\n" : "=r"(q) : "h"(static_cast<unsigned short>(w >> 16)));
+    const float a0 = h2f(p) * s, a1 = h2f(p >> 16) * s, b0 = h2f(q) * s, b1 = h2f(q >> 16) * s;
+    uint2 o;
+    asm("cvt.rn.bf16x2.f32 %0, %1, %2;\n" : "=r"(o.x) : "f"(a1), "f"(a0));
+    asm("cvt.rn.bf16x2.f32 %0, %1, %2;\n" : "=r"(o.y) : "f"(b1), "f"(b0));
+    return o;
+}
+
+// fp8 caches: a stage's raw bytes, K then V, 512 pieces of 16 codes each (piece e: key e >> 3, codes (e & 7) * 16).
+constexpr int kRaw = 2 * kKeys * kDim;
+
+// Keys kt..kt+63 of fp8 caches into raw stage `raw` (async, each thread its own 4 pieces), their scales into sc.
+__device__ __forceinline__ void issue8(uint8_t* raw, float* sc, const uint8_t* __restrict__ kc,
+                                       const uint8_t* __restrict__ vc, const float* __restrict__ ksc,
+                                       const float* __restrict__ vsc, long long off, int kv_heads, int ring,
+                                       int kvh, int kt, int k_lo, int k_hi) {
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        const int e = threadIdx.x + kThreads * (i & 1), kp = kt + (e >> 3);
+        const bool in = kp >= k_lo && kp <= k_hi;
+        const size_t row = in ? static_cast<size_t>(kp % ring) * kv_heads + kvh : 0;
+        const uint8_t* src = (i < 2 ? kc : vc) + off + (in ? row * kDim + (e & 7) * 16 : 0);
+        const uint32_t d = static_cast<uint32_t>(__cvta_generic_to_shared(raw + (i >> 1) * kKeys * kDim + e * 16));
+        asm volatile("cp.async.cg.shared.global [%0], [%1], 16, %2;\n" ::"r"(d), "l"(src), "r"(in ? 16 : 0));
+        sc[i] = in ? (i < 2 ? ksc : vsc)[off / kDim + row] : 0.0f;
+    }
+    asm volatile("cp.async.commit_group;\n" ::);
+}
+
+// This thread's pieces of raw stage `raw` as bf16 into the swizzled K/V tiles at `ks` (tile8's values, bit for bit).
+__device__ __forceinline__ void convert8(const uint8_t* raw, const float* sc, uint16_t* ks) {
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        const int e = threadIdx.x + kThreads * (i & 1), key = e >> 3;
+        const uint4 w = *reinterpret_cast<const uint4*>(raw + (i >> 1) * kKeys * kDim + e * 16);
+        const uint2 a = deq4(w.x, sc[i]), b = deq4(w.y, sc[i]), c = deq4(w.z, sc[i]), d = deq4(w.w, sc[i]);
+        uint16_t* t = ks + (i >> 1) * kTile;
+        *reinterpret_cast<uint4*>(t + piece(key, 2 * (e & 7))) = make_uint4(a.x, a.y, b.x, b.y);
+        *reinterpret_cast<uint4*>(t + piece(key, 2 * (e & 7) + 1)) = make_uint4(c.x, c.y, d.x, d.y);
+    }
+}
