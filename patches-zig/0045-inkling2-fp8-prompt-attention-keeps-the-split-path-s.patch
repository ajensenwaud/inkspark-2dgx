+// A block's prompt pairs (tile of kPairs pairs, key head, chunk); KV8: raw fp8 in two stages, two bf16 tiles.
+template <bool KV8>
+__device__ __forceinline__ void promptTile(const uint16_t* __restrict__ q, const void* __restrict__ kc,
